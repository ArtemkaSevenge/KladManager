function KladManager.CopyTable(source)
    local result = {}
    for key, value in pairs(source) do
        if type(value) == "table" then
            result[key] = KladManager.CopyTable(value)
        else
            result[key] = value
        end
    end
    return result
end

function KladManager.Clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

function KladManager.IsChoice(value, choices)
    for _, choice in ipairs(choices) do
        if value == choice then
            return true
        end
    end
    return false
end

function KladManager.NormalizeSettings()
    local settings = KladManager.Settings
    settings.ui.scale = KladManager.IsChoice(settings.ui.scale, {"small","medium","large"})
        and settings.ui.scale or "medium"
    settings.ui.opacity = KladManager.Clamp(tonumber(settings.ui.opacity) or 0.96, 0.65, 1.0)
    settings.ui.font_path = tostring(settings.ui.font_path or ""):gsub("[\r\n]", "")
    settings.binds.menu_key = KladManager.Clamp(math.floor(tonumber(settings.binds.menu_key) or 75), 1, 255)
    settings.binds.minimap_key = KladManager.Clamp(math.floor(tonumber(settings.binds.minimap_key) or 77), 1, 255)
    settings.binds.menu_mode = KladManager.IsChoice(settings.binds.menu_mode, {"hold","toggle"})
        and settings.binds.menu_mode or "toggle"
    settings.binds.minimap_mode = KladManager.IsChoice(settings.binds.minimap_mode, {"hold","toggle"})
        and settings.binds.minimap_mode or "toggle"
    settings.notifications.mode = KladManager.IsChoice(
        settings.notifications.mode,
        {"chat","custom","both"}
    ) and settings.notifications.mode or "both"
    settings.notifications.position = KladManager.IsChoice(
        settings.notifications.position,
        {"top_left","top_center","top_right","bottom_left","bottom_center","bottom_right"}
    ) and settings.notifications.position or "top_right"
    settings.notifications.seen_server = tostring(
        settings.notifications.seen_server or ""
    ):sub(1, 12000)
    settings.map.months = KladManager.Clamp(math.floor(tonumber(settings.map.months) or 3), 1, 24)
    settings.map.zone_count = KladManager.Clamp(math.floor(tonumber(settings.map.zone_count) or 8), 1, 64)
    settings.map.intersection_count = KladManager.Clamp(
        math.floor(tonumber(settings.map.intersection_count) or 2),
        2,
        16
    )
    settings.map.minimap_size = KladManager.Clamp(math.floor(tonumber(settings.map.minimap_size) or 280), 180, 520)
    settings.map.minimap_position = KladManager.IsChoice(
        settings.map.minimap_position,
        {"top_left","top_right","bottom_left","bottom_right","custom"}
    ) and settings.map.minimap_position or "top_right"
    settings.map.minimap_zoom = KladManager.Clamp(tonumber(settings.map.minimap_zoom) or 1.0, 0.5, 4.0)
    settings.map.minimap_opacity = KladManager.Clamp(
        tonumber(settings.map.minimap_opacity) or 0.9,
        0.25,
        1.0
    )
    settings.map.map_center_x = KladManager.Clamp(
        tonumber(settings.map.map_center_x) or 0.5,
        0.0,
        1.0
    )
    settings.map.map_center_y = KladManager.Clamp(
        tonumber(settings.map.map_center_y) or 0.5,
        0.0,
        1.0
    )
    settings.map.marker_color_r = KladManager.Clamp(tonumber(settings.map.marker_color_r) or 1.0, 0.0, 1.0)
    settings.map.marker_color_g = KladManager.Clamp(tonumber(settings.map.marker_color_g) or 0.42, 0.0, 1.0)
    settings.map.marker_color_b = KladManager.Clamp(tonumber(settings.map.marker_color_b) or 0.08, 0.0, 1.0)
    settings.map.line_width = KladManager.Clamp(tonumber(settings.map.line_width) or 2.0, 1.0, 6.0)
    settings.prices.mode = KladManager.IsChoice(settings.prices.mode, {"moment","current"})
        and settings.prices.mode or "moment"
    settings.logs.source = KladManager.IsChoice(settings.logs.source, {"treasure","chest"})
        and settings.logs.source or "treasure"
    settings.logs.selected_day = tostring(settings.logs.selected_day or "")
    settings.statistics.period = KladManager.IsChoice(
        tostring(settings.statistics.period),
        {"1","7","30","all"}
    ) and tostring(settings.statistics.period) or "7"
    settings.network.api_url = tostring(settings.network.api_url or ""):gsub("%s+$", ""):gsub("/+$", "")
    if settings.network.api_url ~= "" and not KM_IS_HTTPS(settings.network.api_url) then
        settings.network.api_url = ""
    end
    KladManager.ApiBaseUrl = settings.network.api_url
end

function KladManager.ParseSetting(raw, sample)
    if type(sample) == "boolean" then
        return raw == "true" or raw == "1"
    elseif type(sample) == "number" then
        return tonumber(raw) or sample
    end
    return tostring(raw)
end

function KladManager.LoadSettings()
    KladManager.Settings = KladManager.CopyTable(KladManager.SettingsDefaults)
    local payload = KM_READ(KladManager.SettingsPath)
    if payload then
        local section = nil
        for line in payload:gmatch("[^\r\n]+") do
            local name = line:match("^%[([%w_]+)%]$")
            if name and KladManager.Settings[name] then
                section = name
            else
                local key, value = line:match("^([%w_]+)=(.*)$")
                if section and key and KladManager.Settings[section][key] ~= nil then
                    local sample = KladManager.SettingsDefaults[section][key]
                    KladManager.Settings[section][key] = KladManager.ParseSetting(value, sample)
                end
            end
        end
    end
    KladManager.NormalizeSettings()
end

function KladManager.SaveSettings()
    local sections = {}
    for section in pairs(KladManager.Settings) do
        sections[#sections + 1] = section
    end
    table.sort(sections)
    local lines = {}
    for _, section in ipairs(sections) do
        lines[#lines + 1] = "[" .. section .. "]"
        local keys = {}
        for key in pairs(KladManager.Settings[section]) do
            keys[#keys + 1] = key
        end
        table.sort(keys)
        for _, key in ipairs(keys) do
            local value = KladManager.Settings[section][key]
            lines[#lines + 1] = key .. "=" .. tostring(value)
        end
        lines[#lines + 1] = ""
    end
    local ok = KM_WRITE(KladManager.SettingsPath, table.concat(lines, "\r\n"))
    if not ok then
        KladManager.Diagnostics.last_error = "Не удалось сохранить настройки"
    end
    KladManager.SettingsDirtyAt = nil
    return ok
end

function KladManager.MarkSettingsDirty()
    KladManager.SettingsDirtyAt = getGameTimer() + 250
end

function KladManager.TickSettings()
    if KladManager.SettingsDirtyAt and getGameTimer() >= KladManager.SettingsDirtyAt then
        KladManager.SaveSettings()
    end
end

function KladManager.BufferSet(buffer, capacity, value)
    local text = tostring(value or "")
    local length = math.min(#text, capacity - 1)
    KladManager.ffi.fill(buffer, capacity, 0)
    if length > 0 then
        KladManager.ffi.copy(buffer, text, length)
    end
end

function KladManager.BufferGet(buffer)
    return KladManager.ffi.string(buffer)
end

function KladManager.CreateBuffers()
    local imgui = KladManager.ImGui
    KladManager.Buffers.username = imgui.new.char[64]()
    KladManager.Buffers.password = imgui.new.char[128]()
    KladManager.Buffers.two_factor = imgui.new.char[7]()
    KladManager.Buffers.date_day = imgui.new.int(os.date("*t").day)
    KladManager.Buffers.date_month = imgui.new.int(os.date("*t").month)
    KladManager.Buffers.date_year = imgui.new.int(os.date("*t").year)
    KladManager.Buffers.marker_color = imgui.new.float[4](
        KladManager.Settings.map.marker_color_r,
        KladManager.Settings.map.marker_color_g,
        KladManager.Settings.map.marker_color_b,
        1.0
    )
    KladManager.Buffers.ui_opacity = imgui.new.float(KladManager.Settings.ui.opacity)
    KladManager.Buffers.map_months = imgui.new.int(KladManager.Settings.map.months)
    KladManager.Buffers.zone_count = imgui.new.int(KladManager.Settings.map.zone_count)
    KladManager.Buffers.intersection_count =
        imgui.new.int(KladManager.Settings.map.intersection_count)
    KladManager.Buffers.minimap_size = imgui.new.int(KladManager.Settings.map.minimap_size)
    KladManager.Buffers.minimap_zoom = imgui.new.float(KladManager.Settings.map.minimap_zoom)
    KladManager.Buffers.minimap_opacity =
        imgui.new.float(KladManager.Settings.map.minimap_opacity)
    KladManager.Buffers.line_width = imgui.new.float(KladManager.Settings.map.line_width)
    KladManager.Buffers.loot_search = imgui.new.char[160]()
end

function KladManager.RandomToken()
    if KladManager.Bcrypt then
        local bytes = KladManager.ffi.new("unsigned char[32]")
        local status = KladManager.Bcrypt.BCryptGenRandom(nil, bytes, 32, 0x00000002)
        if tonumber(status) == 0 then
            local parts = {}
            for index = 0, 31 do
                parts[#parts + 1] = string.format("%02x", tonumber(bytes[index]))
            end
            return table.concat(parts)
        end
    end
    local entropy = table.concat({
        tostring(os.time()),
        tostring(getGameTimer()),
        tostring(math.random()),
        tostring({})
    }, "|")
    return KM_SHA256(entropy)
end

function KladManager.LoadInstallId()
    local payload = KM_READ(KladManager.DevicePath)
    if payload then
        local ok, data = pcall(KladManager.Json.decode, payload)
        if ok and type(data) == "table" and type(data.install_id) == "string"
            and #data.install_id >= 32 and #data.install_id <= 128 then
            return data.install_id
        end
        KladManager.Diagnostics.last_error = "Файл устройства повреждён"
    end
    local install_id = KladManager.RandomToken()
    local encoded = KladManager.Json.encode({version=1,install_id=install_id})
    if not KM_WRITE(KladManager.DevicePath, encoded) then
        KladManager.Diagnostics.last_error = "Не удалось сохранить идентификатор установки"
    end
    return install_id
end

function KladManager.InitWindowsSignals()
    KladManager.ffi.cdef[[
        long __stdcall RegGetValueA(void* hkey, const char* subKey, const char* value, unsigned long flags, unsigned long* type, void* data, unsigned long* dataSize);
        int __stdcall GetVolumeInformationA(const char* root, char* volumeName, unsigned long volumeNameSize, unsigned long* serial, unsigned long* maximumComponentLength, unsigned long* fileSystemFlags, char* fileSystemName, unsigned long fileSystemNameSize);
        long __stdcall BCryptGenRandom(void* algorithm, unsigned char* buffer, unsigned long size, unsigned long flags);
    ]]
    local advapi_ok, advapi = pcall(KladManager.ffi.load, "advapi32")
    if advapi_ok then
        KladManager.Advapi = advapi
    else
        KladManager.Diagnostics.last_error = "Недоступен системный идентификатор"
    end
    local bcrypt_ok, bcrypt = pcall(KladManager.ffi.load, "bcrypt")
    if bcrypt_ok then
        KladManager.Bcrypt = bcrypt
    end
end

function KladManager.MachineGuid()
    if not KladManager.Advapi then
        return nil
    end
    local buffer = KladManager.ffi.new("unsigned char[256]")
    local size = KladManager.ffi.new("unsigned long[1]", 256)
    local value_type = KladManager.ffi.new("unsigned long[1]")
    local hkey = KladManager.ffi.cast("void*", 0x80000002)
    local status = KladManager.Advapi.RegGetValueA(
        hkey,
        "SOFTWARE\\Microsoft\\Cryptography",
        "MachineGuid",
        0x00000002 + 0x00010000,
        value_type,
        buffer,
        size
    )
    if tonumber(status) ~= 0 then
        return nil
    end
    local value = KladManager.ffi.string(buffer):lower():gsub("[^0-9a-f%-]", "")
    return #value >= 32 and value or nil
end

function KladManager.VolumeSerial()
    local serial = KladManager.ffi.new("unsigned long[1]", 0)
    local ok = KladManager.ffi.C.GetVolumeInformationA(
        "C:\\",
        nil,
        0,
        serial,
        nil,
        nil,
        nil,
        0
    )
    return ok ~= 0 and tostring(tonumber(serial[0])) or nil
end

function KladManager.DeviceSignals()
    local machine = KladManager.MachineGuid()
    local volume = KladManager.VolumeSerial()
    local processor = tostring(os.getenv("PROCESSOR_IDENTIFIER") or "unknown"):lower():gsub("%s+", " ")
    local primary = machine or ("fallback|" .. tostring(volume or "none") .. "|" .. processor)
    return {
        version=2,
        primary_machine=primary,
        system_volume=volume,
        cpu_system=processor,
        install_id=KladManager.InstallId
    }
end

function KladManager.LoadSession()
    local payload = KM_READ(KladManager.SessionPath)
    if not payload then
        return nil
    end
    local ok, data = pcall(KladManager.Json.decode, payload)
    if not ok or type(data) ~= "table" or type(data.refresh_token) ~= "string"
        or type(data.session_id) ~= "string" then
        KM_SAFE_REMOVE(KladManager.SessionPath)
        KladManager.Diagnostics.last_error = "Локальная сессия повреждена"
        return nil
    end
    return {
        refresh_token=data.refresh_token,
        session_id=data.session_id,
        refresh_expires_at=data.refresh_expires_at
    }
end

function KladManager.SaveSession(session)
    local payload = KladManager.Json.encode({
        session_id=session.session_id,
        refresh_token=session.refresh_token,
        refresh_expires_at=session.refresh_expires_at
    })
    if not KM_WRITE(KladManager.SessionPath, payload) then
        KladManager.Diagnostics.last_error = "Не удалось сохранить сессию"
        return false
    end
    return true
end

function KladManager.ClearSession()
    KM_SAFE_REMOVE(KladManager.SessionPath)
    KladManager.Auth.session = nil
    KladManager.Auth.profile = nil
    KladManager.Auth.access_deadline = 0
end

KladManager.WinHttpWorkerSource = [=[
return function(method, url, header_text, body, timeout_ms)
    local ffi = require("ffi")
    ffi.cdef[[
        void* __stdcall WinHttpOpen(const wchar_t* userAgent, unsigned long accessType, const wchar_t* proxyName, const wchar_t* proxyBypass, unsigned long flags);
        void* __stdcall WinHttpConnect(void* session, const wchar_t* serverName, unsigned short serverPort, unsigned long reserved);
        void* __stdcall WinHttpOpenRequest(void* connect, const wchar_t* verb, const wchar_t* objectName, const wchar_t* version, const wchar_t* referrer, const wchar_t** acceptTypes, unsigned long flags);
        int __stdcall WinHttpSetTimeouts(void* handle, int resolveTimeout, int connectTimeout, int sendTimeout, int receiveTimeout);
        int __stdcall WinHttpSendRequest(void* request, const wchar_t* headers, unsigned long headersLength, const void* optional, unsigned long optionalLength, unsigned long totalLength, unsigned long context);
        int __stdcall WinHttpReceiveResponse(void* request, void* reserved);
        int __stdcall WinHttpQueryHeaders(void* request, unsigned long infoLevel, const wchar_t* name, void* buffer, unsigned long* bufferLength, unsigned long* index);
        int __stdcall WinHttpQueryDataAvailable(void* request, unsigned long* available);
        int __stdcall WinHttpReadData(void* request, void* buffer, unsigned long bytesToRead, unsigned long* bytesRead);
        int __stdcall WinHttpCloseHandle(void* handle);
        unsigned long __stdcall GetLastError(void);
        unsigned long __stdcall GetTickCount(void);
    ]]
    local winhttp = ffi.load("winhttp")
    local function wide(value)
        local text = tostring(value or "")
        local buffer = ffi.new("wchar_t[?]", #text + 1)
        for index = 1, #text do
            buffer[index - 1] = text:byte(index)
        end
        buffer[#text] = 0
        return buffer
    end
    local function failure(stage)
        return false, {code="HTTP_NETWORK",message=stage .. ":" .. tostring(ffi.C.GetLastError())}
    end
    local host, port_text, path = tostring(url):match("^https://([^/:]+):?(%d*)(/.*)$")
    if not host then
        return false, {code="HTTP_URL",message="HTTPS URL required"}
    end
    local port = tonumber(port_text) or 443
    local started = tonumber(ffi.C.GetTickCount())
    local session = winhttp.WinHttpOpen(wide("KladManager/" .. tostring(method)), 1, nil, nil, 0)
    if session == nil then
        return failure("open")
    end
    winhttp.WinHttpSetTimeouts(session, timeout_ms, timeout_ms, timeout_ms, timeout_ms)
    local connection = winhttp.WinHttpConnect(session, wide(host), port, 0)
    if connection == nil then
        winhttp.WinHttpCloseHandle(session)
        return failure("connect")
    end
    local request = winhttp.WinHttpOpenRequest(
        connection,
        wide(method),
        wide(path),
        nil,
        nil,
        nil,
        0x00800000
    )
    if request == nil then
        winhttp.WinHttpCloseHandle(connection)
        winhttp.WinHttpCloseHandle(session)
        return failure("request")
    end
    local payload = tostring(body or "")
    local payload_pointer = #payload > 0 and payload or nil
    local headers = wide(header_text)
    local sent = winhttp.WinHttpSendRequest(
        request,
        headers,
        0xffffffff,
        payload_pointer,
        #payload,
        #payload,
        0
    )
    if sent == 0 then
        winhttp.WinHttpCloseHandle(request)
        winhttp.WinHttpCloseHandle(connection)
        winhttp.WinHttpCloseHandle(session)
        return failure("send")
    end
    if winhttp.WinHttpReceiveResponse(request, nil) == 0 then
        winhttp.WinHttpCloseHandle(request)
        winhttp.WinHttpCloseHandle(connection)
        winhttp.WinHttpCloseHandle(session)
        return failure("receive")
    end
    local status = ffi.new("unsigned long[1]", 0)
    local status_size = ffi.new("unsigned long[1]", 4)
    if winhttp.WinHttpQueryHeaders(request, 0x20000013, nil, status, status_size, nil) == 0 then
        winhttp.WinHttpCloseHandle(request)
        winhttp.WinHttpCloseHandle(connection)
        winhttp.WinHttpCloseHandle(session)
        return failure("status")
    end
    local chunks = {}
    local total = 0
    while true do
        local available = ffi.new("unsigned long[1]", 0)
        if winhttp.WinHttpQueryDataAvailable(request, available) == 0 then
            winhttp.WinHttpCloseHandle(request)
            winhttp.WinHttpCloseHandle(connection)
            winhttp.WinHttpCloseHandle(session)
            return failure("available")
        end
        local count = tonumber(available[0])
        if count == 0 then
            break
        end
        total = total + count
        if total > 1048576 then
            winhttp.WinHttpCloseHandle(request)
            winhttp.WinHttpCloseHandle(connection)
            winhttp.WinHttpCloseHandle(session)
            return false, {code="HTTP_RESPONSE_TOO_LARGE",message="response limit"}
        end
        local buffer = ffi.new("unsigned char[?]", count)
        local read = ffi.new("unsigned long[1]", 0)
        if winhttp.WinHttpReadData(request, buffer, count, read) == 0 then
            winhttp.WinHttpCloseHandle(request)
            winhttp.WinHttpCloseHandle(connection)
            winhttp.WinHttpCloseHandle(session)
            return failure("read")
        end
        chunks[#chunks + 1] = ffi.string(buffer, tonumber(read[0]))
    end
    winhttp.WinHttpCloseHandle(request)
    winhttp.WinHttpCloseHandle(connection)
    winhttp.WinHttpCloseHandle(session)
    return true, {
        status=tonumber(status[0]),
        body=table.concat(chunks),
        latency_ms=tonumber(ffi.C.GetTickCount()) - started
    }
end
]=]
KladManager.Network = {
    queue={},
    active={},
    results={},
    next_id=0,
    max_queue=32,
    max_concurrent=2,
    timeout_ms=15000,
    max_retries=2,
    worker_factory=nil,
    worker_error=nil,
    shutting_down=false
}

function KladManager.NowMs()
    return getGameTimer()
end

function KladManager.UtcNow()
    return os.date("!%Y-%m-%dT%H:%M:%SZ")
end

function KladManager.NewRequestId(prefix)
    return tostring(prefix or "lua") .. "-" .. KladManager.RandomToken():sub(1, 24)
end

function KladManager.InitNetwork()
    local chunk, compile_error = loadstring(
        KladManager.WinHttpWorkerSource,
        "@kladmanager_winhttp_worker"
    )
    if not chunk then
        KladManager.Network.worker_error = tostring(compile_error)
        return false
    end
    local ok_worker, worker = pcall(chunk)
    if not ok_worker or type(worker) ~= "function" then
        KladManager.Network.worker_error = tostring(worker)
        return false
    end
    local ok_factory, factory = pcall(KladManager.Effil.thread, worker)
    if not ok_factory then
        KladManager.Network.worker_error = tostring(factory)
        return false
    end
    KladManager.Network.worker_factory = factory
    return true
end

function KladManager.NetworkCanRetry(task, status, error)
    if task.cancelled or task.attempt >= KladManager.Network.max_retries then
        return false
    end
    local safe = task.method == "GET" or task.idempotency_key ~= nil
    if not safe then
        return false
    end
    if error then
        return error.code == "HTTP_NETWORK" or error.code == "HTTP_TIMEOUT"
    end
    return status == 408 or status == 429 or status >= 500
end

function KladManager.NetworkHeaders(task)
    local headers = {
        "Accept: application/json",
        "Content-Type: application/json; charset=utf-8",
        "X-Request-ID: " .. task.request_id,
        "X-Client-Time: " .. task.client_time,
        "X-Client-Nonce: " .. task.nonce
    }
    if task.authorization then
        headers[#headers + 1] = "Authorization: Bearer " .. task.authorization
    end
    if task.idempotency_key then
        headers[#headers + 1] = "Idempotency-Key: " .. task.idempotency_key
    end
    return table.concat(headers, "\r\n") .. "\r\n"
end

function KladManager.QueueResult(task, request_ok, response, error)
    KladManager.Network.results[#KladManager.Network.results + 1] = {
        task=task,
        request_ok=request_ok,
        response=response,
        error=error
    }
end

function KladManager.QueueRequest(method, path, payload, options, callback)
    local network = KladManager.Network
    options = options or {}
    if network.shutting_down then
        return nil, "HTTP_CANCELLED"
    end
    if #network.queue >= network.max_queue then
        return nil, "HTTP_QUEUE_FULL"
    end
    if KladManager.ApiBaseUrl == "" then
        return nil, "API_NOT_CONFIGURED"
    end
    if not KM_IS_HTTPS(KladManager.ApiBaseUrl) then
        return nil, "API_URL_INVALID"
    end
    network.next_id = network.next_id + 1
    local request_id = KladManager.NewRequestId("req")
    local task = {
        id=network.next_id,
        request_id=request_id,
        method=tostring(method or "GET"):upper(),
        url=KladManager.ApiBaseUrl .. tostring(path),
        body=payload and KladManager.Json.encode(KladManager.ToUtf8Data(payload)) or "",
        callback=callback,
        attempt=0,
        ready_at=KladManager.NowMs(),
        started_at=nil,
        runner=nil,
        cancelled=false,
        authorization=options.authorization,
        idempotency_key=options.idempotency_key,
        nonce=KladManager.NewRequestId("nonce"),
        client_time=KladManager.UtcNow(),
        timeout_ms=tonumber(options.timeout_ms) or network.timeout_ms
    }
    network.queue[#network.queue + 1] = task
    KladManager.Diagnostics.last_request_id = request_id
    KladManager.Diagnostics.requests_total = KladManager.Diagnostics.requests_total + 1
    return task.id, nil
end

function KladManager.CancelRequest(request_id)
    for index = #KladManager.Network.queue, 1, -1 do
        local task = KladManager.Network.queue[index]
        if task.id == request_id then
            task.cancelled = true
            table.remove(KladManager.Network.queue, index)
            KladManager.QueueResult(task, false, nil, {
                code="HTTP_CANCELLED",
                message="Запрос отменён"
            })
            return true
        end
    end
    for _, task in ipairs(KladManager.Network.active) do
        if task.id == request_id then
            task.cancelled = true
            if task.runner then
                local ok, error_value = pcall(function()
                    task.runner:cancel()
                end)
                if not ok then
                    KladManager.Diagnostics.last_error = tostring(error_value)
                end
            end
            return true
        end
    end
    return false
end

function KladManager.StartRequest(task)
    if not KladManager.Network.worker_factory then
        KladManager.QueueResult(task, false, nil, {
            code="HTTP_WORKER_UNAVAILABLE",
            message=tostring(KladManager.Network.worker_error or "worker unavailable")
        })
        return false
    end
    local ok, runner = pcall(
        KladManager.Network.worker_factory,
        task.method,
        task.url,
        KladManager.NetworkHeaders(task),
        task.body,
        task.timeout_ms
    )
    if not ok or not runner then
        KladManager.QueueResult(task, false, nil, {
            code="HTTP_WORKER_START",
            message=tostring(runner)
        })
        return false
    end
    task.runner = runner
    task.started_at = KladManager.NowMs()
    KladManager.Network.active[#KladManager.Network.active + 1] = task
    return true
end

function KladManager.FinishRequest(index, request_ok, response, error)
    local task = table.remove(KladManager.Network.active, index)
    if not task then
        return
    end
    task.runner = nil
    local status = response and tonumber(response.status) or 0
    if KladManager.NetworkCanRetry(task, status, error) then
        task.attempt = task.attempt + 1
        task.ready_at = KladManager.NowMs() + 500 * (2 ^ (task.attempt - 1))
        KladManager.Network.queue[#KladManager.Network.queue + 1] = task
        return
    end
    KladManager.QueueResult(task, request_ok, response, error)
end

function KladManager.TickNetwork()
    local network = KladManager.Network
    if network.shutting_down then
        return
    end
    local now = KladManager.NowMs()
    local queue_index = 1
    while #network.active < network.max_concurrent and queue_index <= #network.queue do
        local task = network.queue[queue_index]
        if task.cancelled then
            table.remove(network.queue, queue_index)
        elseif now >= task.ready_at then
            table.remove(network.queue, queue_index)
            KladManager.StartRequest(task)
        else
            queue_index = queue_index + 1
        end
    end
    for index = #network.active, 1, -1 do
        local task = network.active[index]
        if task.cancelled then
            KladManager.FinishRequest(index, false, nil, {
                code="HTTP_CANCELLED",
                message="Запрос отменён"
            })
        elseif task.runner then
            local ok_status, status, status_error = pcall(function()
                local state, worker_error = task.runner:status()
                return state, worker_error
            end)
            if not ok_status or status_error then
                KladManager.FinishRequest(index, false, nil, {
                    code="HTTP_WORKER_STATE",
                    message=tostring(status_error or status)
                })
            elseif status == "completed" then
                local ok_get, request_ok, response = pcall(function()
                    local worker_ok, worker_response = task.runner:get()
                    return worker_ok, worker_response
                end)
                if not ok_get then
                    KladManager.FinishRequest(index, false, nil, {
                        code="HTTP_WORKER_RESULT",
                        message=tostring(request_ok)
                    })
                elseif request_ok then
                    KladManager.FinishRequest(index, true, response, nil)
                else
                    KladManager.FinishRequest(index, false, nil, response)
                end
            elseif status == "cancelled" or status == "canceled" then
                KladManager.FinishRequest(index, false, nil, {
                    code="HTTP_CANCELLED",
                    message="Запрос отменён"
                })
            elseif KM_ELAPSED(task.started_at) > task.timeout_ms + 1000 then
                local ok_cancel, cancel_error = pcall(function()
                    task.runner:cancel()
                end)
                if not ok_cancel then
                    KladManager.Diagnostics.last_error = tostring(cancel_error)
                end
                KladManager.FinishRequest(index, false, nil, {
                    code="HTTP_TIMEOUT",
                    message="Время запроса истекло"
                })
            end
        end
    end
end

function KladManager.DecodeResponse(result)
    if not result.request_ok or not result.response then
        return false, nil, result.error or {
            code="HTTP_NETWORK",
            message="Сеть недоступна"
        }
    end
    local response = result.response
    KladManager.Diagnostics.api_latency_ms = tonumber(response.latency_ms) or 0
    local ok_json, decoded = pcall(KladManager.Json.decode, tostring(response.body or ""))
    if not ok_json or type(decoded) ~= "table" then
        return false, nil, {
            code="HTTP_SCHEMA",
            message="Сервер вернул неверный JSON",
            status=response.status
        }
    end
    decoded = KladManager.FromUtf8Data(decoded)
    if type(decoded.meta) ~= "table"
        or tostring(decoded.meta.request_id or "") ~= tostring(result.task.request_id) then
        return false, nil, {
            code="HTTP_SCHEMA",
            message="Request ID ответа не совпадает",
            status=response.status
        }
    end
    if tonumber(response.status) >= 200 and tonumber(response.status) < 300 then
        if type(decoded.data) ~= "table" then
            return false, nil, {
                code="HTTP_SCHEMA",
                message="Ответ сервера не содержит data",
                status=response.status
            }
        end
        return true, decoded.data, nil
    end
    local error_data = type(decoded.error) == "table" and decoded.error or {}
    return false, nil, {
        code=tostring(error_data.code or "HTTP_STATUS"),
        message=tostring(error_data.message or "Ошибка сервера"),
        status=tonumber(response.status) or 0
    }
end

function KladManager.DispatchNetworkResults()
    while #KladManager.Network.results > 0 do
        local result = table.remove(KladManager.Network.results, 1)
        local ok, data, error_data = KladManager.DecodeResponse(result)
        if not ok then
            KladManager.Diagnostics.requests_failed = KladManager.Diagnostics.requests_failed + 1
            KladManager.Diagnostics.last_error = tostring(error_data and error_data.code or "HTTP_ERROR")
        end
        if type(result.task.callback) == "function" then
            local callback_ok, callback_error = pcall(
                result.task.callback,
                ok,
                data,
                error_data
            )
            if not callback_ok then
                KladManager.Diagnostics.last_error = "Callback: " .. tostring(callback_error)
            end
        end
    end
end

function KladManager.ApiRequest(method, path, payload, options, callback)
    local request_id, error_code = KladManager.QueueRequest(
        method,
        path,
        payload,
        options,
        callback
    )
    if not request_id and type(callback) == "function" then
        KladManager.Network.results[#KladManager.Network.results + 1] = {
            task={callback=callback,request_id="local"},
            request_ok=false,
            response=nil,
            error={
                code=error_code,
                message=error_code == "API_NOT_CONFIGURED"
                    and "Адрес API не настроен"
                    or "Запрос недоступен"
            }
        }
    end
    return request_id
end

function KladManager.SetAuthState(state, message)
    KladManager.Auth.state = state
    KladManager.Auth.message = tostring(message or "")
    KladManager.Auth.busy = false
end

function KladManager.MapAuthError(error_data)
    local code = tostring(error_data and error_data.code or "HTTP_NETWORK")
    local message = tostring(error_data and error_data.message or "API недоступен.")
    if code == "LUA_MAINTENANCE" or code == "SERVICE_NOT_READY" then
        KladManager.SetAuthState("maintenance", message)
    elseif code == "LUA_ACCESS_RESTRICTED" or code == "LUA_SHARING_DETECTED"
        or code == "ACCOUNT_BLOCKED" then
        KladManager.SetAuthState("banned", message)
    elseif code == "LUA_HWID_MISMATCH" or code == "HWID_MISMATCH" then
        KladManager.SetAuthState("hwid_reset_required", message)
    elseif code == "LUA_REFRESH_INVALID" or code == "LUA_REFRESH_REPLAY"
        or code == "LUA_NONCE_REPLAY" or code == "LUA_SESSION_INVALID"
        or code == "LUA_SUBSCRIPTION_REQUIRED" or code == "AUTH_EXPIRED" then
        KladManager.ClearSession()
        KladManager.SetAuthState("expired", message)
    elseif code == "API_NOT_CONFIGURED" or code == "LUA_AUTH_UNAVAILABLE"
        or code == "UPSTREAM_UNAVAILABLE" or code:find("HTTP_", 1, true) == 1 then
        KladManager.SetAuthState("network_error", message)
    else
        KladManager.SetAuthState("rejected", message)
    end
end

function KladManager.ApplySession(session)
    if type(session) ~= "table"
        or type(session.session_id) ~= "string"
        or type(session.access_token) ~= "string"
        or type(session.refresh_token) ~= "string" then
        KladManager.MapAuthError({
            code="HTTP_SCHEMA",
            message="Сессия сервера повреждена"
        })
        return false
    end
    KladManager.Auth.session = {
        session_id=session.session_id,
        access_token=session.access_token,
        refresh_token=session.refresh_token,
        access_expires_at=session.access_expires_at,
        refresh_expires_at=session.refresh_expires_at
    }
    KladManager.Auth.access_deadline = os.time() + 540
    KladManager.SaveSession(KladManager.Auth.session)
    return true
end

function KladManager.LoadRemoteBootstrap()
    local session = KladManager.Auth.session
    if not session or not session.access_token then
        KladManager.SetAuthState("expired", "Сессия не найдена.")
        return
    end
    KladManager.Auth.busy = true
    KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/session/bootstrap",
        {
            protocol_version=KM_PROTOCOL_VERSION,
            client_version=KM_VERSION,
            device_proof=KladManager.DeviceSignals()
        },
        {
            authorization=session.access_token,
            idempotency_key=KladManager.NewRequestId("bootstrap")
        },
        function(ok, data, error_data)
            if not ok then
                KladManager.MapAuthError(error_data)
                return
            end
            if type(data.profile) ~= "table" or type(data.feature_flags) ~= "table" then
                KladManager.MapAuthError({
                    code="HTTP_SCHEMA",
                    message="Профиль сервера повреждён"
                })
                return
            end
            KladManager.Auth.profile = data.profile
            KladManager.Auth.feature_flags = data.feature_flags
            KladManager.Runtime.cache_generated_at = data.generated_at
            KladManager.Runtime.cache_received_at = KladManager.NowMs()
            KladManager.CabinetUrl = data.cabinet_url
            KladManager.HwidRequestUrl = data.hwid_request_url
            KladManager.DevelopmentFeatures.dopkas = data.feature_flags.coordinate_observations == true
                and data.feature_flags.lua_tab_dopkas == true
            KladManager.DevelopmentFeatures.spawns = data.feature_flags.lua_sync == true
                and data.feature_flags.lua_tab_spawns == true
            KladManager.DevelopmentFeatures.zones = data.feature_flags.coordinate_observations == true
                and data.feature_flags.lua_tab_zones == true
            KladManager.DevelopmentFeatures.logs = data.feature_flags.loot_upload == true
                and data.feature_flags.lua_tab_logs == true
            KladManager.DevelopmentFeatures.statistics = data.feature_flags.rating == true
                and data.feature_flags.lua_tab_statistics == true
            KladManager.ProcessServerNotifications(data.notifications)
            KladManager.Auth.state = "approved"
            KladManager.Auth.message = "Доступ подтверждён."
            KladManager.Auth.busy = false
            KladManager.Runtime.menu_open = KladManager.Runtime.auth_open
            KladManager.Runtime.auth_open = false
            KladManager.Gameplay.last_cluster_sync = -60000
            KladManager.Gameplay.last_loot_sync = -60000
            KladManager.BufferSet(KladManager.Buffers.password, 128, "")
            KladManager.SyncLootLogs(true)
            KladManager.QueryLootData(true)
            KladManager.Notify("success", "Авторизация", "Вход выполнен.", 4.0)
        end
    )
end

function KladManager.RefreshSession()
    if KladManager.Auth.refresh_busy then
        return
    end
    local session = KladManager.Auth.session or KladManager.LoadSession()
    if not session or not session.refresh_token then
        KladManager.SetAuthState("login", "Введите логин и пароль.")
        return
    end
    KladManager.Auth.refresh_busy = true
    KladManager.Auth.busy = true
    KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/session/refresh",
        {
            refresh_token=session.refresh_token,
            device_proof=KladManager.DeviceSignals(),
            nonce=KladManager.NewRequestId("refresh"),
            client_time=KladManager.UtcNow()
        },
        {},
        function(ok, data, error_data)
            KladManager.Auth.refresh_busy = false
            if not ok then
                KladManager.MapAuthError(error_data)
                return
            end
            if KladManager.ApplySession(data) then
                KladManager.LoadRemoteBootstrap()
            end
        end
    )
end

function KladManager.BeginLogin()
    if KladManager.Auth.busy then
        return
    end
    local username = KladManager.BufferGet(KladManager.Buffers.username):gsub("^%s+", ""):gsub("%s+$", "")
    local password = KladManager.BufferGet(KladManager.Buffers.password)
    if #username < 3 or #password < 8 then
        KladManager.SetAuthState("rejected", "Проверьте логин и пароль.")
        return
    end
    if KladManager.ApiBaseUrl == "" then
        KladManager.SetAuthState("network_error", "Адрес API не настроен.")
        return
    end
    KladManager.Auth.busy = true
    KladManager.Auth.state = "login"
    KladManager.Auth.message = "Проверяем аккаунт..."
    KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/session/challenge",
        {
            username=username,
            protocol_version=KM_PROTOCOL_VERSION,
            client_version=KM_VERSION,
            device_claim=KladManager.DeviceSignals()
        },
        {},
        function(challenge_ok, challenge, challenge_error)
            if not challenge_ok then
                KladManager.MapAuthError(challenge_error)
                return
            end
            if type(challenge.challenge_id) ~= "string"
                or type(challenge.server_nonce) ~= "string" then
                KladManager.MapAuthError({
                    code="HTTP_SCHEMA",
                    message="Challenge повреждён"
                })
                return
            end
            KladManager.Auth.challenge_id = challenge.challenge_id
            KladManager.Auth.server_nonce = challenge.server_nonce
            KladManager.ApiRequest(
                "POST",
                "/api/v1/lua/session/login",
                {
                    challenge_id=challenge.challenge_id,
                    server_nonce=challenge.server_nonce,
                    password=password,
                    protocol_version=KM_PROTOCOL_VERSION,
                    client_version=KM_VERSION,
                    device_proof=KladManager.DeviceSignals(),
                    client_time=KladManager.UtcNow()
                },
                {},
                function(login_ok, login_data, login_error)
                    if not login_ok then
                        KladManager.MapAuthError(login_error)
                        return
                    end
                    if login_data.state == "authenticated" and type(login_data.session) == "table" then
                        if KladManager.ApplySession(login_data.session) then
                            KladManager.LoadRemoteBootstrap()
                        end
                    elseif login_data.state == "two_factor_required"
                        and type(login_data.challenge) == "table"
                        and type(login_data.challenge.challenge_id) == "string" then
                        KladManager.Auth.two_factor_id = login_data.challenge.challenge_id
                        KladManager.Auth.two_factor_expires = login_data.challenge.expires_at
                        KladManager.Auth.next_poll_at = KladManager.NowMs() + 2000
                        KladManager.Auth.resend_at = KladManager.NowMs() + 60000
                        KladManager.SetAuthState(
                            "new_device",
                            "Подтвердите новый компьютер в Telegram."
                        )
                    else
                        KladManager.MapAuthError({
                            code="HTTP_SCHEMA",
                            message="Неизвестное состояние входа"
                        })
                    end
                end
            )
        end
    )
end

function KladManager.CompleteTwoFactor(code)
    if KladManager.Auth.busy or not KladManager.Auth.two_factor_id then
        return
    end
    local payload = {
        challenge_id=KladManager.Auth.two_factor_id,
        device_proof=KladManager.DeviceSignals()
    }
    if code and code ~= "" then
        payload.code = code
    end
    KladManager.Auth.busy = true
    KladManager.Auth.state = "telegram_2fa"
    KladManager.Auth.message = "Проверяем подтверждение..."
    KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/session/2fa",
        payload,
        {},
        function(ok, data, error_data)
            if not ok then
                KladManager.MapAuthError(error_data)
                return
            end
            if KladManager.ApplySession(data) then
                KladManager.LoadRemoteBootstrap()
            end
        end
    )
end

function KladManager.PollTwoFactor()
    if KladManager.Auth.busy or not KladManager.Auth.two_factor_id then
        return
    end
    KladManager.Auth.busy = true
    KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/session/2fa/status",
        {
            challenge_id=KladManager.Auth.two_factor_id,
            device_proof=KladManager.DeviceSignals()
        },
        {},
        function(ok, data, error_data)
            KladManager.Auth.busy = false
            if not ok then
                KladManager.MapAuthError(error_data)
                return
            end
            local status = tostring(data.status or "")
            if status == "approved" then
                KladManager.CompleteTwoFactor(nil)
            elseif status == "rejected" then
                KladManager.SetAuthState("rejected", "Вход отклонён в Telegram.")
            elseif status == "expired" then
                KladManager.SetAuthState("expired", "Подтверждение истекло.")
            else
                KladManager.Auth.state = "telegram_2fa"
                KladManager.Auth.message = "Ожидаем подтверждение в Telegram."
                KladManager.Auth.next_poll_at = KladManager.NowMs() + 2000
            end
        end
    )
end

function KladManager.TickAuth()
    if (KladManager.Auth.state == "telegram_2fa" or KladManager.Auth.state == "new_device")
        and not KladManager.Auth.busy
        and KladManager.NowMs() >= KladManager.Auth.next_poll_at then
        KladManager.PollTwoFactor()
    end
    if KladManager.Auth.state == "approved"
        and KladManager.Auth.session
        and not KladManager.Auth.refresh_busy
        and os.time() >= KladManager.Auth.access_deadline then
        KladManager.RefreshSession()
    end
end

function KladManager.Logout()
    local session = KladManager.Auth.session
    if not session then
        KladManager.ClearSession()
        KladManager.SetAuthState("login", "Сессия закрыта.")
        return
    end
    KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/session/logout",
        {
            session_id=session.session_id,
            device_proof=KladManager.DeviceSignals(),
            nonce=KladManager.NewRequestId("logout"),
            client_time=KladManager.UtcNow()
        },
        {authorization=session.access_token},
        function(ok, data, error_data)
            KladManager.ClearSession()
            KladManager.Runtime.menu_open = false
            KladManager.Runtime.minimap_open = false
            if ok and data.closed == true then
                KladManager.SetAuthState("login", "Вы вышли из аккаунта.")
            else
                KladManager.SetAuthState(
                    "login",
                    error_data and error_data.message or "Локальная сессия закрыта."
                )
            end
        end
    )
end

