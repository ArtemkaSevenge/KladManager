function KM_LOG(text)
    print("[KladManager] " .. text)
    if isSampAvailable and isSampAvailable() then
        sampAddChatMessage("[KladManager] " .. text, KM_CHAT_COLOR)
    end
end

function KM_READ(path)
    local handle = io.open(path, "rb")
    if not handle then
        return nil
    end
    local payload = handle:read("*a")
    handle:close()
    return payload
end

function KM_WRITE(path, payload)
    local handle = io.open(path, "wb")
    if not handle then
        return false
    end
    local ok = handle:write(payload)
    handle:flush()
    handle:close()
    return ok ~= nil
end

function KM_FILE_EXISTS(path)
    local handle = io.open(path, "rb")
    if not handle then
        return false
    end
    handle:close()
    return true
end

function KM_FILE_SIZE(path)
    local handle = io.open(path, "rb")
    if not handle then
        return nil
    end
    local size = handle:seek("end")
    handle:close()
    return size
end

function KM_PARENT(path)
    return path:match("^(.*)\\[^\\]+$")
end

function KM_ENSURE_DIR(path)
    if doesDirectoryExist(path) then
        return true
    end
    local prefix = ""
    local rest = path
    local drive = path:match("^(%a:)\\")
    if drive then
        prefix = drive .. "\\"
        rest = path:sub(4)
    end
    for part in rest:gmatch("[^\\]+") do
        if prefix == "" or prefix:sub(-1) == "\\" then
            prefix = prefix .. part
        else
            prefix = prefix .. "\\" .. part
        end
        if not doesDirectoryExist(prefix) and not createDirectory(prefix) then
            return false
        end
    end
    return doesDirectoryExist(path)
end

function KM_ENSURE_PARENT(path)
    local parent = KM_PARENT(path)
    return parent ~= nil and KM_ENSURE_DIR(parent)
end

function KM_SAFE_REMOVE(path)
    if path and KM_FILE_EXISTS(path) then
        return os.remove(path) ~= nil
    end
    return true
end

function KM_TRACK_TEMP(path)
    local handle = io.open(KM_TEMP_LEDGER, "ab")
    if handle then
        handle:write(path .. "\r\n")
        handle:close()
    end
end

function KM_CLEAN_TEMPS()
    local payload = KM_READ(KM_TEMP_LEDGER)
    if payload then
        for path in payload:gmatch("[^\r\n]+") do
            if path:sub(1, #KM_ROOT) == KM_ROOT and path:find("%.km%.", 1, false) then
                KM_SAFE_REMOVE(path)
            end
        end
    end
    KM_SAFE_REMOVE(KM_TEMP_LEDGER)
end

function KM_U32(value)
    if value < 0 then
        return value + 4294967296
    end
    return value
end

function KM_BE32(value)
    local unsigned = KM_U32(value)
    local a = math.floor(unsigned / 16777216) % 256
    local b = math.floor(unsigned / 65536) % 256
    local c = math.floor(unsigned / 256) % 256
    local d = unsigned % 256
    return string.char(a, b, c, d)
end

function KM_SHA256(payload)
    local band = KM_BIT.band
    local bxor = KM_BIT.bxor
    local bnot = KM_BIT.bnot
    local rshift = KM_BIT.rshift
    local ror = KM_BIT.ror
    local length = #payload
    local bit_length = length * 8
    local high = math.floor(bit_length / 4294967296)
    local low = bit_length % 4294967296
    local padded = payload .. string.char(128)
    local zero_count = (56 - (#padded % 64)) % 64
    padded = padded .. string.rep(string.char(0), zero_count) .. KM_BE32(high) .. KM_BE32(low)
    local h0 = 0x6a09e667
    local h1 = 0xbb67ae85
    local h2 = 0x3c6ef372
    local h3 = 0xa54ff53a
    local h4 = 0x510e527f
    local h5 = 0x9b05688c
    local h6 = 0x1f83d9ab
    local h7 = 0x5be0cd19
    for chunk = 1, #padded, 64 do
        local w = {}
        for index = 0, 15 do
            local position = chunk + index * 4
            local a, b, c, d = padded:byte(position, position + 3)
            w[index] = KM_BIT.tobit(a * 16777216 + b * 65536 + c * 256 + d)
        end
        for index = 16, 63 do
            local x = w[index - 15]
            local y = w[index - 2]
            local s0 = bxor(ror(x, 7), ror(x, 18), rshift(x, 3))
            local s1 = bxor(ror(y, 17), ror(y, 19), rshift(y, 10))
            w[index] = KM_BIT.tobit(w[index - 16] + s0 + w[index - 7] + s1)
        end
        local a = h0
        local b = h1
        local c = h2
        local d = h3
        local e = h4
        local f = h5
        local g = h6
        local h = h7
        for index = 0, 63 do
            local s1 = bxor(ror(e, 6), ror(e, 11), ror(e, 25))
            local choice = bxor(band(e, f), band(bnot(e), g))
            local temp1 = KM_BIT.tobit(h + s1 + choice + KM_SHA256_K[index + 1] + w[index])
            local s0 = bxor(ror(a, 2), ror(a, 13), ror(a, 22))
            local majority = bxor(band(a, b), band(a, c), band(b, c))
            local temp2 = KM_BIT.tobit(s0 + majority)
            h = g
            g = f
            f = e
            e = KM_BIT.tobit(d + temp1)
            d = c
            c = b
            b = a
            a = KM_BIT.tobit(temp1 + temp2)
        end
        h0 = KM_BIT.tobit(h0 + a)
        h1 = KM_BIT.tobit(h1 + b)
        h2 = KM_BIT.tobit(h2 + c)
        h3 = KM_BIT.tobit(h3 + d)
        h4 = KM_BIT.tobit(h4 + e)
        h5 = KM_BIT.tobit(h5 + f)
        h6 = KM_BIT.tobit(h6 + g)
        h7 = KM_BIT.tobit(h7 + h)
    end
    return string.format(
        "%08x%08x%08x%08x%08x%08x%08x%08x",
        KM_U32(h0), KM_U32(h1), KM_U32(h2), KM_U32(h3),
        KM_U32(h4), KM_U32(h5), KM_U32(h6), KM_U32(h7)
    )
end

function KM_JSON_UTF8(codepoint)
    if codepoint <= 127 then
        return string.char(codepoint)
    elseif codepoint <= 2047 then
        return string.char(192 + math.floor(codepoint / 64), 128 + codepoint % 64)
    end
    return string.char(
        224 + math.floor(codepoint / 4096),
        128 + math.floor(codepoint / 64) % 64,
        128 + codepoint % 64
    )
end

function KM_JSON_PARSE(payload)
    local position = 1
    local length = #payload
    local function skip_space()
        while position <= length and payload:sub(position, position):match("%s") do
            position = position + 1
        end
    end
    local function parse_string()
        if payload:sub(position, position) ~= '"' then
            error("string expected")
        end
        position = position + 1
        local output = {}
        while position <= length do
            local byte = payload:byte(position)
            if byte == 34 then
                position = position + 1
                return table.concat(output)
            elseif byte == 92 then
                position = position + 1
                local escaped = payload:sub(position, position)
                local simple = {['"']='"',['\\']='\\',['/']='/',b='\b',f='\f',n='\n',r='\r',t='\t'}
                if simple[escaped] then
                    output[#output + 1] = simple[escaped]
                    position = position + 1
                elseif escaped == "u" then
                    local hex = payload:sub(position + 1, position + 4)
                    if not hex:match("^[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$") then
                        error("invalid unicode escape")
                    end
                    output[#output + 1] = KM_JSON_UTF8(tonumber(hex, 16))
                    position = position + 5
                else
                    error("invalid string escape")
                end
            elseif byte < 32 then
                error("control byte in string")
            else
                output[#output + 1] = string.char(byte)
                position = position + 1
            end
        end
        error("unterminated string")
    end
    local function parse_number()
        local start = position
        if payload:sub(position, position) == "-" then
            position = position + 1
        end
        while position <= length and payload:sub(position, position):match("%d") do
            position = position + 1
        end
        local raw = payload:sub(start, position - 1)
        if not raw:match("^-?%d+$") then
            error("invalid number")
        end
        return tonumber(raw)
    end
    skip_space()
    if payload:sub(position, position) ~= "{" then
        return nil, "object expected"
    end
    position = position + 1
    local result = {}
    local ok, err = pcall(function()
        skip_space()
        if payload:sub(position, position) == "}" then
            position = position + 1
            return
        end
        while position <= length do
            skip_space()
            local key = parse_string()
            if result[key] ~= nil then
                error("duplicate key")
            end
            skip_space()
            if payload:sub(position, position) ~= ":" then
                error("colon expected")
            end
            position = position + 1
            skip_space()
            local current = payload:sub(position, position)
            if current == '"' then
                result[key] = parse_string()
            elseif current == "-" or current:match("%d") then
                result[key] = parse_number()
            else
                error("unsupported value")
            end
            skip_space()
            current = payload:sub(position, position)
            if current == "}" then
                position = position + 1
                break
            elseif current ~= "," then
                error("comma expected")
            end
            position = position + 1
        end
        skip_space()
        if position <= length then
            error("trailing data")
        end
    end)
    if not ok then
        return nil, tostring(err)
    end
    return result, nil
end

function KM_IS_VERSION(value)
    return type(value) == "string" and value:match("^0$") == nil and value:match("^%d+%.%d+%.%d+$") ~= nil
end

function KM_VERSION_PARTS(value)
    local major, minor, patch = value:match("^(%d+)%.(%d+)%.(%d+)$")
    if not major then
        return nil
    end
    local major_number = tonumber(major)
    local minor_number = tonumber(minor)
    local patch_number = tonumber(patch)
    if tostring(major_number) ~= major or tostring(minor_number) ~= minor
        or tostring(patch_number) ~= patch then
        return nil
    end
    return major_number, minor_number, patch_number
end

function KM_VERSION_COMPARE(left, right)
    local la, lb, lc = KM_VERSION_PARTS(left)
    local ra, rb, rc = KM_VERSION_PARTS(right)
    if not la or not ra then
        return nil
    end
    if la ~= ra then
        return la < ra and -1 or 1
    elseif lb ~= rb then
        return lb < rb and -1 or 1
    elseif lc ~= rc then
        return lc < rc and -1 or 1
    end
    return 0
end

function KM_IS_HTTPS(value)
    return type(value) == "string"
        and value:match("^https://") ~= nil
        and value:find("%s") == nil
        and value:find("#", 1, true) == nil
        and value:find("@", 1, true) == nil
end

function KM_VALIDATE_MANIFEST(value)
    local expected = {
        schema_version="number",version="string",protocol_version="number",
        script_url="string",libs_version="string",libs_url="string",
        assets_version="string",map_url="string",icons_url="string",
        atlas_url="string",release_notes="string",maintenance_message="string"
    }
    local count = 0
    for key, field_type in pairs(expected) do
        count = count + 1
        if type(value[key]) ~= field_type then
            return false
        end
    end
    local actual = 0
    for key in pairs(value) do
        actual = actual + 1
        if expected[key] == nil then
            return false
        end
    end
    if actual ~= count or value.schema_version ~= 2 or value.protocol_version ~= KM_PROTOCOL_VERSION then
        return false
    end
    if not KM_VERSION_PARTS(value.version) or not KM_VERSION_PARTS(value.libs_version)
        or not KM_VERSION_PARTS(value.assets_version) then
        return false
    end
    if #value.release_notes > 2000 or #value.maintenance_message > 500 then
        return false
    end
    local urls = {value.script_url,value.libs_url,value.map_url,value.icons_url,value.atlas_url}
    local seen = {}
    for _, url in ipairs(urls) do
        if not KM_IS_HTTPS(url) or seen[url] then
            return false
        end
        seen[url] = true
    end
    return true
end

function KM_ELAPSED(started)
    local current = getGameTimer()
    if current >= started then
        return current - started
    end
    return current + 4294967296 - started
end

function KM_DOWNLOAD(url, target, timeout)
    KM_DOWNLOAD_SEQUENCE = KM_DOWNLOAD_SEQUENCE + 1
    local sequence = KM_DOWNLOAD_SEQUENCE
    local done = false
    local success = false
    local received = false
    KM_SAFE_REMOVE(target)
    KM_TRACK_TEMP(target)
    local ok = pcall(function()
        downloadUrlToFile(url, target, function(id, status)
            if sequence ~= KM_DOWNLOAD_SEQUENCE then
                KM_SAFE_REMOVE(target)
                return
            end
            if status == KladManager.DownloadStatus.STATUS_ENDDOWNLOADDATA then
                received = true
            elseif status == KladManager.DownloadStatus.STATUSEX_ENDDOWNLOAD then
                success = received and KM_FILE_EXISTS(target)
                done = true
            end
        end)
    end)
    if not ok then
        KM_SAFE_REMOVE(target)
        return false, "start"
    end
    local started = getGameTimer()
    while not done and KM_ELAPSED(started) < timeout do
        wait(0)
    end
    if not done then
        KM_DOWNLOAD_SEQUENCE = KM_DOWNLOAD_SEQUENCE + 1
        KM_SAFE_REMOVE(target)
        return false, "timeout"
    end
    if not success then
        KM_SAFE_REMOVE(target)
        return false, "network"
    end
    local size = KM_FILE_SIZE(target)
    if not size or size < 1 or size > KM_MAX_DOWNLOAD then
        KM_SAFE_REMOVE(target)
        return false, "size"
    end
    return true, nil
end

function KM_FETCH(url, target)
    local ok, reason = KM_DOWNLOAD(url, target, KM_DOWNLOAD_TIMEOUT)
    if not ok then
        return false, reason
    end
    return true, nil
end

function KM_LE16(data, position)
    local a, b = data:byte(position, position + 1)
    if not b then
        return nil
    end
    return a + b * 256
end

function KM_LE32(data, position)
    local a, b, c, d = data:byte(position, position + 3)
    if not d then
        return nil
    end
    return a + b * 256 + c * 65536 + d * 16777216
end

function KM_CRC32(payload)
    local crc = -1
    for position = 1, #payload do
        crc = KM_BIT.bxor(crc, payload:byte(position))
        for _ = 1, 8 do
            if KM_BIT.band(crc, 1) ~= 0 then
                crc = KM_BIT.bxor(KM_BIT.rshift(crc, 1), 0xEDB88320)
            else
                crc = KM_BIT.rshift(crc, 1)
            end
        end
    end
    return KM_U32(KM_BIT.bnot(crc))
end

function KM_SAFE_ZIP_PATH(path)
    if type(path) ~= "string" or path == "" or path:find("\\", 1, true) or path:find("\0", 1, true) then
        return false
    end
    if path:sub(1, 1) == "/" or path:match("^%a:") or path:sub(-1) == "/" then
        return false
    end
    for part in path:gmatch("[^/]+") do
        if part == "." or part == ".." or part == "" then
            return false
        end
    end
    return path:match("^lib/") ~= nil
        or path:match("^resource/fonts/") ~= nil
        or path == "KladManager/KladManager_Libs.index.json"
end

function KM_PARSE_ZIP(data)
    local eocd = nil
    local first = math.max(1, #data - 65557)
    for position = #data - 21, first, -1 do
        if data:sub(position, position + 3) == "PK\005\006" then
            eocd = position
            break
        end
    end
    if not eocd then
        return nil, "eocd"
    end
    local disk = KM_LE16(data, eocd + 4)
    local central_disk = KM_LE16(data, eocd + 6)
    local disk_entries = KM_LE16(data, eocd + 8)
    local entries_count = KM_LE16(data, eocd + 10)
    local central_size = KM_LE32(data, eocd + 12)
    local central_offset = KM_LE32(data, eocd + 16)
    local comment_length = KM_LE16(data, eocd + 20)
    if not comment_length or eocd + 22 + comment_length - 1 ~= #data then
        return nil, "trailing"
    end
    if disk ~= 0 or central_disk ~= 0 or disk_entries ~= entries_count then
        return nil, "multidisk"
    end
    if entries_count < 1 or entries_count > 256 then
        return nil, "count"
    end
    local position = central_offset + 1
    local central_end = position + central_size
    local entries = {}
    local total = 0
    for index = 1, entries_count do
        if data:sub(position, position + 3) ~= "PK\001\002" then
            return nil, "central"
        end
        local flags = KM_LE16(data, position + 8)
        local method = KM_LE16(data, position + 10)
        local crc = KM_LE32(data, position + 16)
        local compressed = KM_LE32(data, position + 20)
        local size = KM_LE32(data, position + 24)
        local name_length = KM_LE16(data, position + 28)
        local extra_length = KM_LE16(data, position + 30)
        local entry_comment = KM_LE16(data, position + 32)
        local entry_disk = KM_LE16(data, position + 34)
        local external = KM_LE32(data, position + 38)
        local local_offset = KM_LE32(data, position + 42)
        if not local_offset or not entry_comment or not extra_length or not name_length then
            return nil, "header"
        end
        local name = data:sub(position + 46, position + 45 + name_length)
        if not KM_SAFE_ZIP_PATH(name) or entries[name] then
            return nil, "path"
        end
        if KM_BIT.band(flags, 9) ~= 0 or method ~= 0 or compressed ~= size then
            return nil, "flags"
        end
        if entry_disk ~= 0 or KM_BIT.band(math.floor(external / 65536), 61440) == 40960 then
            return nil, "link"
        end
        if size > 16777216 then
            return nil, "entry_size"
        end
        total = total + size
        if total > KM_MAX_DOWNLOAD then
            return nil, "total_size"
        end
        local local_position = local_offset + 1
        if data:sub(local_position, local_position + 3) ~= "PK\003\004" then
            return nil, "local"
        end
        local local_flags = KM_LE16(data, local_position + 6)
        local local_method = KM_LE16(data, local_position + 8)
        local local_crc = KM_LE32(data, local_position + 14)
        local local_compressed = KM_LE32(data, local_position + 18)
        local local_size = KM_LE32(data, local_position + 22)
        local local_name_length = KM_LE16(data, local_position + 26)
        local local_extra_length = KM_LE16(data, local_position + 28)
        if not local_extra_length or not local_name_length then
            return nil, "local_header"
        end
        local local_name = data:sub(local_position + 30, local_position + 29 + local_name_length)
        if local_name ~= name or local_flags ~= flags or local_method ~= method
            or local_crc ~= crc or local_compressed ~= compressed or local_size ~= size then
            return nil, "local_mismatch"
        end
        local data_position = local_position + 30 + local_name_length + local_extra_length
        local last = data_position + size - 1
        if last >= central_offset + 1 then
            return nil, "overlap"
        end
        entries[name] = {data_position=data_position,size=size,crc=crc,index=index}
        position = position + 46 + name_length + extra_length + entry_comment
    end
    if position ~= central_end or central_end ~= eocd then
        return nil, "central_size"
    end
    return entries, nil
end

function KM_MARKER_VERSION(path)
    local payload = KM_READ(path)
    return payload and payload:match("^([^\r\n]+)") or nil
end

function KM_LIB_FILE_OK(relative, absolute)
    local target = absolute or KM_ROOT .. "\\" .. relative:gsub("/", "\\")
    local size = KM_FILE_SIZE(target)
    if not size or size < 1 or size > 16777216 then
        return false
    end
    if relative:sub(-4):lower() == ".lua" then
        return loadfile(target) ~= nil
    elseif relative:sub(-4):lower() == ".dll" then
        local payload = KM_READ(target)
        return payload ~= nil and payload:sub(1, 2) == "MZ"
    end
    return true
end

function KM_LIB_FILES_OK()
    for _, relative in ipairs(KM_LIB_REQUIRED) do
        if not KM_LIB_FILE_OK(relative) then
            return false
        end
    end
    return true
end

function KM_LIBS_OK(expected_version)
    return KM_IS_VERSION(expected_version)
        and KM_MARKER_VERSION(KM_LIBS_MARKER) == expected_version
        and KM_LIB_FILES_OK()
end

function KM_ROLLBACK_FILES(changes)
    for index = #changes, 1, -1 do
        local change = changes[index]
        KM_SAFE_REMOVE(change.target)
        if change.backup and KM_FILE_EXISTS(change.backup) then
            os.rename(change.backup, change.target)
        end
    end
end

function KM_INSTALL_LIBS(archive_path, expected_version)
    local data = KM_READ(archive_path)
    if not data then
        return false, "read"
    end
    local entries, reason = KM_PARSE_ZIP(data)
    if not entries then
        return false, reason
    end
    local index_name = "KladManager/KladManager_Libs.index.json"
    local index_entry = entries[index_name]
    if not index_entry or index_entry.size > 262144 then
        return false, "index"
    end
    local index_data = data:sub(
        index_entry.data_position,
        index_entry.data_position + index_entry.size - 1
    )
    if not index_data:find('"libs_version":"' .. expected_version .. '"', 1, true) then
        return false, "version"
    end
    local archive_count = 0
    for name in pairs(entries) do
        archive_count = archive_count + 1
        if name ~= index_name then
            local required = false
            for _, item in ipairs(KM_LIB_REQUIRED) do
                if item == name then
                    required = true
                    break
                end
            end
            if not required then
                return false, "unexpected"
            end
        end
    end
    if archive_count ~= #KM_LIB_REQUIRED + 1 then
        return false, "missing"
    end
    local token = tostring(getGameTimer()) .. "." .. tostring(math.random(100000, 999999))
    local stage_root = KM_CONFIG .. "\\stage.km." .. token
    local staged = {}
    for _, relative in ipairs(KM_LIB_REQUIRED) do
        local entry = entries[relative]
        if not entry or entry.size < 1 then
            return false, "required"
        end
        local payload = data:sub(entry.data_position, entry.data_position + entry.size - 1)
        if #payload ~= entry.size or KM_CRC32(payload) ~= entry.crc then
            return false, "required_crc"
        end
        if relative:sub(-4):lower() == ".dll" and payload:sub(1, 2) ~= "MZ" then
            return false, "required_dll"
        end
        local stage = stage_root .. "\\" .. relative:gsub("/", "\\")
        if not KM_ENSURE_PARENT(stage) or not KM_WRITE(stage, payload) then
            for _, old in ipairs(staged) do
                KM_SAFE_REMOVE(old.path)
            end
            return false, "stage"
        end
        if not KM_LIB_FILE_OK(relative, stage) then
            KM_SAFE_REMOVE(stage)
            for _, old in ipairs(staged) do
                KM_SAFE_REMOVE(old.path)
            end
            return false, "stage_validation"
        end
        staged[#staged + 1] = {path=stage,relative=relative}
    end
    local changes = {}
    for _, item in ipairs(staged) do
        local target = KM_ROOT .. "\\" .. item.relative:gsub("/", "\\")
        local backup = target .. ".kmbackup"
        if not KM_ENSURE_PARENT(target) then
            KM_ROLLBACK_FILES(changes)
            return false, "directory"
        end
        KM_SAFE_REMOVE(backup)
        local had_target = KM_FILE_EXISTS(target)
        if had_target and not os.rename(target, backup) then
            KM_ROLLBACK_FILES(changes)
            return false, "backup"
        end
        changes[#changes + 1] = {target=target,backup=had_target and backup or nil}
        if not os.rename(item.path, target) then
            KM_ROLLBACK_FILES(changes)
            return false, "replace"
        end
    end
    if not KM_LIB_FILES_OK() then
        KM_ROLLBACK_FILES(changes)
        return false, "verify"
    end
    if not KM_WRITE(KM_LIBS_MARKER, expected_version .. "\r\n") then
        KM_ROLLBACK_FILES(changes)
        return false, "marker"
    end
    for _, change in ipairs(changes) do
        if change.backup then
            KM_SAFE_REMOVE(change.backup)
        end
    end
    return KM_LIBS_OK(expected_version), nil
end

function KM_BOOTSTRAP_LIBS(manifest)
    KladManager.Runtime.libs_version = manifest.libs_version
    if KM_LIBS_OK(manifest.libs_version) then
        return true
    end
    KM_LOG("Загрузка библиотек")
    local archive = KM_CONFIG .. "\\KladManager_Libs.km." .. tostring(getGameTimer()) .. ".tmp"
    local ok = KM_FETCH(manifest.libs_url, archive)
    if not ok then
        return false
    end
    local installed = KM_INSTALL_LIBS(archive, manifest.libs_version)
    KM_SAFE_REMOVE(archive)
    return installed and KM_LIBS_OK(manifest.libs_version)
end

function KM_HANDLE_PENDING()
    local state = KM_READ(KM_PENDING)
    if not state then
        return true
    end
    state = state:match("^([^\r\n]+)")
    local script_path = thisScript().path
    local backup = script_path .. ".km.bak"
    if state == "booting" then
        local failed = script_path .. ".km.failed"
        KM_SAFE_REMOVE(failed)
        if KM_FILE_EXISTS(backup) and os.rename(script_path, failed) and os.rename(backup, script_path) then
            KM_SAFE_REMOVE(failed)
            KM_SAFE_REMOVE(KM_PENDING)
            KM_LOG("Обновление отменено")
            thisScript():reload()
            return false
        end
        return false
    elseif state == "pending" then
        return KM_WRITE(KM_PENDING, "booting\r\n")
    end
    return false
end

function KM_COMMIT_PENDING()
    local script_path = thisScript().path
    KM_SAFE_REMOVE(script_path .. ".km.bak")
    KM_SAFE_REMOVE(KM_PENDING)
end

function KM_UPDATE_SCRIPT(manifest)
    local comparison = KM_VERSION_COMPARE(KM_VERSION, manifest.version)
    if comparison == nil then
        return false
    end
    if comparison == 0 then
        return true
    end
    KM_LOG("Загрузка обновления")
    local script_path = thisScript().path
    local temporary = script_path .. ".km." .. tostring(getGameTimer()) .. ".tmp"
    local backup = script_path .. ".km.bak"
    local ok = KM_FETCH(manifest.script_url, temporary)
    if not ok then
        KM_LOG("Ошибка обновления")
        return false
    end
    local chunk = loadfile(temporary)
    if not chunk then
        KM_SAFE_REMOVE(temporary)
        KM_LOG("Файл обновления повреждён")
        return false
    end
    KM_SAFE_REMOVE(backup)
    if not os.rename(script_path, backup) then
        KM_SAFE_REMOVE(temporary)
        return false
    end
    if not os.rename(temporary, script_path) then
        os.rename(backup, script_path)
        KM_SAFE_REMOVE(temporary)
        return false
    end
    if not KM_WRITE(KM_PENDING, "pending\r\n") then
        KM_SAFE_REMOVE(script_path)
        os.rename(backup, script_path)
        return false
    end
    KM_LOG("Обновление установлено")
    thisScript():reload()
    return false
end

function KM_LOAD_MANIFEST()
    local target = KM_CONFIG .. "\\manifest.km." .. tostring(getGameTimer()) .. ".tmp"
    local ok, reason = KM_DOWNLOAD(KM_MANIFEST_URL, target, KM_DOWNLOAD_TIMEOUT)
    if not ok then
        return nil, reason
    end
    local payload = KM_READ(target)
    KM_SAFE_REMOVE(target)
    if not payload or #payload > 65536 then
        return nil, "size"
    end
    local manifest = KM_JSON_PARSE(payload)
    if not manifest or not KM_VALIDATE_MANIFEST(manifest) then
        return nil, "manifest"
    end
    return manifest, nil
end

function KM_ASSET_FILE_OK(kind, path)
    local payload = KM_READ(path)
    if not payload or #payload < 2 or #payload > KM_MAX_DOWNLOAD then
        return false
    end
    if kind == "map" then
        return payload:sub(1, 2) == string.char(255, 216)
            and payload:sub(-2) == string.char(255, 217)
    elseif kind == "atlas" then
        return payload:sub(1, 8) == string.char(137) .. "PNG\r\n" .. string.char(26) .. "\n"
    elseif kind == "icons" then
        local first = payload:match("^%s*(.)")
        local last = payload:match("(.)%s*$")
        return first == "{" and last == "}"
    end
    return false
end

function KM_ASSET_FILES_OK()
    return KM_ASSET_FILE_OK("map", KM_IMAGES .. "\\Map.jpg")
        and KM_ASSET_FILE_OK("icons", KM_ITEMS .. "\\icons.json")
        and KM_ASSET_FILE_OK("atlas", KM_ITEMS .. "\\items_atlas.png")
end

function KM_ASSETS_OK(expected_version)
    return KM_IS_VERSION(expected_version)
        and KM_MARKER_VERSION(KM_ASSETS_MARKER) == expected_version
        and KM_ASSET_FILES_OK()
end

function KM_BOOTSTRAP_ASSETS(manifest)
    KladManager.Runtime.assets_version = manifest.assets_version
    if KM_ASSETS_OK(manifest.assets_version) then
        return true
    end
    KM_LOG("Загрузка ресурсов")
    local token = tostring(getGameTimer()) .. "." .. tostring(math.random(100000, 999999))
    local assets = {
        {kind="map",url=manifest.map_url,target=KM_IMAGES .. "\\Map.jpg"},
        {kind="icons",url=manifest.icons_url,target=KM_ITEMS .. "\\icons.json"},
        {kind="atlas",url=manifest.atlas_url,target=KM_ITEMS .. "\\items_atlas.png"}
    }
    local staged = {}
    for _, asset in ipairs(assets) do
        local temporary = KM_CONFIG .. "\\asset." .. asset.kind .. ".km." .. token .. ".tmp"
        local ok = KM_FETCH(asset.url, temporary)
        if not ok or not KM_ASSET_FILE_OK(asset.kind, temporary) then
            KM_SAFE_REMOVE(temporary)
            for _, old in ipairs(staged) do
                KM_SAFE_REMOVE(old.path)
            end
            return false
        end
        staged[#staged + 1] = {path=temporary,asset=asset}
    end
    local changes = {}
    for _, item in ipairs(staged) do
        local target = item.asset.target
        local backup = target .. ".kmassetbackup"
        if not KM_ENSURE_PARENT(target) then
            KM_ROLLBACK_FILES(changes)
            return false
        end
        KM_SAFE_REMOVE(backup)
        local had_target = KM_FILE_EXISTS(target)
        if had_target and not os.rename(target, backup) then
            KM_ROLLBACK_FILES(changes)
            return false
        end
        changes[#changes + 1] = {target=target,backup=had_target and backup or nil}
        if not os.rename(item.path, target) then
            KM_ROLLBACK_FILES(changes)
            return false
        end
    end
    if not KM_ASSET_FILES_OK() or not KM_WRITE(KM_ASSETS_MARKER, manifest.assets_version .. "\r\n") then
        KM_ROLLBACK_FILES(changes)
        return false
    end
    for _, change in ipairs(changes) do
        if change.backup then
            KM_SAFE_REMOVE(change.backup)
        end
    end
    return KM_ASSETS_OK(manifest.assets_version)
end

function KM_LOAD_OPTIONAL_CORE()
    local encoding_ok, encoding = pcall(require, "encoding")
    local json_ok, json = pcall(require, "json")
    local effil_ok, effil = pcall(require, "effil")
    local imgui_ok, imgui = pcall(require, "mimgui")
    local ffi_ok, ffi = pcall(require, "ffi")
    local fa_ok, fa = pcall(require, "fAwesome6")
    local sampev_ok, sampev = pcall(require, "lib.samp.events")
    if not encoding_ok or not json_ok or not effil_ok or not imgui_ok or not ffi_ok
        or not fa_ok or not sampev_ok then
        KladManager.CoreLoadError = table.concat({
            encoding_ok and "" or tostring(encoding),
            json_ok and "" or tostring(json),
            effil_ok and "" or tostring(effil),
            imgui_ok and "" or tostring(imgui),
            ffi_ok and "" or tostring(ffi),
            fa_ok and "" or tostring(fa),
            sampev_ok and "" or tostring(sampev)
        }, " ")
        return false
    end
    encoding.default = "CP1251"
    KM_ENCODING = encoding
    KM_U8 = encoding.UTF8
    KM_JSON = json
    KM_EFFIL = effil
    KladManager.Encoding = encoding
    KladManager.u8 = encoding.UTF8
    KladManager.Json = json
    KladManager.Effil = effil
    KladManager.ImGui = imgui
    KladManager.ffi = ffi
    KladManager.fa = fa
    KladManager.SampEvents = sampev
    return true
end

