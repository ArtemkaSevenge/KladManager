function KladManager.U8(value)
    return KladManager.u8(tostring(value or ""))
end

function KladManager.ToUtf8Data(value)
    if type(value) == "string" then
        return KladManager.u8(value)
    elseif type(value) == "table" then
        local result = {}
        for key, item in pairs(value) do
            result[key] = KladManager.ToUtf8Data(item)
        end
        return result
    end
    return value
end

function KladManager.FromUtf8Data(value)
    if type(value) == "string" then
        return KladManager.u8:decode(value)
    elseif type(value) == "table" then
        local result = {}
        for key, item in pairs(value) do
            result[key] = KladManager.FromUtf8Data(item)
        end
        return result
    end
    return value
end

function KladManager.IsFinite(value)
    local number = tonumber(value)
    return number ~= nil and number == number and number > -math.huge and number < math.huge
end

function KladManager.Distance3D(left, right)
    if type(left) ~= "table" or type(right) ~= "table" then
        return math.huge
    end
    local left_x = tonumber(left.x)
    local left_y = tonumber(left.y)
    local left_z = tonumber(left.z)
    local right_x = tonumber(right.x)
    local right_y = tonumber(right.y)
    local right_z = tonumber(right.z)
    if not left_x or not left_y or not left_z
        or not right_x or not right_y or not right_z then
        return math.huge
    end
    local dx = left_x - right_x
    local dy = left_y - right_y
    local dz = left_z - right_z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

function KladManager.ValidPosition(position)
    return type(position) == "table"
        and KladManager.IsFinite(position.x)
        and KladManager.IsFinite(position.y)
        and KladManager.IsFinite(position.z)
        and math.abs(tonumber(position.x)) <= 6000
        and math.abs(tonumber(position.y)) <= 6000
        and tonumber(position.z) >= -1000
        and tonumber(position.z) <= 3000
end

function KladManager.AtomicJsonWrite(path, value)
    local encoded_ok, encoded = pcall(
        KladManager.Json.encode,
        KladManager.ToUtf8Data(value)
    )
    if not encoded_ok or type(encoded) ~= "string" then
        KladManager.Diagnostics.last_error = "JSON encode: " .. tostring(encoded)
        return false
    end
    local temporary = path .. ".tmp"
    local backup = path .. ".bak"
    KM_SAFE_REMOVE(temporary)
    if not KM_WRITE(temporary, encoded) then
        return false
    end
    local check_payload = KM_READ(temporary)
    local check_ok = check_payload and pcall(KladManager.Json.decode, check_payload)
    if not check_ok then
        KM_SAFE_REMOVE(temporary)
        return false
    end
    KM_SAFE_REMOVE(backup)
    local had_target = KM_FILE_EXISTS(path)
    if had_target and not os.rename(path, backup) then
        KM_SAFE_REMOVE(temporary)
        return false
    end
    if not os.rename(temporary, path) then
        if had_target then
            os.rename(backup, path)
        end
        KM_SAFE_REMOVE(temporary)
        return false
    end
    KM_SAFE_REMOVE(backup)
    return true
end

function KladManager.LoadJsonStore(path, fallback)
    local payload = KM_READ(path)
    if not payload then
        return KladManager.CopyTable(fallback)
    end
    local ok, decoded = pcall(KladManager.Json.decode, payload)
    if not ok or type(decoded) ~= "table" then
        local backup_payload = KM_READ(path .. ".bak")
        if backup_payload then
            local backup_ok, backup = pcall(KladManager.Json.decode, backup_payload)
            if backup_ok and type(backup) == "table" then
                return KladManager.FromUtf8Data(backup)
            end
        end
        KladManager.Diagnostics.last_error = "Повреждено локальное хранилище"
        return KladManager.CopyTable(fallback)
    end
    return KladManager.FromUtf8Data(decoded)
end

function KladManager.SaveDopkas()
    return KladManager.AtomicJsonWrite(
        KladManager.GameplayPaths.dopkas,
        {schema_version=1,items=KladManager.Dopkas}
    )
end

function KladManager.SaveSpawns()
    return KladManager.AtomicJsonWrite(
        KladManager.GameplayPaths.spawns,
        {schema_version=1,servers=KladManager.SpawnServers}
    )
end

function KladManager.SaveZones()
    return KladManager.AtomicJsonWrite(
        KladManager.GameplayPaths.zones,
        {schema_version=1,items=KladManager.Zones}
    )
end

function KladManager.SaveClusterCache()
    return KladManager.AtomicJsonWrite(
        KladManager.GameplayPaths.clusters,
        {
            schema_version=1,
            revision=KladManager.Gameplay.cluster_revision,
            items=KladManager.ServerClusters
        }
    )
end

function KladManager.TrimLootLogs()
    while #KladManager.Loot.logs > 2000 do
        table.remove(KladManager.Loot.logs)
    end
end

function KladManager.SaveLootStore()
    KladManager.TrimLootLogs()
    return KladManager.AtomicJsonWrite(
        KladManager.GameplayPaths.loot,
        {
            schema_version=1,
            sequence=KladManager.Loot.sequence,
            cursor=KladManager.Loot.cursor,
            logs=KladManager.Loot.logs
        }
    )
end

function KladManager.SavePriceCache()
    return KladManager.AtomicJsonWrite(
        KladManager.GameplayPaths.prices,
        {
            schema_version=1,
            received_at=os.time(),
            summary=KladManager.Loot.summary,
            achievements=KladManager.Loot.achievements,
            rating_history=KladManager.Loot.rating_history
        }
    )
end

function KladManager.MergeLootLogs(items)
    local by_id = {}
    for _, item in ipairs(KladManager.Loot.logs) do
        if type(item) == "table" and item.event_id then
            by_id[tostring(item.event_id)] = item
        end
    end
    for _, item in ipairs(type(items) == "table" and items or {}) do
        if type(item) == "table" and item.event_id then
            local key = tostring(item.event_id)
            if by_id[key] then
                for field, value in pairs(item) do
                    by_id[key][field] = value
                end
                if item.cursor_key then
                    by_id[key].upload_event = nil
                end
            else
                KladManager.Loot.logs[#KladManager.Loot.logs + 1] = item
                by_id[key] = item
            end
        end
    end
    table.sort(KladManager.Loot.logs, function(left, right)
        return tostring(left.occurred_at or "") > tostring(right.occurred_at or "")
    end)
    KladManager.TrimLootLogs()
end

function KladManager.LoadGameplayStores()
    local dopkas = KladManager.LoadJsonStore(
        KladManager.GameplayPaths.dopkas,
        {schema_version=1,items={}}
    )
    local spawns = KladManager.LoadJsonStore(
        KladManager.GameplayPaths.spawns,
        {schema_version=1,servers={}}
    )
    local zones = KladManager.LoadJsonStore(
        KladManager.GameplayPaths.zones,
        {schema_version=1,items={}}
    )
    local clusters = KladManager.LoadJsonStore(
        KladManager.GameplayPaths.clusters,
        {schema_version=1,revision=0,items={}}
    )
    local loot = KladManager.LoadJsonStore(
        KladManager.GameplayPaths.loot,
        {schema_version=1,sequence=0,cursor="",logs={}}
    )
    local prices = KladManager.LoadJsonStore(
        KladManager.GameplayPaths.prices,
        {schema_version=1,summary=nil,achievements={},rating_history={}}
    )
    KladManager.Dopkas = type(dopkas.items) == "table" and dopkas.items or {}
    KladManager.SpawnServers = type(spawns.servers) == "table" and spawns.servers or {}
    KladManager.Zones = type(zones.items) == "table" and zones.items or {}
    KladManager.ServerClusters = type(clusters.items) == "table" and clusters.items or {}
    KladManager.Gameplay.cluster_revision = tonumber(clusters.revision) or 0
    KladManager.Loot.sequence = tonumber(loot.sequence) or 0
    KladManager.Loot.cursor = tostring(loot.cursor or "")
    KladManager.Loot.logs = type(loot.logs) == "table" and loot.logs or {}
    KladManager.Loot.summary = type(prices.summary) == "table" and prices.summary or nil
    KladManager.Loot.achievements =
        type(prices.achievements) == "table" and prices.achievements or {}
    KladManager.Loot.rating_history =
        type(prices.rating_history) == "table" and prices.rating_history or {}
    KladManager.TrimLootLogs()
end

function KladManager.CreateGameBuffers()
    local ffi = KladManager.ffi
    KladManager.GameBuffers.dopka_x = ffi.new("char[32]")
    KladManager.GameBuffers.dopka_y = ffi.new("char[32]")
    KladManager.GameBuffers.dopka_z = ffi.new("char[32]")
    KladManager.GameBuffers.spawn_name = ffi.new("char[160]")
    KladManager.GameBuffers.zone_left = ffi.new("char[32]")
    KladManager.GameBuffers.zone_up = ffi.new("char[32]")
    KladManager.GameBuffers.zone_right = ffi.new("char[32]")
    KladManager.GameBuffers.zone_down = ffi.new("char[32]")
    KladManager.BufferSet(KladManager.GameBuffers.dopka_x, 32, "")
    KladManager.BufferSet(KladManager.GameBuffers.dopka_y, 32, "")
    KladManager.BufferSet(KladManager.GameBuffers.dopka_z, 32, "")
    KladManager.BufferSet(KladManager.GameBuffers.spawn_name, 160, "")
    KladManager.BufferSet(KladManager.GameBuffers.zone_left, 32, "")
    KladManager.BufferSet(KladManager.GameBuffers.zone_up, 32, "")
    KladManager.BufferSet(KladManager.GameBuffers.zone_right, 32, "")
    KladManager.BufferSet(KladManager.GameBuffers.zone_down, 32, "")
end

function KladManager.IsoTime(timestamp)
    return os.date("!%Y-%m-%dT%H:%M:%SZ", tonumber(timestamp) or os.time())
end

function KladManager.ServerContext()
    local host = ""
    local port = 0
    if sampGetCurrentServerAddress then
        local ok, address, server_port = pcall(sampGetCurrentServerAddress)
        if ok then
            host = tostring(address or "")
            port = tonumber(server_port) or 0
        end
    end
    local key = host ~= "" and port > 0 and (host .. ":" .. tostring(port)) or "offline"
    return {host=host,port=port,key=key}
end

function KladManager.PlayerContext()
    local player_id = nil
    local world = 0
    local interior = 0
    if sampGetPlayerIdByCharHandle then
        local found, id = sampGetPlayerIdByCharHandle(PLAYER_PED)
        if found then
            player_id = id
            if sampGetPlayerVirtualWorld then
                local world_ok, player_world = pcall(sampGetPlayerVirtualWorld, id)
                if world_ok then
                    world = tonumber(player_world) or 0
                end
            end
        end
    end
    if getActiveInterior then
        local interior_ok, active = pcall(getActiveInterior)
        if interior_ok then
            interior = tonumber(active) or 0
        end
    end
    return {player_id=player_id,world=world,interior=interior}
end

function KladManager.CurrentPosition()
    if not doesCharExist or not doesCharExist(PLAYER_PED) then
        return nil
    end
    local x, y, z = getCharCoordinates(PLAYER_PED)
    local position = {x=tonumber(x),y=tonumber(y),z=tonumber(z)}
    return KladManager.ValidPosition(position) and position or nil
end

function KladManager.NextMinuteTwenty(timestamp)
    local current = os.date("*t", timestamp or os.time())
    current.sec = 0
    current.min = 20
    current.hour = current.hour + 1
    return os.time(current)
end

function KladManager.CleanupExpiredDopkas(now)
    local current = tonumber(now) or os.time()
    local changed = false
    for index = #KladManager.Dopkas, 1, -1 do
        local item = KladManager.Dopkas[index]
        if not item.dug and tonumber(item.cleanup_at or 0) > 0
            and tonumber(item.cleanup_at) <= current then
            table.remove(KladManager.Dopkas, index)
            changed = true
        end
    end
    if changed then
        KladManager.SaveDopkas()
        KladManager.Notify(
            "info",
            "Допки",
            "Просроченные личные метки очищены.",
            4.0
        )
    end
    return changed
end

function KladManager.MemoryMapIconSnapshot()
    local snapshot = {}
    if not readMemory or not representIntAsFloat then
        return snapshot
    end
    for icon_id = 0, 31 do
        local address = 0xC7DD88 + icon_id * 160
        local ok, x, y, z = pcall(function()
            return representIntAsFloat(readMemory(address, 4, false)),
                representIntAsFloat(readMemory(address + 4, 4, false)),
                representIntAsFloat(readMemory(address + 8, 4, false))
        end)
        local position = {x=tonumber(x),y=tonumber(y),z=tonumber(z)}
        if ok and KladManager.ValidPosition(position)
            and (position.x ~= 0 or position.y ~= 0 or position.z ~= 0) then
            snapshot[tostring(icon_id)] = position
        end
    end
    return snapshot
end

function KladManager.MapIconSnapshot()
    local snapshot = KladManager.MemoryMapIconSnapshot()
    for icon_id, icon in pairs(KladManager.Gameplay.map_icons) do
        if type(icon) == "table" and KladManager.ValidPosition(icon.position) then
            snapshot[tostring(icon_id)] = {
                x=icon.position.x,
                y=icon.position.y,
                z=icon.position.z
            }
        end
    end
    return snapshot
end

function KladManager.IconChanged(before, position)
    if type(before) ~= "table" then
        return true
    end
    return KladManager.Distance3D(before, position) > 0.05
end

function KladManager.ArmDopkaExpectation()
    if KladManager.Gameplay.map_expectation
        and KladManager.Gameplay.map_expectation.active then
        return false
    end
    KladManager.Gameplay.map_expectation = {
        active=true,
        started_at=getGameTimer(),
        deadline=getGameTimer() + 4000,
        snapshot=KladManager.MapIconSnapshot(),
        candidates={},
        first_candidate_at=nil
    }
    return true
end

function KladManager.OnSetMapIcon(icon_id, position, icon_type, color, style)
    local normalized = {
        x=tonumber(position and (position.x or position[1])),
        y=tonumber(position and (position.y or position[2])),
        z=tonumber(position and (position.z or position[3]))
    }
    if not KladManager.ValidPosition(normalized) then
        return
    end
    local event = {
        id=tonumber(icon_id),
        position=normalized,
        icon_type=tonumber(icon_type) or 0,
        color=tonumber(color) or 0,
        style=tonumber(style) or 0,
        received_at=getGameTimer()
    }
    KladManager.Gameplay.map_icons[tostring(icon_id)] = event
    local dopka = KladManager.Gameplay.map_expectation
    if dopka and dopka.active and event.received_at >= dopka.started_at
        and event.received_at <= dopka.deadline then
        local before = dopka.snapshot[tostring(icon_id)]
        if KladManager.IconChanged(before, normalized) then
            dopka.candidates[#dopka.candidates + 1] = event
            dopka.first_candidate_at = dopka.first_candidate_at or event.received_at
        end
    end
    local spawn = KladManager.Gameplay.spawn_expectation
    if spawn and spawn.active and event.received_at >= spawn.started_at
        and event.received_at <= spawn.deadline
        and not (dopka and dopka.active) then
        local before = spawn.snapshot[tostring(icon_id)]
        if KladManager.IconChanged(before, normalized) then
            spawn.candidates[#spawn.candidates + 1] = event
            spawn.first_candidate_at = spawn.first_candidate_at or event.received_at
        end
    end
end

function KladManager.OnRemoveMapIcon(icon_id)
    KladManager.Gameplay.map_icons[tostring(icon_id)] = nil
end

function KladManager.MemoryExpectationDelta(expectation)
    local current = KladManager.MemoryMapIconSnapshot()
    local candidates = {}
    for icon_id, position in pairs(current) do
        if KladManager.IconChanged(expectation.snapshot[icon_id], position) then
            candidates[#candidates + 1] = {
                id=tonumber(icon_id),
                position=position,
                icon_type=0,
                color=0,
                style=0,
                received_at=getGameTimer()
            }
        end
    end
    if #candidates == 1 then
        return candidates[1]
    end
    return nil
end

function KladManager.FindDopkaDuplicate(position)
    local server = KladManager.ServerContext()
    local player = KladManager.PlayerContext()
    for index, item in ipairs(KladManager.Dopkas) do
        local item_server = type(item.server) == "table" and item.server.key or nil
        if (not item_server or item_server == server.key)
            and tonumber(item.world or 0) == tonumber(player.world or 0)
            and tonumber(item.interior or 0) == tonumber(player.interior or 0)
            and KladManager.Distance3D(item.position, position) <= 1.0 then
            return index, item
        end
    end
    return nil, nil
end

function KladManager.SaveDopkaPosition(position, source, icon)
    if not KladManager.ValidPosition(position) then
        return nil
    end
    local duplicate_index = KladManager.FindDopkaDuplicate(position)
    if duplicate_index then
        KladManager.Notify("info", "Допки", "Эта метка уже сохранена.", 3.5)
        return nil
    end
    local server = KladManager.ServerContext()
    local player = KladManager.PlayerContext()
    local now = os.time()
    local item = {
        id=KladManager.RandomToken(),
        event_id="dopka:" .. KladManager.RandomToken(),
        position={x=position.x,y=position.y,z=position.z},
        source=source,
        confidence=source == "onSetMapIcon" and 1.0 or 0.85,
        icon_id=icon and icon.id or nil,
        icon_type=icon and icon.icon_type or nil,
        icon_color=icon and icon.color or nil,
        icon_style=icon and icon.style or nil,
        server=server,
        world=player.world,
        interior=player.interior,
        created_at=now,
        cleanup_at=KladManager.NextMinuteTwenty(now),
        dug=false,
        sync_status="pending"
    }
    table.insert(KladManager.Dopkas, 1, item)
    if not KladManager.SaveDopkas() then
        table.remove(KladManager.Dopkas, 1)
        KladManager.Notify("error", "Допки", "Не удалось сохранить метку.", 5.0)
        return nil
    end
    KladManager.Notify("success", "Допки", "Допка сохранена.", 4.0)
    KladManager.SubmitCoordinateObservation(item, "dopka")
    return item
end

function KladManager.FinalizeDopkaExpectation(event, source)
    local expectation = KladManager.Gameplay.map_expectation
    if not expectation or not expectation.active then
        return false
    end
    expectation.active = false
    KladManager.Gameplay.map_expectation = nil
    if not event or not KladManager.ValidPosition(event.position) then
        KladManager.Notify(
            "warning",
            "Допки",
            "Новая игровая метка не найдена.",
            4.5
        )
        return false
    end
    return KladManager.SaveDopkaPosition(event.position, source, event) ~= nil
end

function KladManager.AddManualDopka(position)
    if not KladManager.ValidPosition(position) then
        KladManager.Notify("error", "Допки", "Проверьте координаты.", 4.0)
        return false
    end
    local server = KladManager.ServerContext()
    local player = KladManager.PlayerContext()
    local now = os.time()
    local duplicate_index = KladManager.FindDopkaDuplicate(position)
    if duplicate_index then
        KladManager.Notify("info", "Допки", "Эта метка уже сохранена.", 3.5)
        return false
    end
    table.insert(KladManager.Dopkas, 1, {
        id=KladManager.RandomToken(),
        event_id=nil,
        position={x=position.x,y=position.y,z=position.z},
        source="manual",
        confidence=0.0,
        server=server,
        world=player.world,
        interior=player.interior,
        created_at=now,
        cleanup_at=KladManager.NextMinuteTwenty(now),
        dug=false,
        sync_status="local_only"
    })
    if not KladManager.SaveDopkas() then
        table.remove(KladManager.Dopkas, 1)
        return false
    end
    KladManager.Notify("success", "Допки", "Локальная метка добавлена.", 4.0)
    return true
end

function KladManager.UpdateDopka(index, position)
    local item = KladManager.Dopkas[index]
    if not item or not KladManager.ValidPosition(position) then
        return false
    end
    item.position = {x=position.x,y=position.y,z=position.z}
    item.edited_at = os.time()
    item.source = "manual"
    item.sync_status = "local_only"
    return KladManager.SaveDopkas()
end

function KladManager.DeleteDopka(index)
    if not KladManager.Dopkas[index] then
        return false
    end
    table.remove(KladManager.Dopkas, index)
    KladManager.Gameplay.selected_dopka = nil
    if KladManager.SaveDopkas() then
        KladManager.Notify(
            "info",
            "Допки",
            "Локальная метка удалена. Серверное доказательство сохранено.",
            5.0
        )
        return true
    end
    return false
end

function KladManager.NormalizeGameText(value)
    local text = tostring(value or "")
    text = text:gsub("{[%x]+}", "")
    text = text:gsub("~[%w_]+~", "")
    text = text:gsub("^%s*%d+[%.)%-:]%s*", "")
    text = text:gsub("%s+", " ")
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    return text
end

function KladManager.NormalizeSpawnRow(value)
    local text = KladManager.NormalizeGameText(value)
    local lowered = text:lower()
    lowered = lowered:gsub("ё", "е")
    return lowered
end

function KladManager.SpawnType(row)
    local normalized = KladManager.NormalizeSpawnRow(row)
    if normalized:find("трейлер", 1, true) then
        return "trailer"
    elseif normalized:find("семейн", 1, true)
        or normalized:find("квартира семьи", 1, true) then
        return "family"
    elseif normalized:find("организац", 1, true) then
        return "organization"
    elseif normalized:find("дом", 1, true)
        or normalized:find("квартира", 1, true) then
        return "home"
    end
    return "custom"
end

function KladManager.SpawnEntityId(row)
    local normalized = KladManager.NormalizeSpawnRow(row)
    local value = normalized:match("№%s*(%d+)")
        or normalized:match("#%s*(%d+)")
        or normalized:match("id%s*[:№]?%s*(%d+)")
    return tonumber(value)
end

function KladManager.SpawnRows(text)
    local rows = {}
    for line in tostring(text or ""):gmatch("[^\r\n]+") do
        local display = KladManager.NormalizeGameText(line)
        local normalized = KladManager.NormalizeSpawnRow(line)
        if display ~= "" and normalized ~= ""
            and not normalized:find("последнее место выхода", 1, true) then
            rows[#rows + 1] = {
                display=display,
                normalized=normalized,
                spawn_type=KladManager.SpawnType(display),
                entity_id=KladManager.SpawnEntityId(display)
            }
        end
    end
    return rows
end

function KladManager.SpawnRowsSignature(rows)
    local values = {}
    for _, row in ipairs(rows or {}) do
        values[#values + 1] = tostring(row.normalized)
    end
    return table.concat(values, "\31")
end

function KladManager.IsSpawnDialog(title, text)
    local normalized = KladManager.NormalizeSpawnRow(title .. " " .. text)
    return normalized:find("место появления", 1, true) ~= nil
        or normalized:find("выбор спавна", 1, true) ~= nil
        or normalized:find("точка появления", 1, true) ~= nil
end

function KladManager.SwitchSpawnServer(notify)
    local server = KladManager.ServerContext()
    local previous = KladManager.Gameplay.last_server
    KladManager.Gameplay.last_server = server.key
    KladManager.SpawnServers[server.key] = KladManager.SpawnServers[server.key]
        or {server=server,revision=0,items={}}
    KladManager.ActiveSpawns = KladManager.SpawnServers[server.key].items
    if notify and previous ~= "" and previous ~= server.key
        and KladManager.Settings.map.spawn_server_auto_switch then
        KladManager.Notify(
            "info",
            "Спавны",
            "Список переключён для сервера " .. server.key .. ".",
            4.0
        )
    end
end

function KladManager.ReconcileSpawnRows(rows)
    local server = KladManager.ServerContext()
    KladManager.SpawnServers[server.key] = KladManager.SpawnServers[server.key]
        or {server=server,revision=0,items={}}
    local store = KladManager.SpawnServers[server.key]
    local by_name = {}
    for _, item in ipairs(store.items) do
        if item.spawn_type == "custom" and item.source == "manual" then
            item.missing = false
        else
            item.missing = true
            by_name[item.normalized] = item
        end
    end
    for order, row in ipairs(rows) do
        local item = by_name[row.normalized]
        if item then
            item.display = row.display
            item.spawn_type = row.spawn_type
            item.entity_id = row.entity_id
            item.order = order
            item.missing = false
            item.last_seen_at = os.time()
        else
            table.insert(store.items, {
                id=KladManager.RandomToken(),
                display=row.display,
                normalized=row.normalized,
                spawn_type=row.spawn_type,
                entity_id=row.entity_id,
                order=order,
                position=nil,
                source="dialog",
                missing=false,
                created_at=os.time(),
                last_seen_at=os.time()
            })
        end
    end
    table.sort(store.items, function(left, right)
        return tonumber(left.order or 9999) < tonumber(right.order or 9999)
    end)
    store.revision = tonumber(store.revision or 0) + 1
    store.rows_signature = KladManager.SpawnRowsSignature(rows)
    store.updated_at = os.time()
    KladManager.ActiveSpawns = store.items
    KladManager.SaveSpawns()
end

function KladManager.FindSpawnById(spawn_id)
    for index, item in ipairs(KladManager.ActiveSpawns) do
        if tostring(item.id) == tostring(spawn_id) then
            return index, item
        end
    end
    return nil, nil
end

function KladManager.SaveManualSpawn(name)
    local display = KladManager.NormalizeGameText(name)
    local position = KladManager.CurrentPosition()
    if display == "" or not position then
        KladManager.Notify("error", "Спавны", "Укажите название и зайдите в игру.", 4.0)
        return false
    end
    local server = KladManager.ServerContext()
    local player = KladManager.PlayerContext()
    KladManager.SpawnServers[server.key] = KladManager.SpawnServers[server.key]
        or {server=server,revision=0,items={}}
    local store = KladManager.SpawnServers[server.key]
    table.insert(store.items, 1, {
        id=KladManager.RandomToken(),
        display=display,
        normalized=KladManager.NormalizeSpawnRow(display),
        spawn_type="custom",
        entity_id=nil,
        order=0,
        position=position,
        world=player.world,
        interior=player.interior,
        source="manual",
        missing=false,
        created_at=os.time(),
        last_seen_at=os.time()
    })
    store.revision = tonumber(store.revision or 0) + 1
    KladManager.ActiveSpawns = store.items
    if KladManager.SaveSpawns() then
        KladManager.Notify("success", "Спавны", "Точка сохранена локально.", 4.0)
        return true
    end
    table.remove(store.items, 1)
    return false
end

function KladManager.SaveSpawnCurrent(spawn_id)
    local _, item = KladManager.FindSpawnById(spawn_id)
    local position = KladManager.CurrentPosition()
    if not item or not position then
        return false
    end
    if item.spawn_type == "home" or item.spawn_type == "trailer" then
        KladManager.Notify(
            "warning",
            "Спавны",
            "Для дома или трейлера используйте автоматический поиск.",
            4.0
        )
        return false
    end
    item.position = position
    local player = KladManager.PlayerContext()
    item.world = player.world
    item.interior = player.interior
    item.source = "manual"
    item.located_at = os.time()
    item.missing = false
    if KladManager.SaveSpawns() then
        KladManager.Notify("success", "Спавны", "Координаты сохранены локально.", 4.0)
        return true
    end
    return false
end

function KladManager.DeleteSpawn(index)
    if not KladManager.ActiveSpawns[index] then
        return false
    end
    table.remove(KladManager.ActiveSpawns, index)
    KladManager.Gameplay.selected_spawn = nil
    KladManager.SaveSpawns()
    return true
end

function KladManager.StartSpawnDiscovery()
    if KladManager.Gameplay.discovery.active then
        return false
    end
    local queue = {}
    for _, item in ipairs(KladManager.ActiveSpawns) do
        if not item.missing and item.entity_id
            and (item.spawn_type == "home" or item.spawn_type == "trailer") then
            queue[#queue + 1] = item.id
        end
    end
    if #queue == 0 then
        KladManager.Notify(
            "info",
            "Спавны",
            "В диалоге нет домов или трейлеров с ID.",
            4.0
        )
        return false
    end
    KladManager.Gameplay.discovery = {
        active=true,
        queue=queue,
        index=0,
        total=#queue,
        started_at=getGameTimer(),
        next_at=getGameTimer(),
        cancelled=false
    }
    KladManager.Notify("info", "Спавны", "Поиск координат запущен.", 4.0)
    return true
end

function KladManager.CancelSpawnDiscovery()
    KladManager.Gameplay.discovery.cancelled = true
    KladManager.Gameplay.discovery.active = false
    KladManager.Gameplay.spawn_expectation = nil
    KladManager.Notify("warning", "Спавны", "Поиск координат отменён.", 3.5)
end

function KladManager.StartNextSpawnDiscovery()
    local discovery = KladManager.Gameplay.discovery
    if not discovery.active or discovery.cancelled then
        return
    end
    if KladManager.Gameplay.map_expectation
        and KladManager.Gameplay.map_expectation.active then
        discovery.next_at = getGameTimer() + 500
        return
    end
    discovery.index = discovery.index + 1
    if discovery.index > discovery.total then
        discovery.active = false
        KladManager.Gameplay.spawn_expectation = nil
        KladManager.SaveSpawns()
        KladManager.Notify("success", "Спавны", "Поиск координат завершён.", 4.0)
        return
    end
    local _, item = KladManager.FindSpawnById(discovery.queue[discovery.index])
    if not item or not item.entity_id then
        discovery.next_at = getGameTimer()
        return
    end
    local command = item.spawn_type == "trailer" and "/finditrailer " or "/findihouse "
    KladManager.Gameplay.spawn_expectation = {
        active=true,
        spawn_id=item.id,
        started_at=getGameTimer(),
        deadline=getGameTimer() + 3000,
        snapshot=KladManager.MapIconSnapshot(),
        candidates={},
        first_candidate_at=nil
    }
    sampSendChat(command .. tostring(item.entity_id))
end

function KladManager.FinalizeSpawnExpectation(event)
    local expectation = KladManager.Gameplay.spawn_expectation
    if not expectation or not expectation.active then
        return false
    end
    expectation.active = false
    KladManager.Gameplay.spawn_expectation = nil
    local _, item = KladManager.FindSpawnById(expectation.spawn_id)
    if item and event and KladManager.ValidPosition(event.position) then
        item.position = {
            x=event.position.x,
            y=event.position.y,
            z=event.position.z
        }
        item.source = "find_command"
        local player = KladManager.PlayerContext()
        item.world = player.world
        item.interior = player.interior
        item.located_at = os.time()
        item.missing = false
        KladManager.SaveSpawns()
    elseif item then
        item.locate_error = "timeout"
    end
    local discovery = KladManager.Gameplay.discovery
    if discovery.active then
        discovery.next_at = getGameTimer() + 3000
    end
    return event ~= nil
end

function KladManager.ActivateSpawn(spawn_id)
    if KladManager.Gameplay.rec_expectation then
        KladManager.Notify("warning", "Спавны", "Предыдущий выбор ещё выполняется.", 4.0)
        return false
    end
    local _, item = KladManager.FindSpawnById(spawn_id)
    if not item or item.missing then
        KladManager.Notify("error", "Спавны", "Эта точка пропала из диалога.", 4.0)
        return false
    end
    if item.spawn_type == "custom" then
        if KladManager.ValidPosition(item.position) then
            return KladManager.SetMapWaypoint(
                item.position.x,
                item.position.y,
                item.position.z
            )
        end
        KladManager.Notify("error", "Спавны", "У точки нет координат.", 4.0)
        return false
    end
    local server = KladManager.ServerContext()
    local store = KladManager.SpawnServers[server.key]
    KladManager.Gameplay.rec_expectation = {
        spawn_id=item.id,
        normalized=item.normalized,
        rows_signature=store and store.rows_signature or "",
        started_at=getGameTimer(),
        deadline=getGameTimer() + 5000
    }
    sampSendChat("/rec")
    return true
end

function KladManager.HandleRecDialog(dialog_id, rows)
    local expectation = KladManager.Gameplay.rec_expectation
    if not expectation then
        return false
    end
    if getGameTimer() > expectation.deadline then
        KladManager.Gameplay.rec_expectation = nil
        return false
    end
    local signature = KladManager.SpawnRowsSignature(rows)
    if expectation.rows_signature ~= "" and signature ~= expectation.rows_signature then
        KladManager.Gameplay.rec_expectation = nil
        KladManager.Notify(
            "error",
            "Спавны",
            "Список изменился. Выберите точку ещё раз.",
            5.0
        )
        return false
    end
    local match_index = nil
    local matches = 0
    for index, row in ipairs(rows) do
        if row.normalized == expectation.normalized then
            match_index = index - 1
            matches = matches + 1
        end
    end
    if matches ~= 1 or match_index == nil then
        KladManager.Gameplay.rec_expectation = nil
        KladManager.Notify("error", "Спавны", "Точный пункт не найден.", 4.0)
        return false
    end
    sampSendDialogResponse(dialog_id, 1, match_index, "")
    KladManager.Gameplay.rec_expectation = nil
    KladManager.Notify("success", "Спавны", "Точка выбрана.", 3.5)
    return true
end

function KladManager.OnShowDialog(dialog_id, style, title, button1, button2, text)
    if not KladManager.IsSpawnDialog(title, text) then
        return
    end
    local rows = KladManager.SpawnRows(text)
    if #rows == 0 then
        return
    end
    if KladManager.Gameplay.rec_expectation then
        KladManager.HandleRecDialog(dialog_id, rows)
        return
    end
    KladManager.ReconcileSpawnRows(rows)
end

function KladManager.ZoneIntersection(count)
    local amount = math.min(tonumber(count) or 2, #KladManager.Zones)
    if amount < 2 then
        return nil
    end
    local left = -math.huge
    local right = math.huge
    local up = math.huge
    local down = -math.huge
    for index = 1, amount do
        local zone = KladManager.Zones[index]
        left = math.max(left, math.min(zone.left, zone.right))
        right = math.min(right, math.max(zone.left, zone.right))
        down = math.max(down, math.min(zone.down, zone.up))
        up = math.min(up, math.max(zone.down, zone.up))
    end
    if left >= right or down >= up then
        return nil
    end
    return {left=left,right=right,up=up,down=down}
end

function KladManager.EmulateGangZoneAdd(zone_id, zone, color)
    if not raknetNewBitStream then
        return false
    end
    local stream = raknetNewBitStream()
    raknetBitStreamWriteInt16(stream, zone_id)
    raknetBitStreamWriteFloat(stream, zone.left)
    raknetBitStreamWriteFloat(stream, zone.up)
    raknetBitStreamWriteFloat(stream, zone.right)
    raknetBitStreamWriteFloat(stream, zone.down)
    raknetBitStreamWriteInt32(stream, color)
    raknetEmulRpcReceiveBitStream(108, stream)
    raknetDeleteBitStream(stream)
    return true
end

function KladManager.EmulateGangZoneRemove(zone_id)
    if not raknetNewBitStream then
        return false
    end
    local stream = raknetNewBitStream()
    raknetBitStreamWriteInt16(stream, zone_id)
    raknetEmulRpcReceiveBitStream(120, stream)
    raknetDeleteBitStream(stream)
    return true
end

function KladManager.IsTreasureZoneColor(color)
    return KM_BIT.tohex(tonumber(color) or 0, 8):lower() == "ff0000ff"
end

function KladManager.AddZone(zone)
    if type(zone) ~= "table" then
        return false
    end
    zone.id = zone.id or KladManager.RandomToken()
    zone.created_at = zone.created_at or os.time()
    zone.server = zone.server or KladManager.ServerContext()
    table.insert(KladManager.Zones, 1, zone)
    while #KladManager.Zones > KladManager.Settings.map.zone_count do
        table.remove(KladManager.Zones)
    end
    if KladManager.Settings.map.auto_intersection then
        KladManager.Gameplay.zone_intersection = KladManager.ZoneIntersection(
            KladManager.Settings.map.intersection_count
        )
    end
    return KladManager.SaveZones()
end

function KladManager.RestoreZone(index)
    local zone = KladManager.Zones[index]
    if not zone then
        return false
    end
    KladManager.EmulateGangZoneRemove(610)
    return KladManager.EmulateGangZoneAdd(610, zone, -2130706433)
end

function KladManager.DeleteZone(index)
    if not KladManager.Zones[index] then
        return false
    end
    table.remove(KladManager.Zones, index)
    KladManager.Gameplay.selected_zone = nil
    KladManager.Gameplay.zone_intersection = KladManager.ZoneIntersection(
        KladManager.Settings.map.intersection_count
    )
    return KladManager.SaveZones()
end

function KladManager.OnCreateGangZone(zone_id, square_start, square_end, color)
    local zone = {
        zone_id=tonumber(zone_id),
        left=tonumber(square_start and (square_start.x or square_start[1])),
        up=tonumber(square_start and (square_start.y or square_start[2])),
        right=tonumber(square_end and (square_end.x or square_end[1])),
        down=tonumber(square_end and (square_end.y or square_end[2])),
        color=tonumber(color)
    }
    if not KladManager.IsFinite(zone.left) or not KladManager.IsFinite(zone.up)
        or not KladManager.IsFinite(zone.right) or not KladManager.IsFinite(zone.down) then
        return
    end
    if KladManager.IsTreasureZoneColor(color) then
        KladManager.WhiteZone = zone
        KladManager.AddZone(zone)
    elseif KladManager.Settings.map.remove_game_zones then
        lua_thread.create(function()
            wait(0)
            KladManager.EmulateGangZoneRemove(zone_id)
        end)
    end
end

function KladManager.OnGangZoneDestroy(zone_id)
    if KladManager.WhiteZone and tonumber(KladManager.WhiteZone.zone_id) == tonumber(zone_id)
        and KladManager.Settings.map.restore_white_zone then
        local zone = KladManager.CopyTable(KladManager.WhiteZone)
        lua_thread.create(function()
            wait(0)
            KladManager.EmulateGangZoneRemove(610)
            KladManager.EmulateGangZoneAdd(610, zone, -2130706433)
        end)
    end
end

function KladManager.LocalPlayerId()
    if not sampGetPlayerIdByCharHandle then
        return nil
    end
    local found, player_id = sampGetPlayerIdByCharHandle(PLAYER_PED)
    return found and tonumber(player_id) or nil
end

function KladManager.NormalizeItemName(value)
    local normalized = KladManager.NormalizeGameText(value):lower()
    normalized = normalized:gsub("ё", "е")
    normalized = normalized:gsub("[%p%c]", " ")
    normalized = normalized:gsub("%s+", " ")
    return normalized:gsub("^%s+", ""):gsub("%s+$", "")
end

function KladManager.DetectorIdentity(item_id, item_name)
    local id = tonumber(item_id)
    local name = KladManager.NormalizeItemName(item_name)
    if id == 8671 or name:find("демонический металлоискатель", 1, true) then
        return 8671, "demonic"
    elseif id == 8672 or name:find("космический металлоискатель", 1, true) then
        return 8672, "cosmic"
    end
    return nil, nil
end

function KladManager.UpdateDetectorFromInventory(inventory_type, items, source)
    local type_id = tonumber(inventory_type)
    if type_id ~= 2 and type_id ~= 17 then
        return false
    end
    if type(items) ~= "table" then
        return false
    end
    KladManager.Detector.inventory_types[type_id] =
        KladManager.Detector.inventory_types[type_id] or {}
    KladManager.Detector.inventory_received[type_id] = true
    local target = KladManager.Detector.inventory_types[type_id]
    local item_count = 0
    for _ in pairs(items) do
        item_count = item_count + 1
    end
    local expected_count = type_id == 2 and 6 or 2
    if item_count == 0 or item_count >= expected_count then
        target = {}
        KladManager.Detector.inventory_types[type_id] = target
    end
    for slot, entry in pairs(items) do
        if type(entry) == "table" then
            local cef_slot = tonumber(entry.slot) or tonumber(slot)
            if cef_slot then
                local item_id = tonumber(entry.item or entry.item_id or entry.id)
                if item_id and item_id > 0 then
                    target[cef_slot] = {
                        item_id=item_id,
                        name=tostring(entry.name or entry.title or entry.item_name or ""),
                        count=tonumber(entry.count) or 1
                    }
                else
                    target[cef_slot] = nil
                end
            end
        end
    end
    local found_id = nil
    local found_type = nil
    local normalized_inventory = {}
    for stored_type, stored_items in pairs(KladManager.Detector.inventory_types) do
        for slot, entry in pairs(stored_items) do
            if type(entry) == "table" then
                local item_id = tonumber(entry.item_id)
                local item_name = entry.name or ""
                normalized_inventory[
                    tostring(stored_type) .. ":" .. tostring(slot)
                ] = {
                    item_id=item_id,
                    name=tostring(item_name),
                    count=tonumber(entry.count) or 1
                }
                local detector_id, detector_type = KladManager.DetectorIdentity(
                    item_id,
                    item_name
                )
                if detector_id then
                    found_id = detector_id
                    found_type = detector_type
                end
            end
        end
    end
    KladManager.Detector.inventory = normalized_inventory
    KladManager.Detector.state = found_id and "present" or "absent"
    KladManager.Detector.item_id = found_id
    KladManager.Detector.detector_type = found_type
    KladManager.Detector.source = source or "cef_inventory"
    KladManager.Detector.observed_at = os.time()
    KladManager.Detector.expires_at = os.time() + 900
    return true
end

function KladManager.CefJsonPayload(text)
    local payload = tostring(text or ""):match(
        "event%.inventory%.playerInventory.-`(.-)`"
    )
    if payload then
        return payload
    end
    local start_position = tostring(text or ""):find("%[%s*{")
    if not start_position then
        return nil
    end
    local end_position = nil
    for index = #text, start_position, -1 do
        if text:sub(index, index) == "]" then
            end_position = index
            break
        end
    end
    return end_position and text:sub(start_position, end_position) or nil
end

function KladManager.LootContains(text, phrase)
    local value = tostring(text or "")
    return value:find(phrase, 1, true) ~= nil
        or value:find(tostring(KladManager.U8(phrase)), 1, true) ~= nil
end

function KladManager.LootMachine(source)
    return source == "chest"
        and KladManager.Loot.machines.chest
        or KladManager.Loot.machines.treasure
end

function KladManager.ResetLootMachine(source)
    KladManager.Loot.machines[source] = {
        state="idle",
        signals={},
        items={},
        started_at=0,
        updated_at=0,
        finalized_at=0
    }
    return KladManager.Loot.machines[source]
end

function KladManager.ParseLootTitle(value, explicit_quantity)
    local text = KladManager.NormalizeGameText(value)
    text = text:gsub("{[%x]+}", " "):gsub("%s+", " ")
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    local count, name = text:match("^(%d+)%s+шт%.?%s+(.+)$")
    if not count then
        name, count = text:match("^(.+)%s+%(%s*(%d+)%s+шт%.?%s*%)$")
    end
    local quantity = tonumber(count) or tonumber(explicit_quantity) or 1
    name = name or text
    local upgrade = tonumber(name:match("%(%s*%+%s*(%d+)%s*%)%s*$"))
    name = name:gsub("%s*%(%s*%+%s*%d+%s*%)%s*$", "")
    return {
        name=name,
        name_norm=KladManager.NormalizeItemName(name),
        quantity=math.max(1, math.floor(quantity)),
        upgrade=upgrade
    }
end

function KladManager.ParseCefLootItems(value)
    local payload = tostring(value or ""):match(
        "event%.mountain%.testDrive%.addVehicles.-`(.-)`"
    )
    if not payload then
        return nil
    end
    local ok, decoded = pcall(KladManager.Json.decode, payload)
    if not ok or type(decoded) ~= "table" then
        return nil
    end
    local rows = decoded
    if type(decoded[1]) == "table" and decoded[1][1] ~= nil then
        rows = decoded[1]
    end
    local items = {}
    for _, item in ipairs(rows) do
        if type(item) == "table" and item.title then
            local parsed = KladManager.ParseLootTitle(
                item.title,
                item.count or item.quantity
            )
            parsed.item_id = tonumber(item.item_id or item.itemId or item.id)
            items[#items + 1] = parsed
        end
    end
    return #items > 0 and items or nil
end

function KladManager.PriceServerKey()
    local name = ""
    if sampGetCurrentServerName then
        local ok, value = pcall(sampGetCurrentServerName)
        if ok then
            name = tostring(value or "")
        end
    end
    name = KladManager.NormalizeGameText(name):lower()
    name = name:gsub("[^%w]+", "-"):gsub("^-+", ""):gsub("-+$", "")
    return name ~= "" and name or KladManager.ServerContext().key
end

function KladManager.LootItemKey(item)
    return tostring(item.item_id or "")
        .. ":" .. tostring(item.name_norm or KladManager.NormalizeItemName(item.name))
        .. ":" .. tostring(item.upgrade or "")
end

function KladManager.LootSignal(source, signal, items, replace_items)
    local machine = KladManager.LootMachine(source)
    local now = getGameTimer()
    if machine.state == "finalized" and now - tonumber(machine.finalized_at or 0) < 5000 then
        return false
    end
    if machine.state == "idle" or machine.state == "expired" or machine.state == "error"
        or machine.state == "finalized" then
        machine = KladManager.ResetLootMachine(source)
        machine.state = "started"
        machine.started_at = now
    end
    machine.updated_at = now
    machine.signals[signal] = true
    if type(items) == "table" and #items > 0 then
        if replace_items then
            machine.items = items
        else
            for _, item in ipairs(items) do
                local key = KladManager.LootItemKey(item)
                local found = nil
                for _, current in ipairs(machine.items) do
                    if KladManager.LootItemKey(current) == key then
                        found = current
                        break
                    end
                end
                if found then
                    found.quantity = math.max(
                        tonumber(found.quantity) or 1,
                        tonumber(item.quantity) or 1
                    )
                else
                    machine.items[#machine.items + 1] = item
                end
            end
        end
        machine.loot_received_at = now
        machine.state = "loot_received"
    end
    local success = source == "chest"
        and machine.signals.cef_window_title == true
        or source == "treasure"
            and (
                machine.signals.chat_lock_success == true
                or machine.signals.cef_items_notification == true
            )
    if success then
        machine.state = "success_confirmed"
    end
    if success and #machine.items == 0 then
        machine.state = "awaiting_loot"
    elseif success and #machine.items > 0 then
        machine.state = "loot_received"
    elseif machine.state ~= "loot_received" then
        machine.state = "started"
    end
    if KladManager.Loot.pending_cef
        and now - tonumber(KladManager.Loot.pending_cef.received_at or 0) <= 5000
        and success and #machine.items == 0 then
        machine.items = KladManager.Loot.pending_cef.items
        machine.loot_received_at = KladManager.Loot.pending_cef.received_at
        machine.signals.cef_loot = true
        machine.state = "loot_received"
        KladManager.Loot.pending_cef = nil
    end
    return true
end

function KladManager.LootFingerprint(source, items)
    local parts = {source}
    for _, item in ipairs(items) do
        parts[#parts + 1] = tostring(item.item_id or "")
            .. ":" .. tostring(item.name_norm or KladManager.NormalizeItemName(item.name))
            .. ":" .. tostring(item.quantity or 1)
    end
    table.sort(parts)
    return KM_SHA256(table.concat(parts, "|"))
end

function KladManager.LootEventId(session_id, sequence, timestamp, source)
    local identity = tostring(session_id) .. ":" .. tostring(sequence)
        .. ":" .. tostring(math.floor(timestamp * 1000)) .. ":" .. tostring(source)
    return "loot:" .. KM_SHA256(identity):sub(1, 40)
end

function KladManager.SubmitLootLog(log)
    if type(log) ~= "table" or type(log.upload_event) ~= "table" then
        return false
    end
    if KladManager.Auth.state ~= "approved" or not KladManager.Auth.session
        or not KladManager.Auth.session.access_token then
        log.sync_status = "pending"
        return false
    end
    if KladManager.Auth.feature_flags.loot_upload == false
        or KladManager.Auth.feature_flags.lua_sync == false then
        log.sync_status = "disabled"
        return false
    end
    if log.sync_status == "sending" or log.sync_status == "accepted"
        or log.sync_status == "duplicate" then
        return false
    end
    log.sync_status = "sending"
    log.last_attempt_at = os.time()
    local request_id = KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/loot-events",
        {
            device_proof=KladManager.DeviceSignals(),
            event=log.upload_event
        },
        {
            authorization=KladManager.Auth.session.access_token,
            idempotency_key=log.event_id,
            timeout_ms=12000
        },
        function(ok, data, error_data)
            if ok then
                log.sync_status = tostring(data.status or "accepted")
                log.fraud_status = tostring(data.fraud_status or "accepted")
                log.total_value_snapshot = tonumber(data.total_value) or 0
                log.cursor_key = data.cursor
                KladManager.SyncLootLogs(true)
                KladManager.QueryLootData(true)
            else
                log.sync_status = "pending"
                KladManager.Diagnostics.last_error = tostring(
                    error_data and error_data.code or "loot_upload"
                )
            end
            KladManager.SaveLootStore()
        end
    )
    if not request_id then
        log.sync_status = "pending"
        return false
    end
    KladManager.SaveLootStore()
    return true
end

function KladManager.FinalizeLootMachine(source)
    local machine = KladManager.LootMachine(source)
    if machine.state ~= "loot_received" or #machine.items == 0 then
        return false
    end
    local now_ms = getGameTimer()
    local success = source == "chest"
        and machine.signals.cef_window_title == true
        or source == "treasure"
            and (
                machine.signals.chat_lock_success == true
                or machine.signals.cef_items_notification == true
            )
    if not success then
        return false
    end
    local fingerprint = KladManager.LootFingerprint(source, machine.items)
    local previous = tonumber(KladManager.Loot.recent_fingerprints[fingerprint] or 0)
    if previous > 0 and now_ms - previous < 10000 then
        machine.state = "finalized"
        machine.finalized_at = now_ms
        return false
    end
    KladManager.Loot.recent_fingerprints[fingerprint] = now_ms
    KladManager.Loot.sequence = KladManager.Loot.sequence + 1
    local timestamp = os.time()
    local session_id = KladManager.Auth.session and KladManager.Auth.session.session_id
        or KladManager.InstallId
    local event_id = KladManager.LootEventId(
        session_id,
        KladManager.Loot.sequence,
        timestamp,
        source
    )
    local signals = {}
    for signal, enabled in pairs(machine.signals) do
        if enabled then
            signals[#signals + 1] = signal
        end
    end
    table.sort(signals)
    local player = KladManager.PlayerContext()
    local upload_items = {}
    local display_items = {}
    for _, item in ipairs(machine.items) do
        upload_items[#upload_items + 1] = {
            name=item.name,
            item_id=item.item_id,
            quantity=tonumber(item.quantity) or 1
        }
        display_items[#display_items + 1] = {
            name=item.name,
            name_norm=item.name_norm,
            item_id=item.item_id,
            upgrade=item.upgrade,
            quantity=tonumber(item.quantity) or 1,
            price_status="not_found"
        }
    end
    local upload_event = {
        local_event_id=event_id,
        sequence=KladManager.Loot.sequence,
        source=source,
        signal_sources=signals,
        occurred_at=KladManager.IsoTime(timestamp),
        server_key=KladManager.PriceServerKey(),
        world=tonumber(player.world) or 0,
        interior=tonumber(player.interior) or 0,
        duration_seconds=math.max(
            0,
            math.floor((now_ms - tonumber(machine.started_at or now_ms)) / 1000)
        ),
        items=upload_items,
        client={version=KM_VERSION,protocol=KM_PROTOCOL_VERSION}
    }
    local log = {
        id=event_id,
        event_id=event_id,
        source=source,
        occurred_at=upload_event.occurred_at,
        day=os.date("%Y-%m-%d", timestamp),
        server_key=upload_event.server_key,
        world=upload_event.world,
        interior=upload_event.interior,
        items=display_items,
        total_value_snapshot=0,
        sync_status="pending",
        fraud_status="accepted",
        upload_event=upload_event
    }
    table.insert(KladManager.Loot.logs, 1, log)
    machine.state = "finalized"
    machine.finalized_at = now_ms
    KladManager.Loot.selected_id = event_id
    KladManager.SaveLootStore()
    KladManager.SubmitLootLog(log)
    KladManager.Notify(
        "success",
        source == "chest" and "Шкатулка" or "Клад",
        "Лут сохранён: " .. tostring(#display_items) .. " предметов.",
        4.0
    )
    return true
end

function KladManager.SyncLootLogs(force)
    if KladManager.Gameplay.loot_sync_busy or KladManager.Auth.state ~= "approved"
        or not KladManager.Auth.session or not KladManager.Auth.session.access_token then
        return false
    end
    if not force and getGameTimer() - KladManager.Gameplay.last_loot_sync < 60000 then
        return false
    end
    KladManager.Gameplay.loot_sync_busy = true
    KladManager.Gameplay.last_loot_sync = getGameTimer()
    local request_id = KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/loot-sync",
        {
            device_proof=KladManager.DeviceSignals(),
            client={version=KM_VERSION,protocol=KM_PROTOCOL_VERSION},
            after_cursor=KladManager.Loot.cursor or "",
            snapshot_cursor=KladManager.Loot.snapshot_cursor,
            limit=250
        },
        {
            authorization=KladManager.Auth.session.access_token,
            idempotency_key=KladManager.NewRequestId("loot-sync"),
            timeout_ms=12000
        },
        function(ok, data, error_data)
            KladManager.Gameplay.loot_sync_busy = false
            if not ok then
                KladManager.Diagnostics.last_error = tostring(
                    error_data and error_data.code or "loot_sync"
                )
                return
            end
            KladManager.MergeLootLogs(data.items)
            KladManager.Loot.cursor = tostring(data.next_cursor or KladManager.Loot.cursor or "")
            KladManager.Loot.snapshot_cursor = data.has_more
                and tostring(data.snapshot_cursor or "") or nil
            KladManager.SaveLootStore()
            if data.has_more then
                KladManager.Gameplay.last_loot_sync = 0
                KladManager.SyncLootLogs(true)
            end
        end
    )
    if not request_id then
        KladManager.Gameplay.loot_sync_busy = false
        return false
    end
    return true
end

function KladManager.QueryLootData(force)
    if KladManager.Loot.query_busy or KladManager.Auth.state ~= "approved"
        or not KladManager.Auth.session or not KladManager.Auth.session.access_token then
        return false
    end
    if not force and getGameTimer() - KladManager.Loot.last_query_at < 30000 then
        return false
    end
    KladManager.Loot.query_busy = true
    KladManager.Loot.query_error = nil
    KladManager.Loot.last_query_at = getGameTimer()
    local request_id = KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/loot-query",
        {
            device_proof=KladManager.DeviceSignals(),
            client={version=KM_VERSION,protocol=KM_PROTOCOL_VERSION},
            source=nil,
            day=nil,
            period=KladManager.Settings.statistics.period,
            price_mode=KladManager.Settings.prices.mode,
            limit=2000
        },
        {
            authorization=KladManager.Auth.session.access_token,
            idempotency_key=KladManager.NewRequestId("loot-query"),
            timeout_ms=15000
        },
        function(ok, data, error_data)
            KladManager.Loot.query_busy = false
            if not ok then
                KladManager.Loot.query_error = tostring(
                    error_data and error_data.message or "Не удалось загрузить логи."
                )
                return
            end
            KladManager.MergeLootLogs(data.logs)
            KladManager.Loot.dates = type(data.dates) == "table" and data.dates or {}
            KladManager.Loot.summary = type(data.summary) == "table" and data.summary or nil
            KladManager.Loot.achievements =
                type(data.achievements) == "table" and data.achievements or {}
            KladManager.Loot.rating_history =
                type(data.rating_history) == "table" and data.rating_history or {}
            KladManager.SaveLootStore()
            KladManager.SavePriceCache()
        end
    )
    if not request_id then
        KladManager.Loot.query_busy = false
        return false
    end
    return true
end

function KladManager.ProcessLootCefEvent(value)
    local now = getGameTimer()
    if value:find("event.itemsNotification.initialize", 1, true)
        and KladManager.LootContains(value, "Клад успешно выкопан") then
        KladManager.Loot.active_window = {source="treasure",received_at=now}
        KladManager.LootSignal("treasure", "cef_items_notification", nil, false)
    end
    if value:find("event.mountain.testDrive.initializeText", 1, true) then
        if KladManager.LootContains(value, "Шкатулка кладоискателя") then
            KladManager.Loot.active_window = {source="chest",received_at=now}
            KladManager.LootSignal("chest", "cef_window_title", nil, false)
        elseif KladManager.LootContains(value, "Клад") then
            KladManager.Loot.active_window = {source="treasure",received_at=now}
            KladManager.LootSignal("treasure", "cef_window_title", nil, false)
        end
    end
    if value:find("event.mountain.testDrive.addVehicles", 1, true) then
        local items = KladManager.ParseCefLootItems(value)
        if not items then
            return
        end
        local active = KladManager.Loot.active_window
        if active and now - tonumber(active.received_at or 0) <= 15000 then
            KladManager.LootSignal(active.source, "cef_loot", items, true)
        else
            local treasure = KladManager.LootMachine("treasure")
            local chest = KladManager.LootMachine("chest")
            local source = tonumber(chest.updated_at or 0) > tonumber(treasure.updated_at or 0)
                and "chest" or "treasure"
            if tonumber(KladManager.LootMachine(source).started_at or 0) > 0 then
                KladManager.LootSignal(source, "cef_loot", items, true)
            else
                KladManager.Loot.pending_cef={items=items,received_at=now}
            end
        end
    end
end

function KladManager.ProcessCefEvent(text)
    local value = tostring(text or "")
    KladManager.ProcessLootCefEvent(value)
    local confirmed_phrase = "Клад успешно выкопан"
    local utf8_phrase = tostring(KladManager.U8(confirmed_phrase))
    if value:find(confirmed_phrase, 1, true)
        or value:find(utf8_phrase, 1, true) then
        KladManager.ConfirmTreasureDig("cef_confirmed")
    end
    if not value:find("event.inventory.playerInventory", 1, true) then
        return
    end
    local payload = KladManager.CefJsonPayload(value)
    if not payload then
        return
    end
    local ok, decoded = pcall(KladManager.Json.decode, payload)
    if not ok or type(decoded) ~= "table" then
        KladManager.Diagnostics.last_error = "CEF inventory JSON"
        return
    end
    local event = decoded[1] or decoded
    local data = type(event) == "table" and event.data or nil
    local action = type(event) == "table" and tonumber(event.action) or nil
    if type(data) == "table" and type(data.items) == "table"
        and (action == nil or action == 0 or action == 2) then
        KladManager.UpdateDetectorFromInventory(
            data.type,
            data.items,
            "cef_inventory"
        )
    end
end

function KladManager.UInt8(value)
    local number = tonumber(value) or 0
    return number < 0 and number + 256 or number
end

function KladManager.UInt16(value)
    local number = tonumber(value) or 0
    return number < 0 and number + 65536 or number
end

function KladManager.UInt32(value)
    local number = tonumber(value) or 0
    return number < 0 and number + 4294967296 or number
end

function KladManager.DecodeCefStringVariant(stream, length_bits)
    local length = length_bits == 16
        and KladManager.UInt16(raknetBitStreamReadInt16(stream))
        or KladManager.UInt8(raknetBitStreamReadInt8(stream))
    if length <= 0 or length > 200000 then
        return nil
    end
    local encoded = KladManager.UInt8(raknetBitStreamReadInt8(stream))
    if encoded ~= 0 then
        local ok, value = pcall(raknetBitStreamDecodeString, stream, length + 1)
        if ok and type(value) == "string" then
            return value
        end
        if not ok then
            KladManager.Diagnostics.last_error = "CEF decode: " .. tostring(value)
        end
        return nil
    end
    local ok, value = pcall(raknetBitStreamReadString, stream, length)
    if ok and type(value) == "string" then
        return value
    end
    if not ok then
        KladManager.Diagnostics.last_error = "CEF read: " .. tostring(value)
    end
    return nil
end

function KladManager.ReadCefEventString(stream)
    local browser_id = KladManager.UInt32(raknetBitStreamReadInt32(stream))
    local offset = raknetBitStreamGetReadOffset(stream)
    local text = KladManager.DecodeCefStringVariant(stream, 16)
    if text and (text:find("window.executeEvent", 1, true)
        or text:find("event.", 1, true)) then
        return browser_id, text
    end
    raknetBitStreamSetReadOffset(stream, offset)
    return browser_id, KladManager.DecodeCefStringVariant(stream, 8)
end

function KladManager.HandleCustomAccessoryPacket(stream)
    local player_id = KladManager.UInt16(raknetBitStreamReadInt16(stream))
    local service_slot = KladManager.UInt32(raknetBitStreamReadInt32(stream))
    local create = raknetBitStreamReadBool(stream)
    if player_id ~= KladManager.LocalPlayerId() then
        return
    end
    if not create then
        KladManager.Detector.attached["custom:" .. tostring(service_slot)] = nil
        return
    end
    local bone = KladManager.UInt32(raknetBitStreamReadInt32(stream))
    local model_id = KladManager.UInt32(raknetBitStreamReadInt32(stream))
    KladManager.Detector.attached["custom:" .. tostring(service_slot)] = {
        model_id=model_id,
        bone=bone,
        source="packet_220_custom_155",
        observed_at=os.time()
    }
end

function KladManager.OnReceivePacket(packet_id, stream)
    if tonumber(packet_id) ~= 220 then
        return
    end
    local ok, error_value = pcall(function()
        raknetBitStreamResetReadPointer(stream)
        raknetBitStreamIgnoreBits(stream, 8)
        local custom_id = KladManager.UInt8(raknetBitStreamReadInt8(stream))
        if custom_id == 155 then
            KladManager.HandleCustomAccessoryPacket(stream)
        elseif custom_id == 17 then
            local _, text = KladManager.ReadCefEventString(stream)
            if text then
                KladManager.ProcessCefEvent(text)
            end
        end
    end)
    if not ok then
        KladManager.Diagnostics.last_error = "Packet 220: " .. tostring(error_value)
    end
end

function KladManager.OnSetPlayerAttachedObject(player_id, index, create, object)
    if tonumber(player_id) ~= KladManager.LocalPlayerId() then
        return
    end
    local key = "standard:" .. tostring(index)
    if not create then
        KladManager.Detector.attached[key] = nil
        return
    end
    object = type(object) == "table" and object or {}
    KladManager.Detector.attached[key] = {
        model_id=tonumber(object.modelId or object.model) or 0,
        bone=tonumber(object.bone) or 0,
        source="standard_attached_object",
        observed_at=os.time()
    }
end

function KladManager.DetectorEvidence()
    if tonumber(KladManager.Detector.expires_at or 0) <= os.time() then
        local attached_at = nil
        for _, object in pairs(KladManager.Detector.attached) do
            attached_at = math.max(
                tonumber(attached_at) or 0,
                tonumber(object.observed_at) or 0
            )
        end
        return {
            state="unknown",
            item_id=nil,
            detector_type=nil,
            source=attached_at and "attached_object" or "cache",
            observed_at=attached_at and KladManager.IsoTime(attached_at) or nil
        }
    end
    return {
        state=KladManager.Detector.state,
        item_id=KladManager.Detector.item_id,
        detector_type=KladManager.Detector.detector_type,
        source=KladManager.Gameplay.last_detector_rescan > 0
            and KM_ELAPSED(KladManager.Gameplay.last_detector_rescan) < 5000
            and "rescan"
            or KladManager.Detector.source == "cef_inventory"
                and "cef_inventory" or "cache",
        observed_at=KladManager.IsoTime(KladManager.Detector.observed_at)
    }
end

function KladManager.RescanDetectorCache()
    local found_id = nil
    local found_type = nil
    local received = false
    for _, value in pairs(KladManager.Detector.inventory_received) do
        received = received or value == true
    end
    for _, items in pairs(KladManager.Detector.inventory_types) do
        for _, entry in pairs(items) do
            local detector_id, detector_type = KladManager.DetectorIdentity(
                entry.item_id,
                entry.name
            )
            if detector_id then
                found_id = detector_id
                found_type = detector_type
            end
        end
    end
    KladManager.Detector.state = found_id and "present"
        or received and "absent" or "unknown"
    KladManager.Detector.item_id = found_id
    KladManager.Detector.detector_type = found_type
    KladManager.Detector.source = "rescan"
    KladManager.Detector.observed_at = os.time()
    KladManager.Detector.expires_at = os.time() + 900
    return found_id ~= nil
end

function KladManager.ConfirmTreasureDig(capture_source)
    local now = getGameTimer()
    if KladManager.Gameplay.last_confirmed_dig
        and KM_ELAPSED(KladManager.Gameplay.last_confirmed_dig) < 2000 then
        return false
    end
    KladManager.Gameplay.last_confirmed_dig = now
    KladManager.Gameplay.last_detector_rescan = now
    KladManager.RescanDetectorCache()
    local event_id = "treasure:" .. KladManager.RandomToken()
    lua_thread.create(function()
        wait(250)
        local position = KladManager.CurrentPosition()
        if not position then
            return
        end
        local server = KladManager.ServerContext()
        local player = KladManager.PlayerContext()
        KladManager.SubmitCoordinateObservation({
            event_id=event_id,
            position=position,
            server=server,
            world=player.world,
            interior=player.interior,
            source=capture_source,
            sync_status="pending"
        }, "confirmed_dig")
    end)
    return true
end

function KladManager.OnServerMessage(color, text)
    local clean = KladManager.NormalizeGameText(text)
    local player_id = KladManager.LocalPlayerId()
    local nickname = ""
    if player_id and sampGetPlayerNickname then
        local ok, value = pcall(sampGetPlayerNickname, player_id)
        if ok then
            nickname = tostring(value or "")
        else
            KladManager.Diagnostics.last_error = "Nickname: " .. tostring(value)
        end
    end
    local lowered = clean:lower()
    local phrase = "попытал удачу и получил секретный дополнительный клад"
    if nickname ~= "" and lowered:find(nickname:lower(), 1, true)
        and lowered:find(phrase, 1, true) then
        KladManager.ArmDopkaExpectation()
    end
    if lowered:find("клад успешно выкопан", 1, true)
        or lowered:find(
            "поздравляем! вы успешно взломали замок клада",
            1,
            true
        ) then
        KladManager.ConfirmTreasureDig("chat_confirmed")
        KladManager.Loot.active_window = {
            source="treasure",
            received_at=getGameTimer()
        }
        KladManager.LootSignal("treasure", "chat_lock_success", nil, false)
    end
    local item, quantity = clean:match("Вы нашли в кладе:%s*([^%(]+)%s*%((%d+)%s+шт%)")
    if item and quantity and not clean:find("]", 1, true) then
        KladManager.Loot.active_window = {
            source="treasure",
            received_at=getGameTimer()
        }
        KladManager.LootSignal(
            "treasure",
            "chat_found_item",
            {KladManager.ParseLootTitle(item, quantity)},
            false
        )
    end
end

function KladManager.SubmitCoordinateObservation(item, observation_source)
    if KladManager.Auth.state ~= "approved" or not KladManager.Auth.session
        or not KladManager.Auth.session.access_token then
        item.sync_status = "not_sent"
        return false
    end
    if KladManager.Auth.feature_flags.coordinate_observations == false
        or KladManager.Auth.feature_flags.lua_sync == false then
        item.sync_status = "disabled"
        return false
    end
    if not item.event_id or not KladManager.ValidPosition(item.position) then
        item.sync_status = "invalid"
        return false
    end
    local server = item.server or KladManager.ServerContext()
    if not server.host or server.host == "" or tonumber(server.port or 0) <= 0 then
        item.sync_status = "not_sent"
        return false
    end
    local capture_source = item.source
    if observation_source == "dopka" then
        capture_source = item.source == "memory_fallback"
            and "memory_fallback" or "onSetMapIcon"
    elseif capture_source ~= "chat_confirmed" then
        capture_source = "cef_confirmed"
    end
    item.sync_status = "sending"
    local request_id = KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/coordinate-observations",
        {
            device_proof=KladManager.DeviceSignals(),
            observation={
                local_event_id=item.event_id,
                captured_at=KladManager.IsoTime(item.created_at),
                server={host=server.host,port=server.port},
                world=tonumber(item.world) or 0,
                interior=tonumber(item.interior) or 0,
                position=item.position,
                source=observation_source,
                capture_source=capture_source,
                detector=KladManager.DetectorEvidence(),
                client={version=KM_VERSION,protocol=KM_PROTOCOL_VERSION}
            }
        },
        {
            authorization=KladManager.Auth.session.access_token,
            idempotency_key=item.event_id,
            timeout_ms=12000
        },
        function(ok, data, error_data)
            if ok then
                item.sync_status = tostring(data.status or "accepted")
                item.cluster_id = data.cluster and data.cluster.id or nil
            else
                item.sync_status = "failed"
                KladManager.Diagnostics.last_error = tostring(
                    error_data and error_data.code or "coordinate_upload"
                )
            end
            if observation_source == "dopka" then
                KladManager.SaveDopkas()
            end
        end
    )
    if not request_id then
        item.sync_status = "not_sent"
        return false
    end
    return true
end

function KladManager.ApplyClusterDelta(data)
    local by_id = {}
    for _, cluster in ipairs(KladManager.ServerClusters) do
        by_id[tostring(cluster.id)] = cluster
    end
    for _, change in ipairs(data.clusters or {}) do
        local id = tostring(change.id or "")
        if id ~= "" then
            if change.deleted or change.status ~= "verified" then
                by_id[id] = nil
            else
                by_id[id] = change
            end
        end
    end
    local updated = {}
    for _, cluster in pairs(by_id) do
        updated[#updated + 1] = cluster
    end
    table.sort(updated, function(left, right)
        return tonumber(left.confidence or 0) > tonumber(right.confidence or 0)
    end)
    KladManager.ServerClusters = updated
    KladManager.Gameplay.cluster_revision = tonumber(data.revision)
        or KladManager.Gameplay.cluster_revision
    KladManager.SaveClusterCache()
end

function KladManager.SyncCoordinateClusters()
    if KladManager.Gameplay.cluster_sync_busy or KladManager.Auth.state ~= "approved"
        or not KladManager.Auth.session or not KladManager.Auth.session.access_token then
        return false
    end
    if KladManager.Auth.feature_flags.server_clusters == false
        or KladManager.Auth.feature_flags.lua_sync == false then
        return false
    end
    KladManager.Gameplay.cluster_sync_busy = true
    KladManager.Gameplay.last_cluster_sync = getGameTimer()
    local sync_key = "cluster-sync:" .. tostring(
        KladManager.Gameplay.cluster_revision
    ) .. ":" .. KladManager.RandomToken()
    KladManager.ApiRequest(
        "POST",
        "/api/v1/lua/coordinate-clusters/sync",
        {
            device_proof=KladManager.DeviceSignals(),
            client={version=KM_VERSION,protocol=KM_PROTOCOL_VERSION},
            after_revision=KladManager.Gameplay.cluster_revision,
            limit=500
        },
        {
            authorization=KladManager.Auth.session.access_token,
            idempotency_key=sync_key,
            timeout_ms=12000
        },
        function(ok, data, error_data)
            KladManager.Gameplay.cluster_sync_busy = false
            if ok then
                KladManager.ApplyClusterDelta(data)
                if data.has_more then
                    KladManager.Gameplay.last_cluster_sync = 0
                end
            else
                KladManager.Diagnostics.last_error = tostring(
                    error_data and error_data.code or "cluster_sync"
                )
            end
        end
    )
    return true
end

function KladManager.TickExpectations()
    local now = getGameTimer()
    local dopka = KladManager.Gameplay.map_expectation
    if dopka and dopka.active then
        if dopka.first_candidate_at and now - dopka.first_candidate_at >= 250 then
            table.sort(dopka.candidates, function(left, right)
                return left.received_at < right.received_at
            end)
            KladManager.FinalizeDopkaExpectation(
                #dopka.candidates == 1 and dopka.candidates[1] or nil,
                "onSetMapIcon"
            )
        elseif now >= dopka.deadline then
            KladManager.FinalizeDopkaExpectation(
                KladManager.MemoryExpectationDelta(dopka),
                "memory_fallback"
            )
        end
    end
    local spawn = KladManager.Gameplay.spawn_expectation
    if spawn and spawn.active then
        if spawn.first_candidate_at and now - spawn.first_candidate_at >= 250 then
            table.sort(spawn.candidates, function(left, right)
                return left.received_at < right.received_at
            end)
            KladManager.FinalizeSpawnExpectation(
                #spawn.candidates == 1 and spawn.candidates[1] or nil
            )
        elseif now >= spawn.deadline then
            KladManager.FinalizeSpawnExpectation(nil)
        end
    end
    local discovery = KladManager.Gameplay.discovery
    if discovery.active and not KladManager.Gameplay.spawn_expectation
        and now >= tonumber(discovery.next_at or 0) then
        KladManager.StartNextSpawnDiscovery()
    end
    local rec = KladManager.Gameplay.rec_expectation
    if rec and now >= rec.deadline then
        KladManager.Gameplay.rec_expectation = nil
        KladManager.Notify("warning", "Спавны", "Диалог /rec не появился.", 4.0)
    end
end

function KladManager.TickLootMachines()
    local now = getGameTimer()
    for _, source in ipairs({"treasure","chest"}) do
        local machine = KladManager.LootMachine(source)
        if machine.state == "loot_received" then
            local delay = machine.signals.chat_found_item and 900 or 250
            if now - tonumber(machine.loot_received_at or now) >= delay then
                KladManager.FinalizeLootMachine(source)
            end
        elseif machine.state ~= "idle" and machine.state ~= "finalized"
            and now - tonumber(machine.started_at or now) > 15000 then
            machine.state = "expired"
            machine.items = {}
        elseif machine.state == "finalized"
            and now - tonumber(machine.finalized_at or now) > 5000 then
            KladManager.ResetLootMachine(source)
            if KladManager.Loot.active_window
                and KladManager.Loot.active_window.source == source then
                KladManager.Loot.active_window = nil
            end
        end
    end
    if KladManager.Loot.pending_cef
        and now - tonumber(KladManager.Loot.pending_cef.received_at or now) > 5000 then
        KladManager.Loot.pending_cef = nil
    end
    for fingerprint, received_at in pairs(KladManager.Loot.recent_fingerprints) do
        if now - tonumber(received_at or 0) > 30000 then
            KladManager.Loot.recent_fingerprints[fingerprint] = nil
        end
    end
end

function KladManager.RetryPendingLoot()
    if KladManager.Auth.state ~= "approved" then
        return false
    end
    for _, log in ipairs(KladManager.Loot.logs) do
        if log.sync_status == "pending"
            and os.time() - tonumber(log.last_attempt_at or 0) >= 60 then
            return KladManager.SubmitLootLog(log)
        end
    end
    return false
end

function KladManager.TickGameplay()
    local now = getGameTimer()
    KladManager.TickExpectations()
    KladManager.TickLootMachines()
    if now - KladManager.Gameplay.last_tick < 1000 then
        return
    end
    KladManager.Gameplay.last_tick = now
    KladManager.CleanupExpiredDopkas(os.time())
    KladManager.RetryPendingLoot()
    local server = KladManager.ServerContext()
    if server.key ~= KladManager.Gameplay.last_server then
        if KladManager.Settings.map.spawn_server_auto_switch
            or KladManager.Gameplay.last_server == "" then
            KladManager.SwitchSpawnServer(true)
        end
    end
    if KladManager.Auth.state == "approved"
        and now - KladManager.Gameplay.last_cluster_sync >= 60000 then
        KladManager.SyncCoordinateClusters()
    end
    if KladManager.Auth.state == "approved"
        and now - KladManager.Gameplay.last_loot_sync >= 60000 then
        KladManager.SyncLootLogs(false)
        KladManager.QueryLootData(false)
    end
end

function KladManager.InitializeGameplay()
    if KladManager.Gameplay.initialized then
        return true
    end
    if not KM_ENSURE_DIR(KladManager.GameplayPaths.root) then
        return false
    end
    KladManager.LoadGameplayStores()
    KladManager.CreateGameBuffers()
    KladManager.SwitchSpawnServer(false)
    KladManager.Gameplay.zone_intersection = KladManager.ZoneIntersection(
        KladManager.Settings.map.intersection_count
    )
    KladManager.SampEvents.onServerMessage = KladManager.OnServerMessage
    KladManager.SampEvents.onSetMapIcon = KladManager.OnSetMapIcon
    KladManager.SampEvents.onRemoveMapIcon = KladManager.OnRemoveMapIcon
    KladManager.SampEvents.onShowDialog = KladManager.OnShowDialog
    KladManager.SampEvents.onCreateGangZone = KladManager.OnCreateGangZone
    KladManager.SampEvents.onGangZoneDestroy = KladManager.OnGangZoneDestroy
    KladManager.SampEvents.onSetPlayerAttachedObject =
        KladManager.OnSetPlayerAttachedObject
    addEventHandler("onReceivePacket", KladManager.OnReceivePacket)
    KladManager.Gameplay.initialized = true
    return true
end

function KladManager.Scale()
    local mode = KladManager.Settings.ui.scale
    if mode == "small" then
        return 0.88
    elseif mode == "large" then
        return 1.15
    end
    return 1.0
end

function KladManager.Scaled(value)
    return value * KladManager.Scale()
end

function KladManager.Vec4(name, alpha)
    local color = KladManager.Palette[name] or KladManager.Palette.text1
    return KladManager.ImGui.ImVec4(
        color[1],
        color[2],
        color[3],
        (alpha or color[4]) * KladManager.Settings.ui.opacity
    )
end

function KladManager.U32(name, alpha)
    return KladManager.ImGui.GetColorU32Vec4(KladManager.Vec4(name, alpha))
end

function KladManager.Icon(name)
    local normalized = tostring(name or ""):upper():gsub("^ICON_FA_", "")
    normalized = KladManager.Fa6Aliases[normalized] or normalized
    return tostring(KladManager.fa[normalized] or "")
end

function KladManager.PushFont(kind)
    local imgui = KladManager.ImGui
    local scale = KladManager.Settings.ui.scale
    local font = KladManager.Fonts[kind .. "_" .. scale]
    if font then
        imgui.PushFont(font)
        return true
    end
    return false
end

function KladManager.PopFont(pushed)
    if pushed then
        KladManager.ImGui.PopFont()
    end
end

function KladManager.Animate(id, target, speed)
    local current = KladManager.ComponentAnimation[id] or target
    local delta = tonumber(KladManager.ImGui.GetIO().DeltaTime) or 0.016
    local factor = KladManager.Clamp(delta * (speed or 12.0), 0.0, 1.0)
    current = current + (target - current) * factor
    KladManager.ComponentAnimation[id] = current
    return current
end

function KladManager.DisabledBegin(disabled)
    if disabled then
        KladManager.ImGui.PushStyleVarFloat(
            KladManager.ImGui.StyleVar.Alpha,
            KladManager.ImGui.GetStyle().Alpha * 0.46
        )
    end
end

function KladManager.DisabledEnd(disabled)
    if disabled then
        KladManager.ImGui.PopStyleVar()
    end
end

function KladManager.Button(id, label, icon, size, variant, disabled, busy)
    local imgui = KladManager.ImGui
    local colors = {
        primary={"accent","accent_hover"},
        secondary={"surface2","surface3"},
        outline={"surface1","surface2"},
        danger={"danger","danger"}
    }
    local selected = colors[variant or "primary"] or colors.primary
    KladManager.DisabledBegin(disabled or busy)
    imgui.PushStyleColor(imgui.Col.Button, KladManager.Vec4(selected[1]))
    imgui.PushStyleColor(imgui.Col.ButtonHovered, KladManager.Vec4(selected[2]))
    imgui.PushStyleColor(imgui.Col.ButtonActive, KladManager.Vec4(selected[1]))
    local text = tostring(label or "")
    if busy then
        text = "Загрузка..."
    end
    local pushed = false
    local caption = KladManager.U8(text) .. "##" .. tostring(id)
    if text == "" and icon and icon ~= "" then
        pushed = KladManager.PushFont("icon")
        caption = KladManager.Icon(icon) .. "##" .. tostring(id)
    end
    local clicked = imgui.Button(caption, size or imgui.ImVec2(0, 0))
    KladManager.PopFont(pushed)
    imgui.PopStyleColor(3)
    KladManager.DisabledEnd(disabled or busy)
    return clicked and not disabled and not busy
end

function KladManager.IconButton(id, icon, tooltip, disabled)
    local clicked = KladManager.Button(
        id,
        "",
        icon,
        KladManager.ImGui.ImVec2(KladManager.Scaled(32), KladManager.Scaled(28)),
        "secondary",
        disabled,
        false
    )
    KladManager.Tooltip(tooltip)
    return clicked
end

function KladManager.Checkbox(id, label, value, disabled)
    local imgui = KladManager.ImGui
    local scale = KladManager.Scale()
    local size = imgui.ImVec2(36 * scale, 20 * scale)
    KladManager.DisabledBegin(disabled)
    local clicked = imgui.InvisibleButton("##checkbox_" .. tostring(id), size)
    local hovered = imgui.IsItemHovered()
    local minimum = imgui.GetItemRectMin()
    local maximum = imgui.GetItemRectMax()
    local draw = imgui.GetWindowDrawList()
    local target = value and 1.0 or 0.0
    local animated = KladManager.Animate("checkbox_" .. tostring(id), target, 15.0)
    draw:AddRectFilled(
        minimum,
        maximum,
        KladManager.U32(value and "accent" or hovered and "surface3" or "surface2"),
        10 * scale
    )
    draw:AddCircleFilled(
        imgui.ImVec2(
            minimum.x + 10 * scale + animated * 16 * scale,
            minimum.y + 10 * scale
        ),
        7 * scale,
        KladManager.U32("text1")
    )
    imgui.SameLine()
    imgui.Text(KladManager.U8(label))
    KladManager.DisabledEnd(disabled)
    if clicked and not disabled then
        return true, not value
    end
    return false, value
end

function KladManager.Segmented(id, options, current, disabled)
    local imgui = KladManager.ImGui
    local changed = false
    local result = current
    KladManager.DisabledBegin(disabled)
    for index, option in ipairs(options) do
        if index > 1 then
            imgui.SameLine(0, 4 * KladManager.Scale())
        end
        local active = option.value == current
        imgui.PushStyleColor(
            imgui.Col.Button,
            KladManager.Vec4(active and "accent_soft" or "surface2")
        )
        imgui.PushStyleColor(
            imgui.Col.ButtonHovered,
            KladManager.Vec4(active and "accent_soft" or "surface3")
        )
        imgui.PushStyleColor(
            imgui.Col.Text,
            KladManager.Vec4(active and "text1" or "text2")
        )
        if imgui.Button(
            KladManager.U8(option.label) .. "##" .. tostring(id) .. "_" .. tostring(index)
        ) and not disabled then
            changed = true
            result = option.value
        end
        imgui.PopStyleColor(3)
    end
    KladManager.DisabledEnd(disabled)
    return changed, result
end

function KladManager.Input(id, hint, buffer, capacity, disabled)
    local imgui = KladManager.ImGui
    KladManager.DisabledBegin(disabled)
    imgui.PushItemWidth(-1)
    local changed = imgui.InputTextWithHint(
        "##" .. tostring(id),
        KladManager.U8(hint),
        buffer,
        capacity,
        disabled and imgui.InputTextFlags.ReadOnly or 0
    )
    imgui.PopItemWidth()
    KladManager.DisabledEnd(disabled)
    return changed and not disabled
end

function KladManager.PasswordInput(id, hint, buffer, capacity, visible, disabled)
    local imgui = KladManager.ImGui
    KladManager.DisabledBegin(disabled)
    imgui.PushItemWidth(-KladManager.Scaled(42))
    local flags = (visible and 0 or imgui.InputTextFlags.Password)
        + (disabled and imgui.InputTextFlags.ReadOnly or 0)
    local changed = imgui.InputTextWithHint(
        "##" .. tostring(id),
        KladManager.U8(hint),
        buffer,
        capacity,
        flags
    )
    imgui.PopItemWidth()
    imgui.SameLine()
    if KladManager.IconButton(
        tostring(id) .. "_visibility",
        visible and "ICON_FA_EYE_SLASH" or "ICON_FA_EYE",
        visible and "Скрыть пароль" or "Показать пароль",
        disabled
    ) then
        KladManager.Auth.show_password = not visible
    end
    KladManager.DisabledEnd(disabled)
    return changed and not disabled
end

function KladManager.Combo(id, label, options, current, disabled)
    local imgui = KladManager.ImGui
    local changed = false
    local result = current
    KladManager.DisabledBegin(disabled)
    if imgui.BeginCombo("##" .. tostring(id), KladManager.U8(label)) then
        for _, option in ipairs(options) do
            local selected = option.value == current
            if imgui.Selectable(KladManager.U8(option.label), selected) and not disabled then
                changed = true
                result = option.value
            end
            if selected then
                imgui.SetItemDefaultFocus()
            end
        end
        imgui.EndCombo()
    end
    KladManager.DisabledEnd(disabled)
    return changed, result
end

function KladManager.Tooltip(text)
    if not text or text == "" then
        return
    end
    local key = tostring(text)
    if KladManager.ImGui.IsItemHovered() then
        KladManager.TooltipHover[key] = KladManager.TooltipHover[key] or KladManager.NowMs()
        if KladManager.NowMs() - KladManager.TooltipHover[key] >= 350 then
            KladManager.ImGui.SetTooltip(KladManager.U8(text))
        end
    else
        KladManager.TooltipHover[key] = nil
    end
end

function KladManager.OpenPopup(id)
    KladManager.ImGui.OpenPopup(tostring(id))
end

function KladManager.Modal(id, title, render)
    local imgui = KladManager.ImGui
    local open = imgui.BeginPopupModal(
        KladManager.U8(title) .. "###" .. tostring(id),
        nil,
        imgui.WindowFlags.AlwaysAutoResize
    )
    if open then
        render()
        imgui.EndPopup()
    end
    return open
end

function KladManager.DateSelector(id)
    local imgui = KladManager.ImGui
    imgui.PushItemWidth(KladManager.Scaled(66))
    local changed_day = imgui.InputInt(
        "##day_" .. tostring(id),
        KladManager.Buffers.date_day,
        1,
        7
    )
    imgui.SameLine()
    local changed_month = imgui.InputInt(
        "##month_" .. tostring(id),
        KladManager.Buffers.date_month,
        1,
        3
    )
    imgui.SameLine()
    local changed_year = imgui.InputInt(
        "##year_" .. tostring(id),
        KladManager.Buffers.date_year,
        1,
        10
    )
    imgui.PopItemWidth()
    KladManager.Buffers.date_day[0] = KladManager.Clamp(KladManager.Buffers.date_day[0], 1, 31)
    KladManager.Buffers.date_month[0] = KladManager.Clamp(KladManager.Buffers.date_month[0], 1, 12)
    KladManager.Buffers.date_year[0] = KladManager.Clamp(KladManager.Buffers.date_year[0], 2020, 2100)
    return changed_day or changed_month or changed_year
end

function KladManager.Card(id, size, render)
    local imgui = KladManager.ImGui
    imgui.PushStyleColor(imgui.Col.ChildBg, KladManager.Vec4("surface1"))
    imgui.BeginChild(
        "##card_" .. tostring(id),
        size,
        true,
        imgui.WindowFlags.NoScrollbar
    )
    render()
    imgui.EndChild()
    imgui.PopStyleColor()
end

function KladManager.ListRow(id, primary, secondary, badge)
    local imgui = KladManager.ImGui
    KladManager.Card(id, imgui.ImVec2(-1, KladManager.Scaled(54)), function()
        imgui.Text(KladManager.U8(primary))
        imgui.TextColored(KladManager.Vec4("text3"), KladManager.U8(secondary))
        if badge and badge ~= "" then
            imgui.SameLine()
            imgui.TextColored(KladManager.Vec4("accent_hover"), KladManager.U8(badge))
        end
    end)
end

function KladManager.ProgressState(id, progress, label)
    KladManager.ImGui.ProgressBar(
        KladManager.Clamp(progress or 0, 0, 1),
        KladManager.ImGui.ImVec2(-1, KladManager.Scaled(8)),
        KladManager.U8(label or "")
    )
end

function KladManager.LoadingState(label)
    local phase = (KladManager.NowMs() % 1200) / 1200
    KladManager.ProgressState("loading", phase, "")
    KladManager.ImGui.TextColored(KladManager.Vec4("text2"), KladManager.U8(label))
end

function KladManager.EmptyState(title, text)
    KladManager.ImGui.TextColored(KladManager.Vec4("text2"), KladManager.U8(title))
    KladManager.ImGui.TextWrapped(KladManager.U8(text))
end

function KladManager.ErrorState(title, text)
    KladManager.ImGui.TextColored(KladManager.Vec4("danger"), KladManager.U8(title))
    KladManager.ImGui.TextWrapped(KladManager.U8(text))
end

function KladManager.ItemCard(id, name, subtitle, icon_texture, uv0, uv1)
    local imgui = KladManager.ImGui
    KladManager.Card(id, imgui.ImVec2(KladManager.Scaled(150), KladManager.Scaled(82)), function()
        if icon_texture then
            imgui.Image(
                icon_texture,
                imgui.ImVec2(KladManager.Scaled(36), KladManager.Scaled(36)),
                uv0 or imgui.ImVec2(0, 0),
                uv1 or imgui.ImVec2(1, 1)
            )
            imgui.SameLine()
        end
        imgui.TextWrapped(KladManager.U8(name))
        imgui.TextColored(KladManager.Vec4("text3"), KladManager.U8(subtitle or ""))
    end)
end

function KladManager.Graph(id, values, size)
    local imgui = KladManager.ImGui
    local width = size and size.x or imgui.GetContentRegionAvail().x
    local height = size and size.y or KladManager.Scaled(110)
    local origin = imgui.GetCursorScreenPos()
    imgui.InvisibleButton("##graph_" .. tostring(id), imgui.ImVec2(width, height))
    local draw = imgui.GetWindowDrawList()
    draw:AddRectFilled(
        origin,
        imgui.ImVec2(origin.x + width, origin.y + height),
        KladManager.U32("surface1"),
        KladManager.Scaled(6)
    )
    if not values or #values < 2 then
        draw:AddText(
            imgui.ImVec2(origin.x + KladManager.Scaled(12), origin.y + KladManager.Scaled(12)),
            KladManager.U32("text3"),
            KladManager.U8("Недостаточно данных")
        )
        return
    end
    local minimum = values[1]
    local maximum = values[1]
    for _, value in ipairs(values) do
        minimum = math.min(minimum, value)
        maximum = math.max(maximum, value)
    end
    local span = math.max(maximum - minimum, 1)
    for index = 2, #values do
        local x1 = origin.x + width * (index - 2) / (#values - 1)
        local x2 = origin.x + width * (index - 1) / (#values - 1)
        local y1 = origin.y + height - height * (values[index - 1] - minimum) / span
        local y2 = origin.y + height - height * (values[index] - minimum) / span
        draw:AddLine(
            imgui.ImVec2(x1, y1),
            imgui.ImVec2(x2, y2),
            KladManager.U32("accent_hover"),
            KladManager.Scaled(2)
        )
    end
end

function KladManager.WorldToMap(x, y, origin, size, zoom)
    local normalized_x = KladManager.Clamp((tonumber(x) + 3000) / 6000, 0, 1)
    local normalized_y = KladManager.Clamp((3000 - tonumber(y)) / 6000, 0, 1)
    local actual_zoom = tonumber(zoom) or 1.0
    local center_x = KladManager.Settings.map.map_center_x
    local center_y = KladManager.Settings.map.map_center_y
    local centered_x = (normalized_x - center_x) * actual_zoom + 0.5
    local centered_y = (normalized_y - center_y) * actual_zoom + 0.5
    return origin.x + centered_x * size.x, origin.y + centered_y * size.y
end

function KladManager.MapToWorld(px, py, origin, size, zoom)
    local actual_zoom = tonumber(zoom) or 1.0
    local normalized_x = ((px - origin.x) / size.x - 0.5) / actual_zoom
        + KladManager.Settings.map.map_center_x
    local normalized_y = ((py - origin.y) / size.y - 0.5) / actual_zoom
        + KladManager.Settings.map.map_center_y
    return normalized_x * 6000 - 3000, 3000 - normalized_y * 6000
end

function KladManager.NotificationColor(level)
    if level == "success" then
        return "success"
    elseif level == "warning" then
        return "warning"
    elseif level == "error" then
        return "danger"
    end
    return "info"
end

function KladManager.NotificationIcon(level)
    if level == "success" then
        return "ICON_FA_CHECK_CIRCLE"
    elseif level == "warning" then
        return "ICON_FA_EXCLAMATION_TRIANGLE"
    elseif level == "error" then
        return "ICON_FA_TIMES_CIRCLE"
    end
    return "ICON_FA_INFO_CIRCLE"
end

function KladManager.LoadSeenServerNotifications()
    if KladManager.Runtime.seen_server_loaded then
        return
    end
    KladManager.Runtime.seen_server_loaded = true
    KladManager.Runtime.seen_server = {}
    KladManager.Runtime.seen_server_order = {}
    local raw = tostring(KladManager.Settings.notifications.seen_server or "")
    for identifier in raw:gmatch("[^,]+") do
        if #identifier <= 128 and identifier:match("^[A-Za-z0-9_.:-]+$")
            and not KladManager.Runtime.seen_server[identifier] then
            KladManager.Runtime.seen_server[identifier] = true
            KladManager.Runtime.seen_server_order[#KladManager.Runtime.seen_server_order + 1]
                = identifier
        end
    end
end

function KladManager.ProcessServerNotifications(items)
    if KladManager.Auth.feature_flags.server_notifications ~= true or type(items) ~= "table" then
        return
    end
    KladManager.LoadSeenServerNotifications()
    local changed = false
    for _, item in ipairs(items) do
        local identifier = type(item) == "table" and tostring(item.id or "") or ""
        local text = type(item) == "table" and tostring(item.text or "") or ""
        if identifier ~= "" and #identifier <= 128
            and identifier:match("^[A-Za-z0-9_.:-]+$")
            and text ~= "" and not KladManager.Runtime.seen_server[identifier] then
            KladManager.Runtime.seen_server[identifier] = true
            KladManager.Runtime.seen_server_order[#KladManager.Runtime.seen_server_order + 1]
                = identifier
            KladManager.Notify("info", "Сообщение сервера", text:sub(1, 3500), 8.0)
            changed = true
        end
    end
    while #KladManager.Runtime.seen_server_order > 100 do
        local removed = table.remove(KladManager.Runtime.seen_server_order, 1)
        KladManager.Runtime.seen_server[removed] = nil
        changed = true
    end
    if changed then
        KladManager.Settings.notifications.seen_server = table.concat(
            KladManager.Runtime.seen_server_order,
            ","
        )
        KladManager.MarkSettingsDirty()
    end
end

function KladManager.Notify(level, title, text, lifetime)
    local mode = KladManager.Settings.notifications.mode
    local line = tostring(title or "") .. ": " .. tostring(text or "")
    if (mode == "chat" or mode == "both")
        and KladManager.Settings.notifications.chat_messages then
        if isSampAvailable and isSampAvailable() then
            sampAddChatMessage("[KladManager] " .. line, KM_CHAT_COLOR)
        end
    end
    if mode == "custom" or mode == "both" then
        local notifications = KladManager.Notifications
        notifications.next_id = notifications.next_id + 1
        notifications.items[#notifications.items + 1] = {
            id=notifications.next_id,
            level=KladManager.IsChoice(level, {"info","success","warning","error"})
                and level or "info",
            title=tostring(title or ""),
            text=tostring(text or ""),
            created=KladManager.NowMs(),
            lifetime=KladManager.Clamp(tonumber(lifetime) or 5.0, 1.5, 20.0) * 1000,
            paused_at=nil,
            paused_total=0,
            closing=false
        }
        while #notifications.items > notifications.maximum do
            table.remove(notifications.items, 1)
        end
    end
    if KladManager.Settings.notifications.sound and playSound then
        pcall(playSound, 1058)
    end
end

function KladManager.NotificationAnchor(width, total_height)
    local imgui = KladManager.ImGui
    local display = imgui.GetIO().DisplaySize
    local position = KladManager.Settings.notifications.position
    local margin = KladManager.Scaled(16)
    local x = margin
    local y = margin
    if position:find("right", 1, true) then
        x = display.x - width - margin
    elseif position:find("center", 1, true) then
        x = (display.x - width) / 2
    end
    if position:find("bottom", 1, true) then
        y = display.y - total_height - margin
    end
    return x, y
end

function KladManager.RenderNotifications()
    local imgui = KladManager.ImGui
    local items = KladManager.Notifications.items
    if #items == 0 then
        return
    end
    local width = KladManager.Scaled(320)
    local row_height = KladManager.Scaled(82)
    local gap = KladManager.Scaled(8)
    local total_height = #items * row_height + math.max(#items - 1, 0) * gap
    local anchor_x, anchor_y = KladManager.NotificationAnchor(width, total_height)
    local now = KladManager.NowMs()
    for index = #items, 1, -1 do
        local item = items[index]
        local current_pause = item.paused_at and now - item.paused_at or 0
        local elapsed = now - item.created - item.paused_total - current_pause
        if elapsed >= item.lifetime then
            item.closing = true
        end
        local remaining = 1.0 - KladManager.Clamp(elapsed / item.lifetime, 0, 1)
        local animation_target = item.closing and 0.0 or 1.0
        local animation = KladManager.Animate("notification_" .. item.id, animation_target, 11.0)
        if item.closing and animation < 0.03 then
            table.remove(items, index)
        else
            local visual_index = index - 1
            local x = anchor_x + (1.0 - animation) * KladManager.Scaled(32)
            local y = anchor_y + visual_index * (row_height + gap)
            imgui.SetNextWindowPos(imgui.ImVec2(x, y), imgui.Cond.Always)
            imgui.SetNextWindowSize(imgui.ImVec2(width, row_height), imgui.Cond.Always)
            imgui.SetNextWindowBgAlpha(0.96 * animation)
            imgui.PushStyleVarFloat(imgui.StyleVar.WindowRounding, KladManager.Scaled(8))
            imgui.PushStyleVarVec2(imgui.StyleVar.WindowPadding, imgui.ImVec2(
                KladManager.Scaled(12),
                KladManager.Scaled(10)
            ))
            local flags = imgui.WindowFlags.NoTitleBar + imgui.WindowFlags.NoResize
                + imgui.WindowFlags.NoMove + imgui.WindowFlags.NoSavedSettings
                + imgui.WindowFlags.NoNav
            if imgui.Begin("##notification_window_" .. tostring(item.id), nil, flags) then
                local hovered = imgui.IsWindowHovered()
                if hovered and not item.paused_at then
                    item.paused_at = now
                elseif not hovered and item.paused_at then
                    item.paused_total = item.paused_total + now - item.paused_at
                    item.paused_at = nil
                end
                local pushed = KladManager.PushFont("icon")
                imgui.TextColored(
                    KladManager.Vec4(KladManager.NotificationColor(item.level)),
                    KladManager.Icon(KladManager.NotificationIcon(item.level))
                )
                KladManager.PopFont(pushed)
                imgui.SameLine()
                imgui.Text(KladManager.U8(item.title))
                imgui.SameLine(width - KladManager.Scaled(34))
                if KladManager.IconButton(
                    "notification_close_" .. item.id,
                    "ICON_FA_TIMES_CIRCLE",
                    "Закрыть",
                    false
                ) then
                    item.closing = true
                end
                imgui.TextWrapped(KladManager.U8(item.text))
                local start = imgui.GetWindowPos()
                local draw = imgui.GetWindowDrawList()
                draw:AddRectFilled(
                    imgui.ImVec2(start.x, start.y + row_height - KladManager.Scaled(3)),
                    imgui.ImVec2(
                        start.x + width * remaining,
                        start.y + row_height
                    ),
                    KladManager.U32(KladManager.NotificationColor(item.level)),
                    0
                )
            end
            imgui.End()
            imgui.PopStyleVar(2)
        end
    end
end

function KladManager.KeyName(key)
    if KladManager.KeyNames[key] then
        return KladManager.KeyNames[key]
    elseif key >= 0x30 and key <= 0x39 then
        return string.char(key)
    elseif key >= 0x41 and key <= 0x5A then
        return string.char(key)
    end
    return string.format("VK %02X", key)
end

function KladManager.BindConflict(target, key)
    if target ~= "menu_key" and KladManager.Settings.binds.menu_key == key then
        return "Клавиша уже назначена меню"
    elseif target ~= "minimap_key" and KladManager.Settings.binds.minimap_key == key then
        return "Клавиша уже назначена миникарте"
    end
    return nil
end

function KladManager.BeginBindCapture(target)
    KladManager.BindCapture.active = true
    KladManager.BindCapture.target = target
    KladManager.BindCapture.waiting_release = true
    KladManager.BindCapture.conflict = nil
end

function KladManager.BindEditor(id, label, target)
    local imgui = KladManager.ImGui
    local capturing = KladManager.BindCapture.active and KladManager.BindCapture.target == target
    imgui.Text(KladManager.U8(label))
    imgui.SameLine(KladManager.Scaled(180))
    local caption = capturing and "Нажмите клавишу..." or KladManager.KeyName(
        KladManager.Settings.binds[target]
    )
    if KladManager.Button(
        "bind_" .. tostring(id),
        caption,
        nil,
        imgui.ImVec2(KladManager.Scaled(164), 0),
        capturing and "primary" or "secondary",
        false,
        false
    ) then
        KladManager.BeginBindCapture(target)
    end
    if KladManager.BindCapture.conflict and KladManager.BindCapture.target == target then
        KladManager.Tooltip(KladManager.BindCapture.conflict .. ". Выберите другую.")
    else
        KladManager.Tooltip("ESC отменяет захват. Одинаковые клавиши запрещены.")
    end
end

function KladManager.TickBindCapture()
    local capture = KladManager.BindCapture
    if not capture.active then
        return
    end
    if capture.waiting_release then
        for key = 1, 255 do
            if isKeyDown(key) then
                return
            end
        end
        capture.waiting_release = false
        return
    end
    for key = 1, 255 do
        if wasKeyPressed(key) then
            if key == 0x1B then
                capture.active = false
                capture.target = nil
                capture.conflict = nil
                return
            end
            local conflict = KladManager.BindConflict(capture.target, key)
            if conflict then
                capture.conflict = conflict
                return
            end
            KladManager.Settings.binds[capture.target] = key
            capture.active = false
            capture.target = nil
            capture.conflict = nil
            capture.suppress_until = KladManager.NowMs() + 250
            KladManager.MarkSettingsDirty()
            KladManager.Notify("success", "Бинды", "Клавиша сохранена.", 3.0)
            return
        end
    end
end

function KladManager.InputBusy()
    return (sampIsChatInputActive and sampIsChatInputActive())
        or (sampIsDialogActive and sampIsDialogActive())
        or KladManager.BindCapture.active
end

function KladManager.ApplyBind(target, mode, runtime_key)
    local key = KladManager.Settings.binds[target]
    if mode == "hold" then
        KladManager.Runtime[runtime_key] = isKeyDown(key)
    elseif wasKeyPressed(key) then
        KladManager.Runtime[runtime_key] = not KladManager.Runtime[runtime_key]
    end
end

function KladManager.TickBinds()
    if KladManager.InputBusy() then
        if KladManager.Settings.binds.menu_mode == "hold" then
            KladManager.Runtime.menu_open = false
        end
        if KladManager.Settings.binds.minimap_mode == "hold" then
            KladManager.Runtime.minimap_open = false
        end
        return
    end
    if KladManager.NowMs() < (KladManager.BindCapture.suppress_until or 0) then
        return
    end
    if KladManager.Auth.state == "approved" then
        KladManager.ApplyBind("menu_key", KladManager.Settings.binds.menu_mode, "menu_open")
        KladManager.ApplyBind(
            "minimap_key",
            KladManager.Settings.binds.minimap_mode,
            "minimap_open"
        )
    else
        if KladManager.Settings.binds.menu_mode == "hold" then
            KladManager.Runtime.auth_open = isKeyDown(KladManager.Settings.binds.menu_key)
        elseif wasKeyPressed(KladManager.Settings.binds.menu_key) then
            KladManager.Runtime.auth_open = not KladManager.Runtime.auth_open
        end
        KladManager.Runtime.menu_open = false
        KladManager.Runtime.minimap_open = false
    end
end

function KladManager.LoadMapTexture()
    local cache = KladManager.TextureCache
    if cache.map or cache.map_attempted then
        return cache.map
    end
    cache.map_attempted = true
    local path = KM_IMAGES .. "\\Map.jpg"
    if not KM_FILE_EXISTS(path) then
        KladManager.Runtime.texture_error = "Map.jpg отсутствует"
        return nil
    end
    local ok, texture = pcall(KladManager.ImGui.CreateTextureFromFile, path)
    if ok and texture then
        cache.map = texture
        cache.count = cache.count + 1
        return texture
    end
    KladManager.Runtime.texture_error = tostring(texture or "Map.jpg не загружена")
    return nil
end

function KladManager.LoadAtlasTexture()
    local cache = KladManager.TextureCache
    if cache.atlas or cache.atlas_attempted then
        return cache.atlas
    end
    cache.atlas_attempted = true
    local path = KM_ITEMS .. "\\items_atlas.png"
    if not KM_FILE_EXISTS(path) then
        KladManager.Diagnostics.last_error = "Atlas: файл отсутствует"
        return nil
    end
    local ok, texture = pcall(KladManager.ImGui.CreateTextureFromFile, path)
    if ok and texture then
        cache.atlas = texture
        cache.count = cache.count + 1
        return texture
    end
    KladManager.Diagnostics.last_error = "Atlas: " .. tostring(texture or "ошибка")
    return nil
end

function KladManager.LoadItemIcons()
    if KladManager.ItemIcons.loaded then
        return true
    end
    local payload = KM_READ(KM_ITEMS .. "\\icons.json")
    if not payload then
        KladManager.ItemIcons.error = "icons.json отсутствует"
        return false
    end
    local ok, decoded = pcall(KladManager.Json.decode, payload)
    if not ok or type(decoded) ~= "table" or type(decoded.items) ~= "table" then
        KladManager.ItemIcons.error = "icons.json повреждён"
        return false
    end
    decoded = KladManager.FromUtf8Data(decoded)
    KladManager.ItemIcons.settings =
        type(decoded.settings) == "table" and decoded.settings or {icon_size=100,max_columns=30}
    KladManager.ItemIcons.items = decoded.items
    KladManager.ItemIcons.by_norm = {}
    KladManager.ItemIcons.atlas_max = {}
    for name, item in pairs(decoded.items) do
        if type(item) == "table" then
            KladManager.ItemIcons.by_norm[KladManager.NormalizeItemName(name)] = item
            local atlas = tonumber(item.atlas) or 0
            local index = tonumber(item.index) or 0
            KladManager.ItemIcons.atlas_max[atlas] = math.max(
                tonumber(KladManager.ItemIcons.atlas_max[atlas]) or 0,
                index
            )
        end
    end
    KladManager.ItemIcons.loaded = true
    return true
end

function KladManager.AtlasUv(item_name)
    if not KladManager.LoadItemIcons() then
        return nil
    end
    local entry = KladManager.ItemIcons.items[tostring(item_name or "")]
    if type(entry) ~= "table" then
        entry = KladManager.ItemIcons.by_norm[KladManager.NormalizeItemName(item_name)]
    end
    if type(entry) ~= "table" then
        return nil
    end
    local atlas = tonumber(entry.atlas) or 0
    local index = tonumber(entry.index) or 0
    local max_columns = math.max(
        1,
        tonumber(KladManager.ItemIcons.settings.max_columns) or 30
    )
    local max_index = tonumber(KladManager.ItemIcons.atlas_max[atlas]) or index
    local columns = math.max(1, math.min(max_columns, max_index + 1))
    local rows = math.max(1, math.ceil((max_index + 1) / max_columns))
    local column = index % max_columns
    local row = math.floor(index / max_columns)
    return {
        atlas=atlas,
        uv0=KladManager.ImGui.ImVec2(column / columns, row / rows),
        uv1=KladManager.ImGui.ImVec2((column + 1) / columns, (row + 1) / rows)
    }
end

function KladManager.MapPointInside(x, y, origin, size)
    return x >= origin.x and x <= origin.x + size.x
        and y >= origin.y and y <= origin.y + size.y
end

function KladManager.MapColor(red, green, blue, alpha)
    return KladManager.ImGui.GetColorU32Vec4(KladManager.ImGui.ImVec4(
        red,
        green,
        blue,
        alpha or 1.0
    ))
end

function KladManager.RainbowColor()
    local phase = KladManager.NowMs() / 900
    return KladManager.MapColor(
        0.5 + 0.5 * math.sin(phase),
        0.5 + 0.5 * math.sin(phase + 2.094),
        0.5 + 0.5 * math.sin(phase + 4.188),
        1.0
    )
end

function KladManager.DrawGiftMarker(draw, x, y)
    local imgui = KladManager.ImGui
    local scale = KladManager.Scale()
    local orange = KladManager.MapColor(1.0, 0.42, 0.08, 1.0)
    local ribbon = KladManager.MapColor(0.38, 0.12, 0.02, 1.0)
    draw:AddRectFilled(
        imgui.ImVec2(x - 5 * scale, y - 1 * scale),
        imgui.ImVec2(x + 5 * scale, y + 6 * scale),
        orange,
        1.5 * scale
    )
    draw:AddRectFilled(
        imgui.ImVec2(x - 6 * scale, y - 4 * scale),
        imgui.ImVec2(x + 6 * scale, y - 1 * scale),
        orange,
        1.5 * scale
    )
    draw:AddRectFilled(
        imgui.ImVec2(x - 1 * scale, y - 4 * scale),
        imgui.ImVec2(x + 1 * scale, y + 6 * scale),
        ribbon,
        0
    )
    draw:AddCircle(
        imgui.ImVec2(x - 3 * scale, y - 5 * scale),
        2.5 * scale,
        orange,
        12,
        1.5 * scale
    )
    draw:AddCircle(
        imgui.ImVec2(x + 3 * scale, y - 5 * scale),
        2.5 * scale,
        orange,
        12,
        1.5 * scale
    )
end

function KladManager.MapHoverCandidate(current, mouse, map_x, map_y, payload)
    local dx = mouse.x - map_x
    local dy = mouse.y - map_y
    local distance = math.sqrt(dx * dx + dy * dy)
    if distance <= KladManager.Scaled(10)
        and (not current or distance < current.distance) then
        payload.distance = distance
        return payload
    end
    return current
end

function KladManager.DrawMapZone(draw, zone, origin, size, zoom, color, width)
    if type(zone) ~= "table" then
        return
    end
    local left, top = KladManager.WorldToMap(
        math.min(tonumber(zone.left) or 0, tonumber(zone.right) or 0),
        math.max(tonumber(zone.up) or 0, tonumber(zone.down) or 0),
        origin,
        size,
        zoom
    )
    local right, bottom = KladManager.WorldToMap(
        math.max(tonumber(zone.left) or 0, tonumber(zone.right) or 0),
        math.min(tonumber(zone.up) or 0, tonumber(zone.down) or 0),
        origin,
        size,
        zoom
    )
    draw:AddRect(
        KladManager.ImGui.ImVec2(left, top),
        KladManager.ImGui.ImVec2(right, bottom),
        color,
        0,
        0,
        width or KladManager.Scaled(2)
    )
end

function KladManager.PointInZone(position, zone)
    if not KladManager.ValidPosition(position) or type(zone) ~= "table" then
        return false
    end
    local minimum_x = math.min(tonumber(zone.left) or 0, tonumber(zone.right) or 0)
    local maximum_x = math.max(tonumber(zone.left) or 0, tonumber(zone.right) or 0)
    local minimum_y = math.min(tonumber(zone.down) or 0, tonumber(zone.up) or 0)
    local maximum_y = math.max(tonumber(zone.down) or 0, tonumber(zone.up) or 0)
    return position.x >= minimum_x and position.x <= maximum_x
        and position.y >= minimum_y and position.y <= maximum_y
end

function KladManager.ParseIsoTimestamp(value)
    local year, month, day, hour, minute, second = tostring(value or ""):match(
        "^(%d%d%d%d)%-(%d%d)%-(%d%d)T(%d%d):(%d%d):(%d%d)"
    )
    if not year then
        return nil
    end
    return os.time({
        year=tonumber(year),
        month=tonumber(month),
        day=tonumber(day),
        hour=tonumber(hour),
        min=tonumber(minute),
        sec=tonumber(second)
    })
end

function KladManager.LocalMarkerVisible(item)
    if type(item) ~= "table" then
        return false
    end
    local current_server = KladManager.ServerContext()
    local item_server = type(item.server) == "table" and item.server.key or nil
    if item_server and item_server ~= current_server.key then
        return false
    end
    local player = KladManager.PlayerContext()
    if item.world ~= nil and tonumber(item.world) ~= tonumber(player.world) then
        return false
    end
    if item.interior ~= nil
        and tonumber(item.interior) ~= tonumber(player.interior) then
        return false
    end
    return true
end

function KladManager.ClusterVisibleOnMap(cluster)
    local position = type(cluster) == "table" and cluster.position or nil
    if not KladManager.ValidPosition(position) then
        return false
    end
    local player = KladManager.PlayerContext()
    if tonumber(cluster.world or 0) ~= tonumber(player.world or 0)
        or tonumber(cluster.interior or 0) ~= tonumber(player.interior or 0) then
        return false
    end
    local seen_at = KladManager.ParseIsoTimestamp(cluster.last_seen_at)
    local months = tonumber(KladManager.Settings.map.months) or 3
    if seen_at and os.time() - seen_at > months * 31 * 86400 then
        return false
    end
    if KladManager.Settings.map.inside_zone then
        local zone = KladManager.Gameplay.zone_intersection
            or KladManager.WhiteZone
            or KladManager.Zones[1]
        return zone ~= nil and KladManager.PointInZone(position, zone)
    end
    return true
end

function KladManager.SetMapWaypoint(x, y, z)
    if setTargetBlipCoordinates then
        setTargetBlipCoordinates(x, y, tonumber(z) or 0)
        KladManager.Notify(
            "success",
            "Карта",
            string.format("Метка: %.1f, %.1f", x, y),
            3.0
        )
        return true
    end
    KladManager.Notify("warning", "Карта", "Игровой waypoint недоступен.", 4.0)
    return false
end

function KladManager.RenderMap(id, size, preview)
    local imgui = KladManager.ImGui
    local origin = imgui.GetCursorScreenPos()
    local texture = KladManager.LoadMapTexture()
    local zoom = KladManager.Settings.map.minimap_zoom
    local half = 0.5 / zoom
    local center_x = KladManager.Settings.map.map_center_x
    local center_y = KladManager.Settings.map.map_center_y
    if texture then
        imgui.Image(
            texture,
            size,
            imgui.ImVec2(center_x - half, center_y - half),
            imgui.ImVec2(center_x + half, center_y + half)
        )
    else
        imgui.InvisibleButton("##map_missing_" .. tostring(id), size)
        local draw_missing = imgui.GetWindowDrawList()
        draw_missing:AddRectFilled(
            origin,
            imgui.ImVec2(origin.x + size.x, origin.y + size.y),
            KladManager.U32("surface1"),
            KladManager.Scaled(6)
        )
        draw_missing:AddText(
            imgui.ImVec2(origin.x + 12, origin.y + 12),
            KladManager.U32("danger"),
            KladManager.U8(KladManager.Runtime.texture_error or "Карта недоступна")
        )
    end
    local hovered = imgui.IsItemHovered()
    local draw = imgui.GetWindowDrawList()
    local mouse = imgui.GetIO().MousePos
    local marker_hover = nil
    draw:PushClipRect(
        origin,
        imgui.ImVec2(origin.x + size.x, origin.y + size.y),
        true
    )
    if KladManager.Settings.map.zones then
        for index, zone in ipairs(KladManager.Zones) do
            KladManager.DrawMapZone(
                draw,
                zone,
                origin,
                size,
                zoom,
                KladManager.MapColor(0.95, 0.30, 0.22, index == 1 and 0.95 or 0.52),
                KladManager.Scaled(index == 1 and 2.5 or 1.5)
            )
        end
        if KladManager.Gameplay.zone_intersection then
            KladManager.DrawMapZone(
                draw,
                KladManager.Gameplay.zone_intersection,
                origin,
                size,
                zoom,
                KladManager.MapColor(1.0, 1.0, 1.0, 0.95),
                KladManager.Scaled(3)
            )
        end
    end
    if KladManager.Settings.map.layer_white_zone
        and KladManager.WhiteZone then
        KladManager.DrawMapZone(
            draw,
            KladManager.WhiteZone,
            origin,
            size,
            zoom,
            KladManager.MapColor(1.0, 1.0, 1.0, 1.0),
            KladManager.Scaled(2.5)
        )
    end
    if KladManager.Settings.map.layer_treasures then
        for _, cluster in ipairs(KladManager.ServerClusters) do
            local position = cluster.position
            if KladManager.ClusterVisibleOnMap(cluster) then
                local map_x, map_y = KladManager.WorldToMap(
                    position.x,
                    position.y,
                    origin,
                    size,
                    zoom
                )
                if KladManager.MapPointInside(map_x, map_y, origin, size) then
                    draw:AddCircleFilled(
                        imgui.ImVec2(map_x, map_y),
                        KladManager.Scaled(4),
                        KladManager.MapColor(
                            KladManager.Settings.map.popular
                                and tonumber(cluster.observation_count or 0) >= 5
                                and 1.0 or 0.25,
                            KladManager.Settings.map.popular
                                and tonumber(cluster.observation_count or 0) >= 5
                                and 0.72 or 0.85,
                            KladManager.Settings.map.popular
                                and tonumber(cluster.observation_count or 0) >= 5
                                and 0.12 or 0.55,
                            0.95
                        )
                    )
                    if KladManager.Settings.map.popular
                        and tonumber(cluster.observation_count or 0) >= 5 then
                        draw:AddCircle(
                            imgui.ImVec2(map_x, map_y),
                            KladManager.Scaled(7),
                            KladManager.MapColor(1.0, 0.72, 0.12, 0.92),
                            18,
                            KladManager.Scaled(1.5)
                        )
                    end
                    marker_hover = KladManager.MapHoverCandidate(
                        marker_hover,
                        mouse,
                        map_x,
                        map_y,
                        {
                            kind="server",
                            position=position,
                            text=string.format(
                                "Проверенная точка\n%.1f, %.1f, %.1f\nДоверие %.0f%%",
                                position.x,
                                position.y,
                                position.z,
                                (tonumber(cluster.confidence) or 0) * 100
                            )
                        }
                    )
                end
            end
        end
    end
    if KladManager.Settings.map.layer_spawns then
        for index, spawn in ipairs(KladManager.ActiveSpawns) do
            local position = spawn.position
            if not spawn.missing and KladManager.ValidPosition(position)
                and KladManager.LocalMarkerVisible(spawn) then
                local map_x, map_y = KladManager.WorldToMap(
                    position.x,
                    position.y,
                    origin,
                    size,
                    zoom
                )
                if KladManager.MapPointInside(map_x, map_y, origin, size) then
                    draw:AddRectFilled(
                        imgui.ImVec2(map_x - KladManager.Scaled(4), map_y - KladManager.Scaled(4)),
                        imgui.ImVec2(map_x + KladManager.Scaled(4), map_y + KladManager.Scaled(4)),
                        KladManager.MapColor(0.30, 0.58, 0.95, 0.95),
                        KladManager.Scaled(2)
                    )
                    marker_hover = KladManager.MapHoverCandidate(
                        marker_hover,
                        mouse,
                        map_x,
                        map_y,
                        {
                            kind="spawn",
                            index=index,
                            position=position,
                            text=tostring(spawn.display or "Спавн")
                                .. string.format("\n%.1f, %.1f, %.1f", position.x, position.y, position.z)
                        }
                    )
                end
            end
        end
    end
    local player_position = KladManager.CurrentPosition()
    local nearest_dopka = nil
    local nearest_distance = math.huge
    if player_position then
        for index, item in ipairs(KladManager.Dopkas) do
            if KladManager.ValidPosition(item.position)
                and KladManager.LocalMarkerVisible(item) then
                local distance = KladManager.Distance3D(player_position, item.position)
                if distance < nearest_distance then
                    nearest_distance = distance
                    nearest_dopka = index
                end
            end
        end
    end
    if KladManager.Settings.map.layer_dopkas then
        for index, item in ipairs(KladManager.Dopkas) do
            local position = item.position
            if KladManager.ValidPosition(position)
                and KladManager.LocalMarkerVisible(item) then
                local map_x, map_y = KladManager.WorldToMap(
                    position.x,
                    position.y,
                    origin,
                    size,
                    zoom
                )
                if KladManager.MapPointInside(map_x, map_y, origin, size) then
                    KladManager.DrawGiftMarker(draw, map_x, map_y)
                    if index == nearest_dopka then
                        draw:AddCircle(
                            imgui.ImVec2(map_x, map_y),
                            KladManager.Scaled(8),
                            KladManager.RainbowColor(),
                            24,
                            KladManager.Scaled(2.5)
                        )
                    end
                    marker_hover = KladManager.MapHoverCandidate(
                        marker_hover,
                        mouse,
                        map_x,
                        map_y,
                        {
                            kind="dopka",
                            index=index,
                            position=position,
                            text="Допка"
                                .. (index == nearest_dopka
                                    and string.format("\nБлижайшая: %.1f м", nearest_distance)
                                    or "")
                                .. string.format("\n%.1f, %.1f, %.1f", position.x, position.y, position.z)
                        }
                    )
                end
            end
        end
    end
    if KladManager.Settings.map.layer_player and player_position then
        local map_x, map_y = KladManager.WorldToMap(
            player_position.x,
            player_position.y,
            origin,
            size,
            zoom
        )
        if KladManager.MapPointInside(map_x, map_y, origin, size) then
            draw:AddCircleFilled(
                imgui.ImVec2(map_x, map_y),
                KladManager.Scaled(5),
                KladManager.MapColor(1.0, 1.0, 1.0, 1.0)
            )
            draw:AddCircle(
                imgui.ImVec2(map_x, map_y),
                KladManager.Scaled(6),
                KladManager.MapColor(0.1, 0.1, 0.1, 1.0),
                16,
                KladManager.Scaled(1)
            )
            KladManager.Runtime.player_position = player_position
        end
    end
    draw:PopClipRect()
    draw:AddRect(
        origin,
        imgui.ImVec2(origin.x + size.x, origin.y + size.y),
        KladManager.U32("border"),
        KladManager.Scaled(6),
        0,
        KladManager.Settings.map.line_width
    )
    local interactive = not preview
        and (tostring(id) ~= "live" or KladManager.Gameplay.minimap_edit)
    if hovered and marker_hover then
        imgui.SetTooltip(KladManager.U8(marker_hover.text))
    end
    if interactive and hovered then
        local io = imgui.GetIO()
        if tonumber(io.MouseWheel) ~= 0 then
            KladManager.Settings.map.minimap_zoom = KladManager.Clamp(
                zoom + tonumber(io.MouseWheel) * 0.15,
                0.5,
                4.0
            )
            KladManager.Buffers.minimap_zoom[0] =
                KladManager.Settings.map.minimap_zoom
            KladManager.MarkSettingsDirty()
        end
        if imgui.IsMouseDragging(0, KladManager.Scaled(4)) then
            local delta = io.MouseDelta
            KladManager.Gameplay.map_dragging = true
            KladManager.Settings.map.map_center_x = KladManager.Clamp(
                KladManager.Settings.map.map_center_x
                    - delta.x / math.max(size.x * zoom, 1),
                0,
                1
            )
            KladManager.Settings.map.map_center_y = KladManager.Clamp(
                KladManager.Settings.map.map_center_y
                    - delta.y / math.max(size.y * zoom, 1),
                0,
                1
            )
            KladManager.MarkSettingsDirty()
        elseif imgui.IsMouseReleased(0) then
            if not KladManager.Gameplay.map_dragging then
                local world_x, world_y = KladManager.MapToWorld(
                    mouse.x,
                    mouse.y,
                    origin,
                    size,
                    zoom
                )
                KladManager.SetMapWaypoint(
                    world_x,
                    world_y,
                    marker_hover and marker_hover.position.z or 0
                )
            end
            KladManager.Gameplay.map_dragging = false
        end
        if imgui.IsMouseClicked(1) and marker_hover
            and marker_hover.kind == "dopka" then
            KladManager.DeleteDopka(marker_hover.index)
        end
    elseif not imgui.IsMouseDown(0) then
        KladManager.Gameplay.map_dragging = false
    end
end

function KladManager.MinimapPosition(size)
    local display = KladManager.ImGui.GetIO().DisplaySize
    local margin = KladManager.Scaled(18)
    local position = KladManager.Settings.map.minimap_position
    local x = margin
    local y = margin
    if position:find("right", 1, true) then
        x = display.x - size - margin
    end
    if position:find("bottom", 1, true) then
        y = display.y - size - margin
    end
    return x, y
end

function KladManager.RenderMinimapWindow()
    local imgui = KladManager.ImGui
    local size = KladManager.Settings.map.minimap_size
    local x, y = KladManager.MinimapPosition(size)
    if KladManager.Settings.map.minimap_position ~= "custom" then
        imgui.SetNextWindowPos(imgui.ImVec2(x, y), imgui.Cond.Always)
    end
    imgui.SetNextWindowSize(imgui.ImVec2(size, size), imgui.Cond.Always)
    imgui.SetNextWindowBgAlpha(KladManager.Settings.map.minimap_opacity)
    imgui.PushStyleVarVec2(imgui.StyleVar.WindowPadding, imgui.ImVec2(0, 0))
    imgui.PushStyleVarFloat(
        imgui.StyleVar.Alpha,
        KladManager.Settings.map.minimap_opacity
    )
    local flags = imgui.WindowFlags.NoTitleBar + imgui.WindowFlags.NoCollapse
        + imgui.WindowFlags.NoScrollbar
    if KladManager.Settings.map.minimap_position ~= "custom" then
        flags = flags + imgui.WindowFlags.NoMove + imgui.WindowFlags.NoResize
            + imgui.WindowFlags.NoSavedSettings
    end
    if not KladManager.Gameplay.minimap_edit then
        flags = flags + imgui.WindowFlags.NoInputs
    end
    if imgui.Begin("##KladManagerMinimap", nil, flags) then
        KladManager.RenderMap(
            "live",
            imgui.ImVec2(imgui.GetContentRegionAvail().x, imgui.GetContentRegionAvail().y),
            false
        )
    end
    imgui.End()
    imgui.PopStyleVar(2)
end

function KladManager.ReleaseTextures()
    if KladManager.TextureCache.map then
        pcall(KladManager.ImGui.ReleaseTexture, KladManager.TextureCache.map)
        KladManager.TextureCache.map = nil
        KladManager.TextureCache.count = 0
    end
    if KladManager.TextureCache.atlas then
        pcall(KladManager.ImGui.ReleaseTexture, KladManager.TextureCache.atlas)
        KladManager.TextureCache.atlas = nil
        KladManager.TextureCache.count = math.max(KladManager.TextureCache.count - 1, 0)
    end
end

function KladManager.OpenUrl(url)
    local value = tostring(url or "")
    if not KM_IS_HTTPS(value) or value:find("'", 1, true)
        or value:find("\\", 1, true) then
        KladManager.Notify("error", "Ссылка", "Небезопасный адрес заблокирован.", 4.0)
        return false
    end
    local payload = "window.cef.Open('" .. value .. "', 1);"
    local stream = raknetNewBitStream()
    if not stream then
        KladManager.Notify("error", "Ссылка", "CEF браузер недоступен.", 4.0)
        return false
    end
    raknetBitStreamWriteInt8(stream, 17)
    raknetBitStreamWriteInt32(stream, 0)
    raknetBitStreamWriteInt16(stream, #payload)
    raknetBitStreamWriteInt8(stream, 0)
    raknetBitStreamWriteString(stream, payload)
    raknetEmulPacketReceiveBitStream(220, stream)
    raknetDeleteBitStream(stream)
    return true
end

function KladManager.ResolveTextFontPath()
    local custom = tostring(KladManager.Settings.ui.font_path or "")
    if custom ~= "" and doesFileExist(custom) then
        return custom
    end
    local bundled = getFolderPath(0x14) .. "\\trebucbd.ttf"
    if doesFileExist(bundled) then
        return bundled
    end
    return nil
end

function KladManager.InstallTextFont(size)
    local imgui = KladManager.ImGui
    local io = imgui.GetIO()
    local path = KladManager.ResolveTextFontPath()
    if path then
        local ok, font = pcall(
            io.Fonts.AddFontFromFileTTF,
            io.Fonts,
            path,
            size,
            nil,
            io.Fonts:GetGlyphRangesCyrillic()
        )
        if ok and font then
            KladManager.Fonts.text_path = path
            return font
        end
    end
    return io.Fonts:AddFontDefault()
end

function KladManager.InstallIconFont(size)
    local imgui = KladManager.ImGui
    local io = imgui.GetIO()
    local config = imgui.ImFontConfig()
    config.MergeMode = false
    config.PixelSnapH = true
    local ranges = imgui.new.ImWchar[3](
        KladManager.fa.min_range,
        KladManager.fa.max_range,
        0
    )
    local ok, font = pcall(
        io.Fonts.AddFontFromMemoryCompressedBase85TTF,
        io.Fonts,
        KladManager.fa.get_font_data_base85(),
        size,
        config,
        ranges
    )
    return ok and font or nil
end

function KladManager.SetupFonts()
    local imgui = KladManager.ImGui
    local sizes = {
        small=12.0,
        medium=14.0,
        large=16.0
    }
    for name, size in pairs(sizes) do
        KladManager.Fonts["text_" .. name] = KladManager.InstallTextFont(size)
        KladManager.Fonts["icon_" .. name] = KladManager.InstallIconFont(size)
    end
end

function KladManager.ApplyStyle()
    local imgui = KladManager.ImGui
    local style = imgui.GetStyle()
    style.WindowRounding = KladManager.Scaled(10)
    style.ChildRounding = KladManager.Scaled(7)
    style.FrameRounding = KladManager.Scaled(6)
    style.PopupRounding = KladManager.Scaled(8)
    style.ScrollbarRounding = KladManager.Scaled(8)
    style.WindowPadding = imgui.ImVec2(KladManager.Scaled(12), KladManager.Scaled(12))
    style.FramePadding = imgui.ImVec2(KladManager.Scaled(10), KladManager.Scaled(7))
    style.ItemSpacing = imgui.ImVec2(KladManager.Scaled(8), KladManager.Scaled(7))
    style.Colors[imgui.Col.WindowBg] = KladManager.Vec4("bg1")
    style.Colors[imgui.Col.ChildBg] = KladManager.Vec4("bg1")
    style.Colors[imgui.Col.PopupBg] = KladManager.Vec4("surface1")
    style.Colors[imgui.Col.Border] = KladManager.Vec4("border")
    style.Colors[imgui.Col.Text] = KladManager.Vec4("text1")
    style.Colors[imgui.Col.TextDisabled] = KladManager.Vec4("text3")
    style.Colors[imgui.Col.FrameBg] = KladManager.Vec4("surface2")
    style.Colors[imgui.Col.FrameBgHovered] = KladManager.Vec4("surface3")
    style.Colors[imgui.Col.FrameBgActive] = KladManager.Vec4("surface3")
    style.Colors[imgui.Col.Button] = KladManager.Vec4("surface2")
    style.Colors[imgui.Col.ButtonHovered] = KladManager.Vec4("surface3")
    style.Colors[imgui.Col.ButtonActive] = KladManager.Vec4("accent_soft")
    style.Colors[imgui.Col.Header] = KladManager.Vec4("accent_soft")
    style.Colors[imgui.Col.HeaderHovered] = KladManager.Vec4("surface3")
    style.Colors[imgui.Col.CheckMark] = KladManager.Vec4("accent_hover")
    style.Colors[imgui.Col.SliderGrab] = KladManager.Vec4("accent")
    style.Colors[imgui.Col.SliderGrabActive] = KladManager.Vec4("accent_hover")
end

function KladManager.TabAvailable(tab)
    if not tab.flag then
        return true
    end
    if tab.id == "dopkas" or tab.id == "spawns" or tab.id == "zones" then
        return KladManager.StageCapabilities.stage07
            and KladManager.DevelopmentFeatures[tab.flag] == true
    end
    return KladManager.StageCapabilities.stage08
        and KladManager.DevelopmentFeatures[tab.flag] == true
end

function KladManager.AnimatedTab(tab)
    local imgui = KladManager.ImGui
    local scale = KladManager.Scale()
    local width = imgui.GetContentRegionAvail().x
    local height = 40 * scale
    local origin = imgui.GetCursorScreenPos()
    local active = KladManager.Runtime.active_tab == tab.id
    local clicked = imgui.InvisibleButton(
        "##tab_" .. tab.id,
        imgui.ImVec2(width, height)
    )
    local hovered = imgui.IsItemHovered()
    local fill = KladManager.Animate(
        "tab_fill_" .. tab.id,
        active and 1.0 or hovered and 0.42 or 0.0,
        14.0
    )
    local draw = imgui.GetWindowDrawList()
    if fill > 0.01 then
        draw:AddRectFilled(
            origin,
            imgui.ImVec2(origin.x + width * fill, origin.y + height),
            KladManager.U32(active and "accent_soft" or "surface2"),
            6 * scale
        )
    end
    if active then
        draw:AddRectFilled(
            origin,
            imgui.ImVec2(origin.x + 3 * scale, origin.y + height),
            KladManager.U32("accent"),
            2 * scale
        )
    end
    imgui.SetCursorScreenPos(imgui.ImVec2(origin.x + 13 * scale, origin.y + 10 * scale))
    local icon_pushed = KladManager.PushFont("icon")
    imgui.TextColored(
        KladManager.Vec4(active and "accent_hover" or "text2"),
        KladManager.Icon(tab.icon)
    )
    KladManager.PopFont(icon_pushed)
    imgui.SameLine(0, 10 * scale)
    local text_pushed = KladManager.PushFont("text")
    imgui.TextColored(
        KladManager.Vec4(active and "text1" or "text2"),
        KladManager.U8(tab.label)
    )
    KladManager.PopFont(text_pushed)
    imgui.SetCursorScreenPos(imgui.ImVec2(origin.x, origin.y + height + 4 * scale))
    return clicked
end

function KladManager.ProfileValue(label, value)
    local imgui = KladManager.ImGui
    imgui.TextColored(KladManager.Vec4("text3"), KladManager.U8(label))
    imgui.SameLine(KladManager.Scaled(118))
    imgui.TextWrapped(KladManager.U8(value or "—"))
end

function KladManager.RenderProfilePopup()
    local imgui = KladManager.ImGui
    if imgui.BeginPopup("KladManagerProfilePopup") then
        local profile = KladManager.Auth.profile or {}
        imgui.Text(KladManager.U8(tostring(profile.username or "Профиль")))
        imgui.Separator()
        KladManager.ProfileValue("Тариф", profile.plan)
        KladManager.ProfileValue("Действует до", profile.expires_at)
        local purchase = type(profile.last_purchase) == "table" and profile.last_purchase or {}
        local purchase_text = purchase.at
            and tostring(purchase.plan or "покупка") .. " · "
                .. tostring(purchase.channel or "канал") .. " · " .. tostring(purchase.at)
            or "—"
        KladManager.ProfileValue("Последняя покупка", purchase_text)
        local hwid = type(profile.hwid) == "table" and profile.hwid or {}
        KladManager.ProfileValue("Компьютер", hwid.state or "не привязан")
        local stats = type(profile.stats) == "table" and profile.stats or {}
        KladManager.ProfileValue(
            "Находки",
            tostring((stats.treasures or 0) + (stats.chests or 0))
        )
        KladManager.ProfileValue("Предметы", tostring(stats.items_count or 0))
        KladManager.ProfileValue(
            "Заработано",
            KladManager.FormatGameMoney(stats.earnings or 0)
        )
        KladManager.ProfileValue("Рейтинг", tostring(stats.rating_points or 0))
        local rating = type(profile.rating) == "table" and profile.rating or {}
        KladManager.ProfileValue(
            "Неделя",
            tostring(rating.weekly_points or 0) .. " очк."
                .. (rating.weekly_place and " · место " .. tostring(rating.weekly_place) or "")
        )
        local achievements =
            type(profile.achievements) == "table" and profile.achievements or {}
        KladManager.ProfileValue("Достижения", tostring(#achievements))
        if #achievements > 0 and imgui.TreeNodeStr(KladManager.U8("Открытые достижения")) then
            for _, achievement in ipairs(achievements) do
                imgui.BulletText(KladManager.U8(tostring(achievement.name or achievement.code)))
            end
            imgui.TreePop()
        end
        imgui.Separator()
        if KladManager.Button(
            "profile_cabinet",
            "Открыть кабинет",
            "ICON_FA_EXTERNAL_LINK_ALT",
            imgui.ImVec2(-1, 0),
            "secondary",
            not KM_IS_HTTPS(KladManager.CabinetUrl or ""),
            false
        ) then
            KladManager.OpenUrl(KladManager.CabinetUrl)
        end
        if KladManager.Button(
            "profile_hwid",
            "Запросить сброс HWID",
            "ICON_FA_KEY",
            imgui.ImVec2(-1, 0),
            "secondary",
            not KM_IS_HTTPS(KladManager.HwidRequestUrl or "")
                or hwid.state == "reset_pending",
            false
        ) then
            KladManager.OpenUrl(KladManager.HwidRequestUrl)
        end
        if KladManager.Button(
            "profile_logout",
            "Выйти из Lua-сессии",
            "ICON_FA_SIGN_OUT_ALT",
            imgui.ImVec2(-1, 0),
            "danger",
            KladManager.Auth.busy,
            false
        ) then
            KladManager.Logout()
            imgui.CloseCurrentPopup()
        end
        imgui.EndPopup()
    end
end

function KladManager.RenderSidebar()
    local imgui = KladManager.ImGui
    local scale = KladManager.Scale()
    imgui.PushStyleColor(imgui.Col.ChildBg, KladManager.Vec4("surface1"))
    imgui.BeginChild(
        "##KladManagerSidebar",
        imgui.ImVec2(178 * scale, -1),
        false,
        imgui.WindowFlags.NoScrollbar
    )
    imgui.SetCursorPos(imgui.ImVec2(14 * scale, 15 * scale))
    imgui.TextColored(KladManager.Vec4("accent_hover"), "KLAD")
    imgui.SameLine(0, 4 * scale)
    imgui.Text("MANAGER")
    imgui.TextColored(
        KladManager.Vec4("text3"),
        KladManager.U8("Версия " .. KM_VERSION)
    )
    imgui.Dummy(imgui.ImVec2(0, 11 * scale))
    for _, tab in ipairs(KladManager.Tabs) do
        if KladManager.TabAvailable(tab) and KladManager.AnimatedTab(tab) then
            KladManager.Runtime.active_tab = tab.id
            KladManager.Runtime.tab_alpha = 0.0
        end
    end
    local available = imgui.GetContentRegionAvail().y
    if available > 74 * scale then
        imgui.SetCursorPosY(imgui.GetCursorPosY() + available - 70 * scale)
    end
    local profile = KladManager.Auth.profile or {}
    if KladManager.Button(
        "profile_card",
        tostring(profile.username or "Профиль") .. "\n"
            .. tostring(profile.expires_at or "нет подписки"),
        "ICON_FA_USER",
        imgui.ImVec2(-1, 58 * scale),
        "secondary",
        false,
        false
    ) then
        imgui.OpenPopup("KladManagerProfilePopup")
    end
    KladManager.RenderProfilePopup()
    imgui.EndChild()
    imgui.PopStyleColor()
end

function KladManager.SettingCheckbox(id, label, section, key, disabled)
    local changed, value = KladManager.Checkbox(
        id,
        label,
        KladManager.Settings[section][key],
        disabled
    )
    if changed then
        KladManager.Settings[section][key] = value
        KladManager.MarkSettingsDirty()
    end
end

function KladManager.SectionTitle(title, text)
    local imgui = KladManager.ImGui
    imgui.Text(KladManager.U8(title))
    if text and text ~= "" then
        imgui.TextColored(KladManager.Vec4("text3"), KladManager.U8(text))
    end
    imgui.Separator()
end

function KladManager.RenderDiagnostics()
    local imgui = KladManager.ImGui
    local session = KladManager.Auth.session
    KladManager.ListRow(
        "diag_auth",
        "Авторизация",
        "Состояние: " .. tostring(KladManager.Auth.state),
        session and "сессия активна" or "без сессии"
    )
    KladManager.ListRow(
        "diag_api",
        "API и очередь",
        "Задержка " .. tostring(KladManager.Diagnostics.api_latency_ms)
            .. " мс, очередь " .. tostring(#KladManager.Network.queue)
            .. ", активно " .. tostring(#KladManager.Network.active),
        KladManager.ApiBaseUrl == "" and "не настроен" or "HTTPS"
    )
    KladManager.ListRow(
        "diag_cache",
        "Кэш и сервер",
        "Сервер: " .. tostring(KladManager.Runtime.server)
            .. ", возраст кэша: " .. (
                KladManager.Runtime.cache_received_at
                    and tostring(math.floor(
                        (KladManager.NowMs() - KladManager.Runtime.cache_received_at) / 1000
                    )) .. " с"
                    or "нет"
            ),
        "текстур " .. tostring(KladManager.TextureCache.count)
    )
    KladManager.ListRow(
        "diag_runtime",
        "Клиент",
        "Protocol " .. tostring(KM_PROTOCOL_VERSION)
            .. ", libs " .. tostring(KladManager.Runtime.libs_version)
            .. ", FPS " .. tostring(KladManager.Runtime.fps),
        tostring(math.floor(KladManager.Runtime.frame_ms * 10) / 10) .. " мс"
    )
    if KladManager.Diagnostics.last_error ~= "" then
        KladManager.ErrorState("Последняя ошибка", KladManager.Diagnostics.last_error)
    end
end

function KladManager.RenderSettingsGeneral()
    local imgui = KladManager.ImGui
    KladManager.SectionTitle("Интерфейс", "Настройки сохраняются автоматически.")
    imgui.Text(KladManager.U8("Масштаб"))
    local scale_changed, scale_value = KladManager.Segmented(
        "ui_scale",
        {
            {label="Малый",value="small"},
            {label="Средний",value="medium"},
            {label="Большой",value="large"}
        },
        KladManager.Settings.ui.scale,
        false
    )
    if scale_changed then
        KladManager.Settings.ui.scale = scale_value
        KladManager.MarkSettingsDirty()
    end
    imgui.Text(KladManager.U8("Прозрачность"))
    imgui.PushItemWidth(-1)
    if imgui.SliderFloat(
        "##ui_opacity",
        KladManager.Buffers.ui_opacity,
        0.65,
        1.0,
        "%.2f"
    ) then
        KladManager.Settings.ui.opacity = KladManager.Buffers.ui_opacity[0]
        KladManager.MarkSettingsDirty()
    end
    imgui.PopItemWidth()
    KladManager.SettingCheckbox(
        "diagnostics_enabled",
        "Показывать диагностику",
        "diagnostics",
        "enabled",
        false
    )
    KladManager.SectionTitle("Бинды", "Режим hold активен только пока клавиша зажата.")
    KladManager.BindEditor("menu", "Окно", "menu_key")
    local menu_changed, menu_mode = KladManager.Segmented(
        "menu_mode",
        {{label="Toggle",value="toggle"},{label="Hold",value="hold"}},
        KladManager.Settings.binds.menu_mode,
        false
    )
    if menu_changed then
        KladManager.Settings.binds.menu_mode = menu_mode
        KladManager.MarkSettingsDirty()
    end
    KladManager.BindEditor("minimap", "Миникарта", "minimap_key")
    local minimap_changed, minimap_mode = KladManager.Segmented(
        "minimap_mode",
        {{label="Toggle",value="toggle"},{label="Hold",value="hold"}},
        KladManager.Settings.binds.minimap_mode,
        false
    )
    if minimap_changed then
        KladManager.Settings.binds.minimap_mode = minimap_mode
        KladManager.MarkSettingsDirty()
    end
    KladManager.SectionTitle("Уведомления", "Один режим используется всеми модулями.")
    local mode_labels = {chat="Чат",custom="Интерфейс",both="Чат + интерфейс"}
    local notify_changed, notify_mode = KladManager.Combo(
        "notification_mode",
        mode_labels[KladManager.Settings.notifications.mode],
        {
            {label="Чат",value="chat"},
            {label="Интерфейс",value="custom"},
            {label="Чат + интерфейс",value="both"}
        },
        KladManager.Settings.notifications.mode,
        false
    )
    if notify_changed then
        KladManager.Settings.notifications.mode = notify_mode
        KladManager.MarkSettingsDirty()
    end
    local position_labels = {
        top_left="Сверху слева",
        top_center="Сверху по центру",
        top_right="Сверху справа",
        bottom_left="Снизу слева",
        bottom_center="Снизу по центру",
        bottom_right="Снизу справа"
    }
    local position_changed, position_value = KladManager.Combo(
        "notification_position",
        position_labels[KladManager.Settings.notifications.position],
        {
            {label="Сверху слева",value="top_left"},
            {label="Сверху по центру",value="top_center"},
            {label="Сверху справа",value="top_right"},
            {label="Снизу слева",value="bottom_left"},
            {label="Снизу по центру",value="bottom_center"},
            {label="Снизу справа",value="bottom_right"}
        },
        KladManager.Settings.notifications.position,
        false
    )
    if position_changed then
        KladManager.Settings.notifications.position = position_value
        KladManager.MarkSettingsDirty()
    end
    KladManager.SettingCheckbox(
        "notification_sound",
        "Звук уведомлений",
        "notifications",
        "sound",
        false
    )
    KladManager.SettingCheckbox(
        "chat_messages",
        "Служебные сообщения в чат",
        "notifications",
        "chat_messages",
        false
    )
    if KladManager.Button(
        "notification_test",
        "Проверить уведомление",
        "ICON_FA_BELL",
        imgui.ImVec2(-1, 0),
        "secondary",
        false,
        false
    ) then
        KladManager.Notify(
            "info",
            "Проверка",
            "Положение, режим и анимация применены.",
            5.0
        )
    end
end

function KladManager.DopkaBufferPosition()
    return {
        x=tonumber(KladManager.BufferGet(KladManager.GameBuffers.dopka_x)),
        y=tonumber(KladManager.BufferGet(KladManager.GameBuffers.dopka_y)),
        z=tonumber(KladManager.BufferGet(KladManager.GameBuffers.dopka_z))
    }
end

function KladManager.FillDopkaBuffers(position)
    position = type(position) == "table" and position or {}
    KladManager.BufferSet(
        KladManager.GameBuffers.dopka_x,
        32,
        position.x and string.format("%.3f", position.x) or ""
    )
    KladManager.BufferSet(
        KladManager.GameBuffers.dopka_y,
        32,
        position.y and string.format("%.3f", position.y) or ""
    )
    KladManager.BufferSet(
        KladManager.GameBuffers.dopka_z,
        32,
        position.z and string.format("%.3f", position.z) or ""
    )
end

function KladManager.SelectedDopkaIndex()
    for index, item in ipairs(KladManager.Dopkas) do
        if tostring(item.id) == tostring(KladManager.Gameplay.selected_dopka) then
            return index, item
        end
    end
    return nil, nil
end

function KladManager.RenderCoordinateInputs()
    local imgui = KladManager.ImGui
    local width = math.max(
        (imgui.GetContentRegionAvail().x - KladManager.Scaled(12)) / 3,
        KladManager.Scaled(72)
    )
    imgui.PushItemWidth(width)
    imgui.InputTextWithHint(
        "##dopka_x",
        "X",
        KladManager.GameBuffers.dopka_x,
        32
    )
    imgui.SameLine()
    imgui.InputTextWithHint(
        "##dopka_y",
        "Y",
        KladManager.GameBuffers.dopka_y,
        32
    )
    imgui.SameLine()
    imgui.InputTextWithHint(
        "##dopka_z",
        "Z",
        KladManager.GameBuffers.dopka_z,
        32
    )
    imgui.PopItemWidth()
end

function KladManager.RenderDopkas()
    local imgui = KladManager.ImGui
    local map_width = math.max(
        math.min(imgui.GetContentRegionAvail().x * 0.58, KladManager.Scaled(560)),
        KladManager.Scaled(300)
    )
    imgui.BeginChild("##dopkas_map", imgui.ImVec2(map_width, -1), false)
    local map_size = math.min(
        imgui.GetContentRegionAvail().x,
        math.max(imgui.GetContentRegionAvail().y - KladManager.Scaled(150), KladManager.Scaled(260))
    )
    KladManager.RenderMap(
        "dopkas",
        imgui.ImVec2(map_size, map_size),
        false
    )
    imgui.TextColored(
        KladManager.Vec4("text3"),
        KladManager.U8("ЛКМ — waypoint или перетаскивание. ПКМ по допке — удалить локально.")
    )
    KladManager.RenderCoordinateInputs()
    if KladManager.Button(
        "dopka_fill_current",
        "Текущие координаты",
        "ICON_FA_MAP_MARKER_ALT",
        imgui.ImVec2(-1, 0),
        "secondary",
        KladManager.CurrentPosition() == nil,
        false
    ) then
        KladManager.FillDopkaBuffers(KladManager.CurrentPosition())
    end
    local selected_index = KladManager.SelectedDopkaIndex()
    if KladManager.Button(
        "dopka_save_manual",
        selected_index and "Сохранить изменения" or "Добавить локальную допку",
        "ICON_FA_CHECK_CIRCLE",
        imgui.ImVec2(-1, 0),
        "primary",
        false,
        false
    ) then
        local position = KladManager.DopkaBufferPosition()
        if selected_index then
            if KladManager.UpdateDopka(selected_index, position) then
                KladManager.Notify("success", "Допки", "Изменения сохранены локально.", 3.5)
            else
                KladManager.Notify("error", "Допки", "Проверьте координаты.", 4.0)
            end
        else
            KladManager.AddManualDopka(position)
        end
    end
    imgui.EndChild()
    imgui.SameLine()
    imgui.BeginChild("##dopkas_list", imgui.ImVec2(0, -1), false)
    KladManager.SectionTitle(
        "Локальные метки",
        "Автоматические метки очищаются в следующий цикл :20."
    )
    if #KladManager.Dopkas == 0 then
        KladManager.EmptyState(
            "Допок пока нет",
            "Получите серверную допку или добавьте координаты вручную.",
            "ICON_FA_MAP_MARKER_ALT"
        )
    end
    for index, item in ipairs(KladManager.Dopkas) do
        local position = item.position or {}
        local selected = tostring(item.id) == tostring(
            KladManager.Gameplay.selected_dopka
        )
        if KladManager.Button(
            "dopka_select_" .. tostring(item.id),
            string.format(
                "%s\n%.1f, %.1f, %.1f · %s",
                selected and "* Допка" or "Допка",
                tonumber(position.x) or 0,
                tonumber(position.y) or 0,
                tonumber(position.z) or 0,
                tostring(item.source or "local")
            ),
            nil,
            imgui.ImVec2(-KladManager.Scaled(38), 0),
            selected and "primary" or "secondary",
            false,
            false
        ) then
            KladManager.Gameplay.selected_dopka = item.id
            KladManager.FillDopkaBuffers(position)
        end
        imgui.SameLine()
        if KladManager.IconButton(
            "dopka_delete_" .. tostring(item.id),
            "ICON_FA_TIMES_CIRCLE",
            "Удалить только локальную метку",
            false
        ) then
            KladManager.DeleteDopka(index)
            break
        end
    end
    imgui.EndChild()
end

function KladManager.RenderSpawns()
    local imgui = KladManager.ImGui
    local server = KladManager.ServerContext()
    KladManager.SectionTitle(
        "Спавны сервера " .. server.key,
        "Список считывается из игрового диалога; последний выход исключается."
    )
    if KladManager.Button(
        "spawns_open_rec",
        "Обновить список через /rec",
        "ICON_FA_SYNC_ALT",
        imgui.ImVec2(KladManager.Scaled(230), 0),
        "secondary",
        KladManager.Gameplay.discovery.active,
        false
    ) then
        sampSendChat("/rec")
    end
    imgui.SameLine()
    if KladManager.Button(
        "spawns_discovery",
        KladManager.Gameplay.discovery.active
            and "Отменить поиск координат" or "Найти координаты",
        "ICON_FA_MAP_MARKED_ALT",
        imgui.ImVec2(KladManager.Scaled(230), 0),
        KladManager.Gameplay.discovery.active and "danger" or "primary",
        false,
        false
    ) then
        if KladManager.Gameplay.discovery.active then
            KladManager.CancelSpawnDiscovery()
        else
            KladManager.StartSpawnDiscovery()
        end
    end
    if KladManager.Gameplay.discovery.active then
        imgui.TextColored(
            KladManager.Vec4("info"),
            KladManager.U8(
                "Поиск "
                    .. tostring(KladManager.Gameplay.discovery.index)
                    .. "/"
                    .. tostring(KladManager.Gameplay.discovery.total)
            )
        )
    end
    KladManager.Input(
        "spawn_manual_name",
        "Название пользовательского спавна",
        KladManager.GameBuffers.spawn_name,
        160,
        false
    )
    if KladManager.Button(
        "spawn_manual_add",
        "Добавить текущую позицию",
        "ICON_FA_MAP_MARKER_ALT",
        imgui.ImVec2(-1, 0),
        "secondary",
        KladManager.CurrentPosition() == nil,
        false
    ) then
        if KladManager.SaveManualSpawn(
            KladManager.BufferGet(KladManager.GameBuffers.spawn_name)
        ) then
            KladManager.BufferSet(KladManager.GameBuffers.spawn_name, 160, "")
        end
    end
    imgui.Separator()
    local map_width = math.max(
        math.min(imgui.GetContentRegionAvail().x * 0.52, KladManager.Scaled(520)),
        KladManager.Scaled(280)
    )
    imgui.BeginChild("##spawns_map", imgui.ImVec2(map_width, -1), false)
    local map_size = math.min(imgui.GetContentRegionAvail().x, imgui.GetContentRegionAvail().y)
    KladManager.RenderMap("spawns", imgui.ImVec2(map_size, map_size), false)
    imgui.EndChild()
    imgui.SameLine()
    imgui.BeginChild("##spawns_list", imgui.ImVec2(0, -1), false)
    if #KladManager.ActiveSpawns == 0 then
        KladManager.EmptyState(
            "Список пуст",
            "Откройте /rec кнопкой выше.",
            "ICON_FA_MAP_MARKED_ALT"
        )
    end
    for index, item in ipairs(KladManager.ActiveSpawns) do
        local suffix = item.position and " · координаты есть" or " · без координат"
        local selecting = KladManager.Gameplay.rec_expectation
            and tostring(KladManager.Gameplay.rec_expectation.spawn_id)
                == tostring(item.id)
        if item.missing then
            suffix = suffix .. " · исчез из списка"
        end
        if KladManager.Button(
            "spawn_activate_" .. tostring(item.id),
            tostring(item.display or "Спавн") .. "\n"
                .. tostring(item.spawn_type or "custom") .. suffix,
            nil,
            imgui.ImVec2(-KladManager.Scaled(38), 0),
            "secondary",
            item.missing,
            selecting
        ) then
            KladManager.ActivateSpawn(item.id)
        end
        imgui.SameLine()
        if KladManager.IconButton(
            "spawn_delete_" .. tostring(item.id),
            "ICON_FA_TIMES_CIRCLE",
            "Удалить локальную запись",
            selecting
        ) then
            KladManager.DeleteSpawn(index)
            break
        end
        if item.spawn_type ~= "home" and item.spawn_type ~= "trailer" then
            if KladManager.Button(
                "spawn_save_here_" .. tostring(item.id),
                item.position and "Обновить координаты здесь" or "Сохранить координаты здесь",
                "ICON_FA_MAP_MARKER_ALT",
                imgui.ImVec2(-1, 0),
                "outline",
                KladManager.CurrentPosition() == nil,
                false
            ) then
                KladManager.SaveSpawnCurrent(item.id)
            end
        end
    end
    imgui.EndChild()
end

function KladManager.ZoneBufferValue(buffer)
    return tonumber(KladManager.BufferGet(buffer))
end

function KladManager.RenderZones()
    local imgui = KladManager.ImGui
    KladManager.SectionTitle(
        "История белых зон",
        "Новые зоны сверху; пересечение строится по последним выбранным зонам."
    )
    local intersection = KladManager.Gameplay.zone_intersection
    if intersection then
        imgui.TextColored(
            KladManager.Vec4("success"),
            KladManager.U8(string.format(
                "Пересечение: %.1f, %.1f — %.1f, %.1f",
                intersection.left,
                intersection.up,
                intersection.right,
                intersection.down
            ))
        )
    else
        imgui.TextColored(
            KladManager.Vec4("text3"),
            KladManager.U8("Пересечения выбранных зон сейчас нет.")
        )
    end
    local width = math.max(
        (imgui.GetContentRegionAvail().x - KladManager.Scaled(18)) / 4,
        KladManager.Scaled(72)
    )
    imgui.PushItemWidth(width)
    imgui.InputTextWithHint("##zone_left", "Left", KladManager.GameBuffers.zone_left, 32)
    imgui.SameLine()
    imgui.InputTextWithHint("##zone_up", "Up", KladManager.GameBuffers.zone_up, 32)
    imgui.SameLine()
    imgui.InputTextWithHint("##zone_right", "Right", KladManager.GameBuffers.zone_right, 32)
    imgui.SameLine()
    imgui.InputTextWithHint("##zone_down", "Down", KladManager.GameBuffers.zone_down, 32)
    imgui.PopItemWidth()
    if KladManager.Button(
        "zone_manual_add",
        "Добавить локальную зону",
        "ICON_FA_DATABASE",
        imgui.ImVec2(-1, 0),
        "secondary",
        false,
        false
    ) then
        local zone = {
            left=KladManager.ZoneBufferValue(KladManager.GameBuffers.zone_left),
            up=KladManager.ZoneBufferValue(KladManager.GameBuffers.zone_up),
            right=KladManager.ZoneBufferValue(KladManager.GameBuffers.zone_right),
            down=KladManager.ZoneBufferValue(KladManager.GameBuffers.zone_down),
            color=-2130706433,
            source="manual"
        }
        if KladManager.IsFinite(zone.left) and KladManager.IsFinite(zone.up)
            and KladManager.IsFinite(zone.right) and KladManager.IsFinite(zone.down)
            and zone.left ~= zone.right and zone.up ~= zone.down then
            KladManager.AddZone(zone)
        else
            KladManager.Notify("error", "Зоны", "Проверьте четыре границы.", 4.0)
        end
    end
    imgui.Separator()
    local map_width = math.max(
        math.min(imgui.GetContentRegionAvail().x * 0.58, KladManager.Scaled(560)),
        KladManager.Scaled(300)
    )
    imgui.BeginChild("##zones_map", imgui.ImVec2(map_width, -1), false)
    local map_size = math.min(imgui.GetContentRegionAvail().x, imgui.GetContentRegionAvail().y)
    KladManager.RenderMap("zones", imgui.ImVec2(map_size, map_size), false)
    imgui.EndChild()
    imgui.SameLine()
    imgui.BeginChild("##zones_list", imgui.ImVec2(0, -1), false)
    if #KladManager.Zones == 0 then
        KladManager.EmptyState(
            "История пуста",
            "Белая игровая зона будет сохранена автоматически.",
            "ICON_FA_DATABASE"
        )
    end
    for index, zone in ipairs(KladManager.Zones) do
        imgui.TextWrapped(KladManager.U8(string.format(
            "#%d · %.1f, %.1f — %.1f, %.1f",
            index,
            tonumber(zone.left) or 0,
            tonumber(zone.up) or 0,
            tonumber(zone.right) or 0,
            tonumber(zone.down) or 0
        )))
        if KladManager.Button(
            "zone_restore_" .. tostring(zone.id),
            "Восстановить",
            "ICON_FA_SYNC_ALT",
            imgui.ImVec2(-KladManager.Scaled(38), 0),
            "secondary",
            false,
            false
        ) then
            KladManager.RestoreZone(index)
        end
        imgui.SameLine()
        if KladManager.IconButton(
            "zone_delete_" .. tostring(zone.id),
            "ICON_FA_TIMES_CIRCLE",
            "Удалить локальную зону",
            false
        ) then
            KladManager.DeleteZone(index)
            break
        end
        imgui.Separator()
    end
    imgui.EndChild()
end

function KladManager.FormatGameMoney(value)
    local number = math.floor(tonumber(value) or 0)
    local negative = number < 0
    local text = tostring(math.abs(number))
    local result = ""
    while #text > 3 do
        result = " " .. text:sub(-3) .. result
        text = text:sub(1, -4)
    end
    return (negative and "-$ " or "$ ") .. text .. result
end

function KladManager.CompactNumber(value)
    local number = tonumber(value) or 0
    if math.abs(number) >= 1000000000 then
        return string.format("%.2fККК", number / 1000000000)
    elseif math.abs(number) >= 1000000 then
        return string.format("%.2fКК", number / 1000000)
    elseif math.abs(number) >= 1000 then
        return string.format("%.2fК", number / 1000)
    end
    return tostring(math.floor(number))
end

function KladManager.LootLogTime(value)
    local text = tostring(value or "")
    return text:match("T(%d%d:%d%d:%d%d)") or text:match(" (%d%d:%d%d:%d%d)") or "00:00:00"
end

function KladManager.DrawHighlightedText(text, search)
    local imgui = KladManager.ImGui
    local value = tostring(text or "")
    local needle = tostring(search or "")
    if needle == "" then
        imgui.TextWrapped(KladManager.U8(value))
        return
    end
    local lowered = value:lower()
    local target = needle:lower()
    local cursor = 1
    local first = true
    while cursor <= #value do
        local start_at, end_at = lowered:find(target, cursor, true)
        if not start_at then
            local tail = value:sub(cursor)
            if tail ~= "" then
                if not first then
                    imgui.SameLine(0, 0)
                end
                imgui.TextUnformatted(KladManager.U8(tail))
            end
            break
        end
        local before = value:sub(cursor, start_at - 1)
        if before ~= "" then
            if not first then
                imgui.SameLine(0, 0)
            end
            imgui.TextUnformatted(KladManager.U8(before))
            first = false
        end
        if not first then
            imgui.SameLine(0, 0)
        end
        imgui.TextColored(
            KladManager.Vec4("accent_hover"),
            KladManager.U8(value:sub(start_at, end_at))
        )
        first = false
        cursor = end_at + 1
    end
end

function KladManager.LootItemVisible(item, search)
    if search == "" then
        return true
    end
    return KladManager.NormalizeItemName(item.name):find(
        KladManager.NormalizeItemName(search),
        1,
        true
    ) ~= nil
end

function KladManager.FilteredLootLogs()
    local result = {}
    local source = KladManager.Settings.logs.source
    local day = KladManager.Settings.logs.selected_day
    local search = KladManager.BufferGet(KladManager.Buffers.loot_search)
    for _, log in ipairs(KladManager.Loot.logs) do
        local source_ok = tostring(log.source) == source
        local day_ok = day == "" or tostring(log.day or "") == day
        local search_ok = search == ""
        if not search_ok then
            for _, item in ipairs(type(log.items) == "table" and log.items or {}) do
                if KladManager.LootItemVisible(item, search) then
                    search_ok = true
                    break
                end
            end
        end
        if source_ok and day_ok and search_ok
            and tostring(log.fraud_status or "accepted") ~= "revoked" then
            result[#result + 1] = log
        end
    end
    return result
end

function KladManager.LootItemPrice(item)
    local total = KladManager.Settings.prices.mode == "current"
        and item.display_total_price or item.total_price_snapshot
    local unit = KladManager.Settings.prices.mode == "current"
        and item.display_unit_price or item.unit_price_snapshot
    if total == nil then
        return "Цена не найдена", "Цена не найдена"
    end
    return KladManager.FormatGameMoney(total), KladManager.FormatGameMoney(unit)
end

function KladManager.RenderLootItemCard(log_id, index, item, search)
    local imgui = KladManager.ImGui
    local total, unit = KladManager.LootItemPrice(item)
    local uv = KladManager.AtlasUv(item.name)
    local texture = uv and uv.atlas == 0 and KladManager.LoadAtlasTexture() or nil
    imgui.PushStyleColor(imgui.Col.ChildBg, KladManager.Vec4("surface2"))
    imgui.BeginChild(
        "##loot_item_" .. tostring(log_id) .. "_" .. tostring(index),
        imgui.ImVec2(KladManager.Scaled(142), KladManager.Scaled(70)),
        true
    )
    if texture then
        imgui.Image(
            texture,
            imgui.ImVec2(KladManager.Scaled(42), KladManager.Scaled(42)),
            uv.uv0,
            uv.uv1
        )
        if imgui.IsItemHovered() then
            imgui.BeginTooltip()
            imgui.Image(
                texture,
                imgui.ImVec2(KladManager.Scaled(100), KladManager.Scaled(100)),
                uv.uv0,
                uv.uv1
            )
            imgui.EndTooltip()
        end
        imgui.SameLine()
    end
    imgui.BeginGroup()
    KladManager.DrawHighlightedText(
        tostring(item.name or "Предмет")
            .. " (" .. tostring(item.quantity or 1) .. " шт.)",
        search
    )
    imgui.TextColored(KladManager.Vec4("accent_hover"), KladManager.U8(total))
    if tonumber(item.quantity or 1) > 1 and unit ~= "Цена не найдена" then
        KladManager.Tooltip("За единицу: " .. unit)
    end
    imgui.EndGroup()
    imgui.EndChild()
    imgui.PopStyleColor()
end

function KladManager.RenderLootLogCard(log, index, search)
    local imgui = KladManager.ImGui
    local selected = tostring(KladManager.Loot.selected_id) == tostring(log.event_id)
    imgui.PushStyleColor(
        imgui.Col.ChildBg,
        KladManager.Vec4(selected and "accent_soft" or "surface1")
    )
    imgui.BeginChild(
        "##loot_log_" .. tostring(log.event_id),
        imgui.ImVec2(0, KladManager.Scaled(178)),
        true
    )
    local title = (log.source == "chest" and "Шкатулка" or "Клад")
        .. " №" .. tostring(index)
        .. " | " .. KladManager.LootLogTime(log.occurred_at)
        .. " | Заработано: " .. KladManager.FormatGameMoney(log.total_value_snapshot)
    imgui.TextColored(KladManager.Vec4("text1"), KladManager.U8(title))
    imgui.SameLine()
    imgui.TextColored(
        KladManager.Vec4(log.sync_status == "pending" and "warning" or "text3"),
        KladManager.U8(tostring(log.server_key or "сервер не определён"))
    )
    if imgui.IsWindowHovered() and imgui.IsMouseClicked(0) then
        KladManager.Loot.selected_id = log.event_id
    end
    imgui.Separator()
    for item_index, item in ipairs(type(log.items) == "table" and log.items or {}) do
        if item_index > 1 and (item_index - 1) % 4 ~= 0 then
            imgui.SameLine()
        end
        KladManager.RenderLootItemCard(log.event_id, item_index, item, search)
    end
    imgui.EndChild()
    imgui.PopStyleColor()
end

function KladManager.RenderLootDateSelector()
    local imgui = KladManager.ImGui
    local selected = KladManager.Settings.logs.selected_day
    if selected == "" then
        selected = os.date("%Y-%m-%d")
    end
    if KladManager.Button(
        "loot_date",
        selected,
        "ICON_FA_CALENDAR_ALT",
        imgui.ImVec2(KladManager.Scaled(150), 0),
        "secondary",
        false,
        false
    ) then
        KladManager.OpenPopup("loot_dates")
    end
    if imgui.BeginPopup("loot_dates") then
        if imgui.Selectable(KladManager.U8("Все даты"), KladManager.Settings.logs.selected_day == "") then
            KladManager.Settings.logs.selected_day = ""
            KladManager.MarkSettingsDirty()
        end
        for _, day in ipairs(KladManager.Loot.dates) do
            if imgui.Selectable(
                KladManager.U8(tostring(day)),
                tostring(day) == KladManager.Settings.logs.selected_day
            ) then
                KladManager.Settings.logs.selected_day = tostring(day)
                KladManager.MarkSettingsDirty()
            end
        end
        imgui.EndPopup()
    end
end

function KladManager.RenderLogs()
    local imgui = KladManager.ImGui
    imgui.BeginChild("##loot_controls", imgui.ImVec2(0, KladManager.Scaled(98)), true)
    KladManager.RenderLootDateSelector()
    imgui.SameLine()
    local changed, source = KladManager.Segmented(
        "loot_source",
        {
            {label="Клады",value="treasure"},
            {label="Шкатулки",value="chest"}
        },
        KladManager.Settings.logs.source,
        false
    )
    if changed then
        KladManager.Settings.logs.source = source
        KladManager.MarkSettingsDirty()
    end
    imgui.SameLine()
    if KladManager.IconButton(
        "loot_refresh",
        "ICON_FA_SYNC_ALT",
        "Обновить серверные логи и цены",
        KladManager.Loot.query_busy
    ) then
        KladManager.SyncLootLogs(true)
        KladManager.QueryLootData(true)
    end
    KladManager.Input(
        "loot_search",
        "Поиск по названию предмета",
        KladManager.Buffers.loot_search,
        160,
        false
    )
    imgui.EndChild()
    if KladManager.Loot.query_busy and #KladManager.Loot.logs == 0 then
        KladManager.LoadingState("Загрузка логов и цен…")
        return
    end
    if KladManager.Loot.query_error and #KladManager.Loot.logs == 0 then
        KladManager.ErrorState("Ошибка загрузки", KladManager.Loot.query_error)
        return
    end
    local logs = KladManager.FilteredLootLogs()
    if #logs == 0 then
        KladManager.EmptyState(
            "Логов нет",
            "Для выбранной даты, типа и поискового запроса ничего не найдено."
        )
        return
    end
    local search = KladManager.BufferGet(KladManager.Buffers.loot_search)
    imgui.BeginChild("##loot_virtual_list", imgui.ImVec2(0, -1), false)
    local wheel = imgui.GetIO().MouseWheel
    if imgui.IsWindowHovered() and wheel ~= 0 then
        KladManager.Loot.scroll_target = KladManager.Clamp(
            (KladManager.Loot.scroll_target or imgui.GetScrollY())
                - wheel * KladManager.Scaled(90),
            0,
            math.max(0, imgui.GetScrollMaxY())
        )
    end
    if KladManager.Loot.scroll_target then
        local current = imgui.GetScrollY()
        imgui.SetScrollY(current + (KladManager.Loot.scroll_target - current) * 0.22)
    end
    local clipper_ok, clipper = pcall(function()
        return imgui.ImGuiListClipper()
    end)
    if clipper_ok and clipper then
        clipper:Begin(#logs, KladManager.Scaled(184))
        while clipper:Step() do
            local preload_start = math.max(1, clipper.DisplayStart - 2)
            local preload_end = math.min(#logs, clipper.DisplayEnd + 3)
            for preload = preload_start, preload_end do
                for _, item in ipairs(logs[preload].items or {}) do
                    KladManager.AtlasUv(item.name)
                end
            end
            for display = clipper.DisplayStart + 1, clipper.DisplayEnd do
                KladManager.RenderLootLogCard(logs[display], display, search)
                imgui.Dummy(imgui.ImVec2(0, KladManager.Scaled(6)))
            end
        end
        clipper:End()
    else
        for display = 1, #logs do
            KladManager.RenderLootLogCard(logs[display], display, search)
            imgui.Dummy(imgui.ImVec2(0, KladManager.Scaled(6)))
        end
    end
    imgui.EndChild()
end

function KladManager.DrawDropDonut(id, top, size)
    local imgui = KladManager.ImGui
    local origin = imgui.GetCursorScreenPos()
    imgui.InvisibleButton("##donut_" .. tostring(id), imgui.ImVec2(size, size))
    local draw = imgui.GetWindowDrawList()
    local center = imgui.ImVec2(origin.x + size / 2, origin.y + size / 2)
    local radius = size * 0.36
    local total = 0
    for _, item in ipairs(top or {}) do
        total = total + tonumber(item.quantity or 0)
    end
    local angle = -math.pi / 2
    for index, item in ipairs(top or {}) do
        local share = total > 0 and tonumber(item.quantity or 0) / total or 0
        local finish = angle + share * math.pi * 2
        local color = KladManager.MapColor(
            1.0,
            0.25 + (index - 1) * 0.10,
            0.04 + (index - 1) * 0.06,
            0.95
        )
        local steps = math.max(1, math.floor(share * 72))
        for step = 1, steps do
            local left = angle + (finish - angle) * (step - 1) / steps
            local right = angle + (finish - angle) * step / steps
            draw:AddLine(
                imgui.ImVec2(
                    center.x + math.cos(left) * radius,
                    center.y + math.sin(left) * radius
                ),
                imgui.ImVec2(
                    center.x + math.cos(right) * radius,
                    center.y + math.sin(right) * radius
                ),
                color,
                KladManager.Scaled(18)
            )
        end
        angle = finish
    end
    draw:AddCircleFilled(center, radius * 0.52, KladManager.U32("surface1"), 48)
    draw:AddText(
        imgui.ImVec2(center.x - KladManager.Scaled(20), center.y - KladManager.Scaled(7)),
        KladManager.U32("text1"),
        KladManager.U8(tostring(total) .. " шт.")
    )
end

function KladManager.RenderStatisticSummary(summary, label)
    local imgui = KladManager.ImGui
    if type(summary) ~= "table" then
        KladManager.EmptyState("Нет статистики", "За выбранный период данных пока нет.")
        return
    end
    imgui.BeginChild("##stats_graph", imgui.ImVec2(KladManager.Scaled(390), KladManager.Scaled(178)), true)
    imgui.Text(KladManager.U8("Статистика заработка — " .. label))
    local values = {}
    for _, point in ipairs(type(summary.graph) == "table" and summary.graph or {}) do
        values[#values + 1] = tonumber(point.value) or 0
    end
    KladManager.Graph("earnings", values, imgui.ImVec2(-1, KladManager.Scaled(125)))
    imgui.EndChild()
    imgui.SameLine()
    imgui.BeginChild("##stats_total", imgui.ImVec2(0, KladManager.Scaled(178)), true)
    imgui.TextColored(KladManager.Vec4("text2"), KladManager.U8("Общая заработанная сумма"))
    imgui.TextColored(
        KladManager.Vec4("accent_hover"),
        KladManager.U8(KladManager.FormatGameMoney(summary.total_value))
    )
    imgui.Text(KladManager.U8("Логов: " .. tostring(summary.logs or 0)))
    imgui.Text(KladManager.U8("Среднее: " .. KladManager.FormatGameMoney(summary.average_value)))
    imgui.Text(KladManager.U8("В час: " .. tostring(summary.per_hour or 0)))
    if summary.best_day then
        imgui.TextWrapped(
            KladManager.U8(
                "Лучший день: " .. tostring(summary.best_day.day)
                    .. " — " .. KladManager.FormatGameMoney(summary.best_day.value)
            )
        )
    end
    imgui.EndChild()
    imgui.BeginChild("##stats_drop", imgui.ImVec2(KladManager.Scaled(390), -1), true)
    imgui.Text(KladManager.U8("Дроп"))
    KladManager.DrawDropDonut(
        "drop",
        summary.drop and summary.drop.top5 or {},
        KladManager.Scaled(132)
    )
    imgui.SameLine()
    imgui.BeginGroup()
    for index, item in ipairs(
        summary.drop and type(summary.drop.top5) == "table" and summary.drop.top5 or {}
    ) do
        imgui.TextColored(
            KladManager.Vec4(index == 1 and "accent_hover" or "text2"),
            KladManager.U8(
                tostring(index) .. ". " .. tostring(item.name)
                    .. " — " .. tostring(item.quantity) .. " шт."
            )
        )
    end
    imgui.EndGroup()
    imgui.EndChild()
    imgui.SameLine()
    imgui.BeginChild("##stats_counts", imgui.ImVec2(0, -1), true)
    imgui.Text(KladManager.U8("Итоги"))
    imgui.Text(KladManager.U8("Клады: " .. tostring(summary.treasures or 0)))
    imgui.Text(KladManager.U8("Шкатулки: " .. tostring(summary.chests or 0)))
    imgui.Text(KladManager.U8("Предметы: " .. tostring(summary.items_count or 0)))
    imgui.Text(
        KladManager.U8(
            "Режим цен: "
                .. (KladManager.Settings.prices.mode == "current"
                    and "Текущая цена" or "Цена на момент выпадения")
        )
    )
    imgui.EndChild()
end

function KladManager.RenderStatistics()
    local imgui = KladManager.ImGui
    local changed, period = KladManager.Segmented(
        "statistics_period",
        {
            {label="1 день",value="1"},
            {label="7 дней",value="7"},
            {label="30 дней",value="30"},
            {label="Всё время",value="all"}
        },
        KladManager.Settings.statistics.period,
        false
    )
    if changed then
        KladManager.Settings.statistics.period = period
        KladManager.MarkSettingsDirty()
        KladManager.QueryLootData(true)
    end
    imgui.SameLine()
    local source_changed, source = KladManager.Segmented(
        "statistics_source",
        {
            {label="Вместе",value="combined"},
            {label="Клады",value="treasure"},
            {label="Шкатулки",value="chest"}
        },
        KladManager.Loot.statistics_source or "combined",
        false
    )
    if source_changed then
        KladManager.Loot.statistics_source = source
    end
    if KladManager.Loot.query_busy and not KladManager.Loot.summary then
        KladManager.LoadingState("Расчёт статистики…")
        return
    end
    if KladManager.Loot.query_error and not KladManager.Loot.summary then
        KladManager.ErrorState("Статистика недоступна", KladManager.Loot.query_error)
        return
    end
    local summary = KladManager.Loot.summary
    local selected = KladManager.Loot.statistics_source or "combined"
    KladManager.RenderStatisticSummary(
        type(summary) == "table" and summary[selected] or nil,
        selected == "combined" and "все находки"
            or selected == "treasure" and "клады" or "шкатулки"
    )
end

function KladManager.RenderSettingsMap()
    local imgui = KladManager.ImGui
    KladManager.SectionTitle("Слои карты", "Данные подключаются на этапах 07–08.")
    local layer_keys = {
        {"layer_player","Игрок"},
        {"layer_dopkas","Допки"},
        {"layer_spawns","Спавны"},
        {"layer_treasures","Сокровища"},
        {"layer_white_zone","Белая зона"},
        {"markers","Маркеры"},
        {"zones","Зоны"},
        {"popular","Популярные места"},
        {"inside_zone","Только внутри зоны"},
        {"auto_intersection","Автопроверка пересечений"},
        {"remove_game_zones","Скрывать игровые gang-зоны"},
        {"restore_white_zone","Восстанавливать белую зону"},
        {"spawn_server_auto_switch","Автосмена списка спавнов по серверу"}
    }
    for _, row in ipairs(layer_keys) do
        KladManager.SettingCheckbox("map_" .. row[1], row[2], "map", row[1], false)
    end
    imgui.Text(KladManager.U8("Период, месяцев"))
    imgui.PushItemWidth(-1)
    if imgui.SliderInt("##map_months", KladManager.Buffers.map_months, 1, 24) then
        KladManager.Settings.map.months = KladManager.Buffers.map_months[0]
        KladManager.MarkSettingsDirty()
    end
    imgui.Text(KladManager.U8("Количество зон"))
    if imgui.SliderInt("##zone_count", KladManager.Buffers.zone_count, 1, 64) then
        KladManager.Settings.map.zone_count = KladManager.Buffers.zone_count[0]
        KladManager.MarkSettingsDirty()
    end
    imgui.Text(KladManager.U8("Зон в пересечении"))
    if imgui.SliderInt(
        "##intersection_count",
        KladManager.Buffers.intersection_count,
        2,
        16
    ) then
        KladManager.Settings.map.intersection_count =
            KladManager.Buffers.intersection_count[0]
        KladManager.Gameplay.zone_intersection = KladManager.ZoneIntersection(
            KladManager.Settings.map.intersection_count
        )
        KladManager.MarkSettingsDirty()
    end
    imgui.PopItemWidth()
    KladManager.SectionTitle("Миникарта", "Preview и игровое окно используют один renderer.")
    local minimap_positions = {
        top_left="Сверху слева",
        top_right="Сверху справа",
        bottom_left="Снизу слева",
        bottom_right="Снизу справа",
        custom="Свободно"
    }
    local map_position_changed, map_position = KladManager.Combo(
        "minimap_position",
        minimap_positions[KladManager.Settings.map.minimap_position],
        {
            {label="Сверху слева",value="top_left"},
            {label="Сверху справа",value="top_right"},
            {label="Снизу слева",value="bottom_left"},
            {label="Снизу справа",value="bottom_right"},
            {label="Свободно",value="custom"}
        },
        KladManager.Settings.map.minimap_position,
        false
    )
    if map_position_changed then
        KladManager.Settings.map.minimap_position = map_position
        KladManager.MarkSettingsDirty()
    end
    imgui.PushItemWidth(-1)
    imgui.Text(KladManager.U8("Размер"))
    if imgui.SliderInt(
        "##minimap_size",
        KladManager.Buffers.minimap_size,
        180,
        520,
        "%d px"
    ) then
        KladManager.Settings.map.minimap_size = KladManager.Buffers.minimap_size[0]
        KladManager.MarkSettingsDirty()
    end
    imgui.Text(KladManager.U8("Масштаб карты"))
    if imgui.SliderFloat(
        "##minimap_zoom",
        KladManager.Buffers.minimap_zoom,
        0.5,
        4.0,
        "%.1fx"
    ) then
        KladManager.Settings.map.minimap_zoom = KladManager.Buffers.minimap_zoom[0]
        KladManager.MarkSettingsDirty()
    end
    imgui.Text(KladManager.U8("Прозрачность миникарты"))
    if imgui.SliderFloat(
        "##minimap_opacity",
        KladManager.Buffers.minimap_opacity,
        0.25,
        1.0,
        "%.2f"
    ) then
        KladManager.Settings.map.minimap_opacity =
            KladManager.Buffers.minimap_opacity[0]
        KladManager.MarkSettingsDirty()
    end
    imgui.Text(KladManager.U8("Толщина линий"))
    if imgui.SliderFloat(
        "##line_width",
        KladManager.Buffers.line_width,
        1.0,
        6.0,
        "%.1f"
    ) then
        KladManager.Settings.map.line_width = KladManager.Buffers.line_width[0]
        KladManager.MarkSettingsDirty()
    end
    imgui.PopItemWidth()
    imgui.Text(KladManager.U8("Цвет маркера"))
    if imgui.ColorEdit3(
        "##marker_color",
        KladManager.Buffers.marker_color,
        imgui.ColorEditFlags.NoInputs
    ) then
        KladManager.Settings.map.marker_color_r = KladManager.Buffers.marker_color[0]
        KladManager.Settings.map.marker_color_g = KladManager.Buffers.marker_color[1]
        KladManager.Settings.map.marker_color_b = KladManager.Buffers.marker_color[2]
        KladManager.MarkSettingsDirty()
    end
    local preview_size = math.min(imgui.GetContentRegionAvail().x, KladManager.Scaled(280))
    KladManager.RenderMap(
        "preview",
        imgui.ImVec2(preview_size, preview_size),
        true
    )
    if KladManager.Button(
        "toggle_minimap",
        KladManager.Runtime.minimap_open and "Скрыть миникарту" or "Показать миникарту",
        "ICON_FA_MAP_MARKED_ALT",
        imgui.ImVec2(preview_size, 0),
        "secondary",
        false,
        false
    ) then
        KladManager.Runtime.minimap_open = not KladManager.Runtime.minimap_open
    end
    if KladManager.Button(
        "toggle_minimap_edit",
        KladManager.Gameplay.minimap_edit
            and "Завершить редактирование" or "Редактировать миникарту",
        "ICON_FA_MAP_MARKED_ALT",
        imgui.ImVec2(preview_size, 0),
        KladManager.Gameplay.minimap_edit and "primary" or "secondary",
        false,
        false
    ) then
        KladManager.Gameplay.minimap_edit = not KladManager.Gameplay.minimap_edit
        if KladManager.Gameplay.minimap_edit then
            KladManager.Runtime.minimap_open = true
        end
    end
    imgui.TextColored(
        KladManager.Vec4("text3"),
        KladManager.U8("В режиме редактирования: ЛКМ — метка/перетаскивание, ПКМ — удалить допку, колесо — масштаб.")
    )
end

function KladManager.RenderSettingsData()
    local imgui = KladManager.ImGui
    KladManager.SectionTitle("Цены", "AveragePrice используется только для чтения.")
    local price_changed, price_mode = KladManager.Segmented(
        "price_mode",
        {
            {label="Цена на момент выпадения",value="moment"},
            {label="Текущая цена",value="current"}
        },
        KladManager.Settings.prices.mode,
        false
    )
    if price_changed then
        KladManager.Settings.prices.mode = price_mode
        KladManager.MarkSettingsDirty()
        KladManager.QueryLootData(true)
    end
    KladManager.SectionTitle("Состояние сети", "")
    if KladManager.ApiBaseUrl == "" then
        KladManager.ErrorState(
            "API не настроен",
            "Укажите HTTPS api_url в config/KladManager/KladManager.ini и перезапустите скрипт."
        )
    else
        KladManager.ListRow(
            "network_state",
            "KladManager API",
            "HTTPS, секреты в диагностике скрыты",
            KladManager.Auth.state
        )
    end
    if KladManager.Settings.diagnostics.enabled then
        KladManager.SectionTitle("Диагностика", "Токены и полный HWID никогда не отображаются.")
        KladManager.RenderDiagnostics()
    end
end

function KladManager.RenderSettings()
    local imgui = KladManager.ImGui
    imgui.BeginChild("##settings_left", imgui.ImVec2(KladManager.Scaled(300), -1), false)
    KladManager.RenderSettingsGeneral()
    imgui.EndChild()
    imgui.SameLine()
    imgui.BeginChild("##settings_right", imgui.ImVec2(0, -1), false)
    KladManager.RenderSettingsMap()
    KladManager.RenderSettingsData()
    imgui.EndChild()
end

function KladManager.RenderMainContent()
    local imgui = KladManager.ImGui
    local current = KladManager.Runtime.active_tab
    local available = false
    for _, tab in ipairs(KladManager.Tabs) do
        if tab.id == current and KladManager.TabAvailable(tab) then
            available = true
        end
    end
    if not available then
        current = "settings"
        KladManager.Runtime.active_tab = current
    end
    local title = "Настройки"
    for _, tab in ipairs(KladManager.Tabs) do
        if tab.id == current then
            title = tab.label
        end
    end
    imgui.Text(KladManager.U8(title))
    imgui.SameLine()
    imgui.TextColored(
        KladManager.Vec4("text3"),
        KladManager.U8("KladManager " .. KM_VERSION)
    )
    imgui.Separator()
    KladManager.Runtime.tab_alpha = KladManager.Animate(
        "content_transition",
        1.0,
        9.0
    )
    imgui.PushStyleVarFloat(
        imgui.StyleVar.Alpha,
        imgui.GetStyle().Alpha * KladManager.Runtime.tab_alpha
    )
    imgui.BeginChild("##KladManagerContentClip", imgui.ImVec2(0, -1), false)
    if current == "settings" then
        KladManager.RenderSettings()
    elseif current == "dopkas" then
        KladManager.RenderDopkas()
    elseif current == "spawns" then
        KladManager.RenderSpawns()
    elseif current == "zones" then
        KladManager.RenderZones()
    elseif current == "logs" then
        KladManager.RenderLogs()
    elseif current == "statistics" then
        KladManager.RenderStatistics()
    end
    imgui.EndChild()
    imgui.PopStyleVar()
end

function KladManager.AuthStateColor(state)
    if state == "approved" then
        return "success"
    elseif state == "maintenance" or state == "network_error" then
        return "warning"
    elseif state == "login" or state == "telegram_2fa" or state == "new_device" then
        return "info"
    end
    return "danger"
end

function KladManager.ResendTwoFactor()
    if KladManager.NowMs() < KladManager.Auth.resend_at or KladManager.Auth.busy then
        return
    end
    KladManager.Auth.two_factor_id = nil
    KladManager.Auth.challenge_id = nil
    KladManager.Auth.server_nonce = nil
    KladManager.Auth.resend_at = KladManager.NowMs() + 60000
    KladManager.BeginLogin()
end

function KladManager.RenderAuthActions()
    local imgui = KladManager.ImGui
    local state = KladManager.Auth.state
    if state == "network_error" and KladManager.Auth.session then
        if KladManager.Button(
            "auth_session_retry",
            "Повторить соединение",
            "ICON_FA_SYNC_ALT",
            imgui.ImVec2(-1, 0),
            "primary",
            KladManager.Auth.busy,
            false
        ) then
            KladManager.RefreshSession()
        end
        if KladManager.Button(
            "auth_session_forget",
            "Войти в другой аккаунт",
            nil,
            imgui.ImVec2(-1, 0),
            "secondary",
            KladManager.Auth.busy,
            false
        ) then
            KladManager.ClearSession()
            KladManager.SetAuthState("login", "Введите логин и пароль.")
        end
        return
    end
    if state == "login" or state == "rejected" or state == "network_error"
        or state == "expired" then
        KladManager.Input(
            "auth_username",
            "Логин",
            KladManager.Buffers.username,
            64,
            KladManager.Auth.busy
        )
        KladManager.PasswordInput(
            "auth_password",
            "Пароль",
            KladManager.Buffers.password,
            128,
            KladManager.Auth.show_password,
            KladManager.Auth.busy
        )
        if KladManager.Button(
            "auth_login",
            "Войти",
            "ICON_FA_LOCK",
            imgui.ImVec2(-1, 0),
            "primary",
            KladManager.ApiBaseUrl == "",
            KladManager.Auth.busy
        ) then
            KladManager.BeginLogin()
        end
        if KladManager.Button(
            "forgot_password",
            "Забыли пароль?",
            "ICON_FA_EXTERNAL_LINK_ALT",
            imgui.ImVec2(-1, 0),
            "outline",
            KladManager.ApiBaseUrl == "",
            false
        ) then
            KladManager.OpenUrl(KladManager.ApiBaseUrl .. "/account/security")
        end
    elseif state == "telegram_2fa" or state == "new_device" then
        KladManager.Input(
            "auth_two_factor",
            "Код из Telegram",
            KladManager.Buffers.two_factor,
            7,
            KladManager.Auth.busy
        )
        local code = KladManager.BufferGet(KladManager.Buffers.two_factor)
        if KladManager.Button(
            "auth_two_factor_submit",
            "Подтвердить код",
            "ICON_FA_KEY",
            imgui.ImVec2(-1, 0),
            "primary",
            #code ~= 6,
            KladManager.Auth.busy
        ) then
            KladManager.CompleteTwoFactor(code)
        end
        local cooldown = math.max(
            0,
            math.ceil((KladManager.Auth.resend_at - KladManager.NowMs()) / 1000)
        )
        local resend_label = cooldown > 0
            and "Повторить через " .. tostring(cooldown) .. " с"
            or "Отправить повторно"
        if KladManager.Button(
            "auth_resend",
            resend_label,
            "ICON_FA_SYNC_ALT",
            imgui.ImVec2(-1, 0),
            "secondary",
            cooldown > 0,
            false
        ) then
            KladManager.ResendTwoFactor()
        end
        if KladManager.Button(
            "auth_back",
            "Вернуться ко входу",
            nil,
            imgui.ImVec2(-1, 0),
            "outline",
            KladManager.Auth.busy,
            false
        ) then
            KladManager.Auth.two_factor_id = nil
            KladManager.SetAuthState("login", "Введите логин и пароль.")
        end
    elseif state == "hwid_reset_required" then
        if KladManager.Button(
            "auth_hwid_request",
            "Открыть запрос сброса HWID",
            "ICON_FA_KEY",
            imgui.ImVec2(-1, 0),
            "primary",
            not KM_IS_HTTPS(KladManager.HwidRequestUrl or ""),
            false
        ) then
            KladManager.OpenUrl(KladManager.HwidRequestUrl)
        end
        if KladManager.Button(
            "auth_hwid_logout",
            "Сбросить локальную сессию",
            nil,
            imgui.ImVec2(-1, 0),
            "secondary",
            false,
            false
        ) then
            KladManager.ClearSession()
            KladManager.SetAuthState("login", "Локальная сессия удалена.")
        end
    elseif state == "maintenance" and KladManager.Runtime.manifest_maintenance then
        return
    elseif state == "maintenance" or state == "banned" then
        if KladManager.Button(
            "auth_retry",
            "Проверить снова",
            "ICON_FA_SYNC_ALT",
            imgui.ImVec2(-1, 0),
            "secondary",
            KladManager.Auth.busy,
            false
        ) then
            KladManager.RefreshSession()
        end
    end
end

function KladManager.RenderAuthWindow()
    local imgui = KladManager.ImGui
    local width = KladManager.Scaled(460)
    local height = KladManager.Scaled(390)
    imgui.SetNextWindowSize(imgui.ImVec2(width, height), imgui.Cond.Always)
    imgui.SetNextWindowPos(
        imgui.ImVec2(imgui.GetIO().DisplaySize.x / 2, imgui.GetIO().DisplaySize.y / 2),
        imgui.Cond.FirstUseEver,
        imgui.ImVec2(0.5, 0.5)
    )
    local flags = imgui.WindowFlags.NoResize + imgui.WindowFlags.NoCollapse
        + imgui.WindowFlags.NoTitleBar
    if imgui.Begin("##KladManagerAuth", nil, flags) then
        imgui.TextColored(KladManager.Vec4("accent_hover"), "KLAD MANAGER")
        imgui.TextColored(
            KladManager.Vec4("text3"),
            KladManager.U8("Безопасный вход через аккаунт и Telegram")
        )
        imgui.Dummy(imgui.ImVec2(0, KladManager.Scaled(12)))
        imgui.TextColored(
            KladManager.Vec4(KladManager.AuthStateColor(KladManager.Auth.state)),
            KladManager.U8(KladManager.Auth.state)
        )
        imgui.TextWrapped(KladManager.U8(KladManager.Auth.message))
        imgui.Separator()
        KladManager.RenderAuthActions()
        if KladManager.ApiBaseUrl == "" then
            imgui.TextColored(
                KladManager.Vec4("warning"),
                KladManager.U8("Продуктовые функции заблокированы: HTTPS API не настроен.")
            )
        end
        if KladManager.Auth.busy then
            KladManager.LoadingState("Запрос выполняется без блокировки игры")
        end
    end
    imgui.End()
end

function KladManager.RenderMainWindow()
    local imgui = KladManager.ImGui
    local scale = KladManager.Scale()
    imgui.SetNextWindowSize(imgui.ImVec2(860 * scale, 552 * scale), imgui.Cond.Always)
    imgui.SetNextWindowPos(
        imgui.ImVec2(imgui.GetIO().DisplaySize.x / 2, imgui.GetIO().DisplaySize.y / 2),
        imgui.Cond.FirstUseEver,
        imgui.ImVec2(0.5, 0.5)
    )
    imgui.PushStyleVarVec2(imgui.StyleVar.WindowPadding, imgui.ImVec2(0, 0))
    local flags = imgui.WindowFlags.NoResize + imgui.WindowFlags.NoCollapse
        + imgui.WindowFlags.NoTitleBar
    if imgui.Begin("##KladManagerMain", nil, flags) then
        KladManager.RenderSidebar()
        imgui.SameLine(0, 0)
        imgui.PushStyleVarVec2(
            imgui.StyleVar.WindowPadding,
            imgui.ImVec2(KladManager.Scaled(16), KladManager.Scaled(13))
        )
        imgui.BeginChild("##KladManagerRight", imgui.ImVec2(0, -1), false)
        KladManager.RenderMainContent()
        imgui.EndChild()
        imgui.PopStyleVar()
    end
    imgui.End()
    imgui.PopStyleVar()
end

function KladManager.SetupUI()
    local imgui = KladManager.ImGui
    imgui.OnInitialize(function()
        KladManager.SetupFonts()
        KladManager.ApplyStyle()
    end)
    KladManager.MainFrame = imgui.OnFrame(
        function()
            return KM_READY and (
                KladManager.Runtime.auth_open
                or (
                    KladManager.Runtime.menu_open
                    and KladManager.Auth.state == "approved"
                )
            )
        end,
        function()
            KladManager.ApplyStyle()
            local pushed = KladManager.PushFont("text")
            if KladManager.Runtime.auth_open and KladManager.Auth.state ~= "approved" then
                KladManager.RenderAuthWindow()
            elseif KladManager.Runtime.menu_open then
                KladManager.RenderMainWindow()
            end
            KladManager.PopFont(pushed)
        end
    )
    KladManager.MinimapFrame = imgui.OnFrame(
        function()
            return KM_READY
                and KladManager.Runtime.minimap_open
                and KladManager.Auth.state == "approved"
        end,
        function()
            local pushed = KladManager.PushFont("text")
            KladManager.RenderMinimapWindow()
            KladManager.PopFont(pushed)
        end
    )
    KladManager.NotificationFrame = imgui.OnFrame(
        function()
            return KM_READY and #KladManager.Notifications.items > 0
        end,
        function()
            local pushed = KladManager.PushFont("text")
            KladManager.RenderNotifications()
            KladManager.PopFont(pushed)
        end
    )
end

function KladManager.ToggleMenu()
    if not KM_READY then
        if KladManager.Runtime.startup_error ~= "" then
            KM_LOG("Меню недоступно: " .. KladManager.Runtime.startup_error)
        else
            KM_LOG("Меню загружается: " .. KladManager.Runtime.startup_phase)
        end
        return
    end
    if KladManager.Auth.state == "approved" then
        KladManager.Runtime.menu_open = not KladManager.Runtime.menu_open
        KladManager.Runtime.auth_open = false
    else
        KladManager.Runtime.auth_open = true
    end
end

function KladManager.RegisterCommand()
    if KM_COMMAND_REGISTERED then
        return true
    end
    local ok = pcall(function()
        sampRegisterChatCommand("klm", KladManager.ToggleMenu)
    end)
    KM_COMMAND_REGISTERED = ok
    return ok
end

function KladManager.SetStartupPhase(phase)
    KladManager.Runtime.startup_phase = phase
    KladManager.Runtime.startup_error = ""
end

function KladManager.StopStartup(message)
    KladManager.Runtime.startup_phase = "error"
    KladManager.Runtime.startup_error = tostring(message)
    KladManager.Diagnostics.last_error = tostring(message)
    KM_LOG(tostring(message) .. ". Исправьте причину и перезагрузите скрипт")
    while true do
        wait(0)
    end
end

function KladManager.TickPerformance()
    local now = KladManager.NowMs()
    if KladManager.Runtime.last_tick > 0 then
        KladManager.Runtime.frame_ms = math.max(0, now - KladManager.Runtime.last_tick)
    end
    KladManager.Runtime.last_tick = now
    KladManager.Runtime.frame_count = (KladManager.Runtime.frame_count or 0) + 1
    if now - KladManager.Runtime.last_second >= 1000 then
        KladManager.Runtime.fps = KladManager.Runtime.frame_count
        KladManager.Runtime.frame_count = 0
        KladManager.Runtime.last_second = now
        local history = KladManager.Runtime.fps_history
        history[#history + 1] = KladManager.Runtime.fps
        while #history > 120 do
            table.remove(history, 1)
        end
        if sampGetCurrentServerAddress then
            local address, port = sampGetCurrentServerAddress()
            KladManager.Runtime.server = address
                and tostring(address) .. ":" .. tostring(port or "")
                or "не подключён"
        end
    end
end

function KladManager.ShutdownNetwork()
    KladManager.Network.shutting_down = true
    KladManager.Network.queue = {}
    for _, task in ipairs(KladManager.Network.active) do
        if task.runner then
            local ok, error_value = pcall(function()
                task.runner:cancel()
            end)
            if not ok then
                KladManager.Diagnostics.last_error = tostring(error_value)
            end
        end
    end
    KladManager.Network.active = {}
    KladManager.Network.results = {}
end

function main()
    math.randomseed(os.time() + getGameTimer())
    while not isSampAvailable() do
        wait(100)
    end
    if not KladManager.RegisterCommand() then
        KM_LOG("Не удалось зарегистрировать команду /klm")
        return
    end
    KladManager.SetStartupPhase("подготовка каталогов")
    if not KM_ENSURE_DIR(KM_CONFIG) or not KM_ENSURE_DIR(KM_DATA)
        or not KM_ENSURE_DIR(KM_IMAGES) or not KM_ENSURE_DIR(KM_ITEMS) then
        return KladManager.StopStartup("Не удалось подготовить каталоги KladManager")
    end
    KM_CLEAN_TEMPS()
    if not KM_HANDLE_PENDING() then
        return KladManager.StopStartup("Не удалось завершить предыдущее обновление")
    end
    KladManager.SetStartupPhase("проверка обновления")
    KM_LOG("Проверка обновления")
    local manifest, manifest_error = KM_LOAD_MANIFEST()
    local offline_boot = manifest == nil
    if manifest then
        if not KM_UPDATE_SCRIPT(manifest) then
            return KladManager.StopStartup("Не удалось безопасно обновить Lua-скрипт")
        end
        if manifest.version ~= KM_VERSION then
            return KladManager.StopStartup("Версия манифеста не совпадает с версией скрипта")
        end
        KladManager.SetStartupPhase("проверка библиотек")
        if not KM_BOOTSTRAP_LIBS(manifest) then
            return KladManager.StopStartup("Не удалось скачать или проверить библиотеки")
        end
        KladManager.SetStartupPhase("проверка ресурсов")
        if not KM_BOOTSTRAP_ASSETS(manifest) then
            return KladManager.StopStartup("Не удалось скачать или проверить ресурсы")
        end
    elseif not KM_LIB_FILES_OK() or not KM_ASSET_FILES_OK() then
        return KladManager.StopStartup(
            "Манифест недоступен, а локальные библиотеки или ресурсы повреждены"
        )
    end
    KladManager.SetStartupPhase("запуск библиотек")
    if not KM_LOAD_OPTIONAL_CORE() then
        return KladManager.StopStartup("Не удалось запустить библиотеки: " .. KladManager.CoreLoadError)
    end
    KladManager.SetStartupPhase("настройка интерфейса")
    KladManager.LoadSettings()
    if KladManager.ApiBaseUrl ~= "" then
        KladManager.CabinetUrl = KladManager.ApiBaseUrl .. "/account/security"
        KladManager.HwidRequestUrl = KladManager.CabinetUrl
    end
    KladManager.CreateBuffers()
    KladManager.InitWindowsSignals()
    KladManager.InstallId = KladManager.LoadInstallId()
    local network_ok = KladManager.InitNetwork()
    KladManager.SetupUI()
    if not KladManager.InitializeGameplay() then
        return KladManager.StopStartup("Не удалось инициализировать игровой модуль")
    end
    KM_READY = true
    KM_COMMIT_PENDING()
    KladManager.Runtime.initialized = true
    KladManager.Runtime.startup_phase = "готово"
    KladManager.Runtime.startup_error = ""
    if offline_boot then
        KladManager.Diagnostics.last_error = "Updater: " .. tostring(manifest_error or "offline")
        KladManager.Notify(
            "warning",
            "Автообновление",
            "Сеть недоступна, запущены проверенные локальные файлы.",
            6.0
        )
    end
    if manifest and tostring(manifest.maintenance_message or "") ~= "" then
        KladManager.Runtime.manifest_maintenance = true
        KladManager.SetAuthState(
            "maintenance",
            KladManager.u8:decode(manifest.maintenance_message)
        )
    elseif not network_ok then
        KladManager.SetAuthState(
            "network_error",
            "Не удалось запустить неблокирующий HTTP manager."
        )
    elseif KladManager.ApiBaseUrl == "" then
        KladManager.SetAuthState(
            "network_error",
            "Адрес API не настроен. Продуктовые функции заблокированы."
        )
    else
        local saved_session = KladManager.LoadSession()
        if saved_session then
            KladManager.Auth.session = saved_session
            KladManager.RefreshSession()
        else
            KladManager.SetAuthState("login", "Введите логин и пароль.")
        end
    end
    KM_LOG("Клиент готов. Команда /klm")
    while true do
        wait(0)
        KladManager.TickNetwork()
        KladManager.DispatchNetworkResults()
        KladManager.TickAuth()
        KladManager.TickSettings()
        KladManager.TickBindCapture()
        KladManager.TickBinds()
        KladManager.TickGameplay()
        KladManager.TickPerformance()
    end
end

function onScriptTerminate(script_object, quit_game)
    if script_object ~= thisScript() then
        return
    end
    if KladManager.SettingsDirtyAt then
        KladManager.SaveSettings()
    end
    if KladManager.Network then
        KladManager.ShutdownNetwork()
    end
    if KladManager.TextureCache then
        KladManager.ReleaseTextures()
    end
end
