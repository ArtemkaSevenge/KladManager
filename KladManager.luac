script_name("KladManager")
script_author("KladManager Project")
script_version("0.9.0")
KM_MOONLOADER = require("moonloader")
KM_BIT = require("bit")
KladManager = {}
KladManager.DownloadStatus = KM_MOONLOADER.download_status
KladManager.ApiBaseUrl = ""
KM_VERSION = "0.9.0"
KM_PROTOCOL_VERSION = 2
KM_MANIFEST_URL = "https://raw.githubusercontent.com/ArtemkaSevenge/KladManager/main/KladManager_Updater.json"
KM_ROOT = getWorkingDirectory()
KM_CONFIG = KM_ROOT .. "\\config\\KladManager"
KM_DATA = KM_ROOT .. "\\KladManager"
KM_IMAGES = KM_DATA .. "\\Images"
KM_ITEMS = KM_DATA .. "\\Images_Items"
KM_PENDING = KM_CONFIG .. "\\update.pending"
KM_LIBS_MARKER = KM_CONFIG .. "\\libs.version"
KM_ASSETS_MARKER = KM_CONFIG .. "\\assets.version"
KM_TEMP_LEDGER = KM_CONFIG .. "\\temps.list"
KM_DOWNLOAD_TIMEOUT = 30000
KM_MAX_DOWNLOAD = 67108864
KM_READY = false
KM_COMMAND_REGISTERED = false
KM_DOWNLOAD_SEQUENCE = 0
